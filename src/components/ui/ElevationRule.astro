---
import type { ElevationSample } from '@lib/gpx';

/**
 * A section divider drawn from a real elevation profile.
 *
 * Ornament made of Anton's own data: the line between two sections of a hiking
 * page is the shape of that hike. Nobody else can copy it, because it is the
 * walk itself.
 *
 * Renders nothing without a profile — no GPX means no rule, not a broken one.
 */
interface Props {
  profile: ElevationSample[];
  class?: string;
}

const { profile, class: className = '' } = Astro.props;

const usable = profile && profile.length > 1;

let path = '';
let area = '';

if (usable) {
  const W = 1000;
  const H = 40;

  const maxKm = profile[profile.length - 1].km || 1;
  const elevations = profile.map((p) => p.ele);
  const min = Math.min(...elevations);
  const max = Math.max(...elevations);
  const span = max - min || 1;

  const pts = profile.map((p) => {
    const x = (p.km / maxKm) * W;
    // Invert: higher ground sits higher on screen.
    const y = H - ((p.ele - min) / span) * (H - 4) - 2;
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  });

  path = `M${pts.join(' L')}`;
  area = `${path} L${W},${H} L0,${H} Z`;
}
---

{usable && (
  <div class:list={['elevation-rule', className]} aria-hidden="true">
    <svg viewBox="0 0 1000 40" preserveAspectRatio="none" fill="none">
      <defs>
        <linearGradient id="elev-rule-fill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--accent-2)" stop-opacity="0.22" />
          <stop offset="100%" stop-color="var(--accent-2)" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path d={area} fill="url(#elev-rule-fill)" />
      <path
        d={path}
        stroke="var(--accent-2)"
        stroke-width="1.5"
        stroke-linejoin="round"
        vector-effect="non-scaling-stroke"
        opacity="0.55"
      />
    </svg>
  </div>
)}

<style>
  .elevation-rule {
    width: 100%;
    height: 40px;
    margin: 2.5rem 0;
    pointer-events: none;
    /* Fade both ends so it reads as a rule across the page, not a chart. */
    mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
  }

  .elevation-rule svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

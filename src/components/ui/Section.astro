---
/**
 * A page section, and the unit of vertical rhythm.
 *
 * This used to set `mb-14` in the class list AND `margin-bottom: 3.5rem` in a
 * scoped <style>. Astro scoped styles compile to `section[data-astro-cid-…]`,
 * which outranks a plain `.mb-24` utility — so every `mb-20` and `mb-24` passed
 * in by a caller lost silently and every section on the site was 56px apart
 * whatever the markup asked for. That is a good part of why the page reads as
 * one undifferentiated scroll.
 *
 * Rhythm is now a prop with real steps, and a caller's own margin class still
 * wins because nothing here has inflated specificity.
 */
interface Props {
  /** Vertical space after the section. `none` hands spacing back to the caller. */
  rhythm?: 'none' | 'tight' | 'default' | 'loose';
  /**
   * Settle into view on scroll. On by default — 58 of 79 templates had no
   * motion at all, and opting in one file at a time is what left it that way.
   * Turn it off for a section that must be painted immediately: anything
   * inside a modal, a dialog, or a container that is display:none at load,
   * where the observer may never fire.
   */
  reveal?: boolean;
  class?: string;
  id?: string;
  [key: string]: any;
}

const { rhythm = 'default', reveal = true, class: className, id, ...rest } = Astro.props;

const rhythms = {
  none: '',
  tight: 'mb-lg',
  default: 'mb-2xl',
  loose: 'mb-3xl',
};
---

<section
  id={id}
  class:list={[rhythms[rhythm], reveal && 'animate-on-scroll', className]}
  {...rest}
>
  <slot />
</section>

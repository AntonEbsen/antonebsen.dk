---
import Layout from '../layouts/BaseLayout.astro';
import { getLangFromUrl } from '../i18n/utils';
import { MODEL_LABEL } from '../lib/ai/model';
import ContourPlate from '@components/ui/ContourPlate.astro';

const lang = getLangFromUrl(Astro.url);

const t = {
  da: {
    title: "Anton's AI Assistent",
    desc: "Stil mig spørgsmål om Antons CV, projekter, blogindlæg og erfaring.",
    intro: "Hej! Jeg er den store udgave af Antons AI. Jeg kan analysere hele portfolioen og endda <strong>lave grafer</strong> over dataene. Prøv det!",
    placeholder: "Stil mig et spørgsmål...",
    disclaimer: `Drevet af ${MODEL_LABEL} · Kan lave fejl`,
    back: "Tilbage til forsiden",
    prompts: ["📊 Vis mig en graf over Antons skills", "💼 Opsummer Antons erfaring", "📋 Analysér Jobopslag"]
  },
  en: {
    title: "Anton's AI Assistant",
    desc: "Ask me questions about Anton's CV, projects, blog posts, and experience.",
    intro: "Hi! I'm the full-screen AI. I can analyze the portfolio and even <strong>generate charts</strong> from the data. Give it a try!",
    placeholder: "Try: 'Visualize your experience timeline'...",
    disclaimer: `Powered by ${MODEL_LABEL} · May produce inaccuracies`,
    back: "Back to Home",
    prompts: ["📊 Graph Anton's skills", "💼 Summarize Anton's experience", "📋 Analyze Job Match"]
  }
}[lang] || { // fallback to en if lang not found
    title: "Anton's AI Assistant",
    desc: "Ask me questions about Anton's CV, projects, blog posts, and experience.",
    intro: "Hi! I'm the full-screen AI. I can analyze the portfolio and even <strong>generate charts</strong> from the data. Give it a try!",
    placeholder: "Try: 'Visualize your experience timeline'...",
    disclaimer: `Powered by ${MODEL_LABEL} · May produce inaccuracies`,
    back: "Back to Home",
    prompts: ["📊 Graph Anton's skills", "💼 Summarize Anton's experience", "📋 Analyze Job Match"]
};
---

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script is:inline>
    // Initialize PDF.js worker
    if (window.pdfjsLib) {
        window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    }
</script>

<Layout 
  title={t.title} 
>
  <style>
    /*
     * The scrolling perspective grid and the radial glow that used to sit here are
     * gone. They were the only sci-fi register on a site whose language is archival —
     * terrain rules, contour fields, a ledger, a folio — and they appeared on exactly
     * two pages, both of them the AI's. A visitor arriving from anywhere else met a
     * different product. The texture now comes from ContourPlate, the same generated
     * terrain the rest of the site uses, seeded so this page grows its own hill.
     *
     * (The glow was also broken: `rgba(var(--accent), 0.15)` fed a hex token to a
     * function expecting channels, so it resolved to nothing and had been painting
     * transparent for as long as the token has existed.)
     */
    .chat-container {
      max-width: 950px;
      margin: 1.5rem auto;
      padding: 0 1rem;
      height: 90vh; /* Taller on desktop */
      display: flex;
      flex-direction: column;
      position: relative;
    }

    .chat-card {
      background: var(--glass);
      border: 1px solid var(--rule-strong);
      border-radius: 24px;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow: 
        0 20px 50px rgba(0,0,0,0.5),
        0 0 0 1px var(--rule) inset;
    }

    /* Mobile Optimization: Full Screen App Feel */
    @media (max-width: 768px) {
        .chat-container {
            height: 100dvh; /* Use dynamic viewport height */
            max-width: 100%;
            margin: 0;
            padding: 0;
            width: 100%;
        }

        .chat-card {
            border-radius: 0;
            border: none;
            border-bottom: 1px solid var(--rule); /* subtle divider */
        }
        
        /* Keyed off the header wrapper, not a Tailwind class that moves. */
        .chat-container > div:first-child {
            padding: 0.75rem 1rem;
            margin-bottom: 0 !important;
            background: var(--nav);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--rule);
        }
    }

    /*
     * The rubric line above the conversation. It was Courier at 1px tracking, which is
     * the terminal costume the rest of this change is undoing; the site already has a
     * register for a small label above a block, and it is not monospace.
     */
    .status-bar {
        background: var(--bg-sunken);
        border-bottom: 1px solid var(--rule);
        padding: var(--space-2xs) var(--space-md);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-2xs) var(--space-sm);
        flex-wrap: wrap;
        font-size: var(--step--1);
        color: var(--text-dim);
        text-transform: uppercase;
        letter-spacing: 0.12em;
    }

    .status-dot {
        width: 7px;
        height: 7px;
        background-color: var(--accent-2);
        border-radius: 50%;
        display: inline-block;
    }

  </style>

  <main class="chat-container">
    <div class="mb-md flex flex-wrap justify-between items-end gap-sm px-2">
      <div>
        <p class="eyebrow m-0 mb-2xs">{lang === 'da' ? 'Assistent' : 'Assistant'}</p>
        <h1 class="m-0 font-serif text-title-md">{t.title}</h1>
      </div>
      <div class="flex items-center gap-2xs">
        <a href="/ai-project" class="text-xs text-dim hover:text-text flex items-center gap-2 border border-rule hover:border-rule-strong px-3 py-2 rounded-control transition-colors">
          <i class="fa-solid fa-circle-info" aria-hidden="true"></i> {lang === 'da' ? 'Om denne AI' : 'About this AI'}
        </a>
        <a href="/" class="text-xs text-dim hover:text-text flex items-center gap-2 border border-rule hover:border-rule-strong px-3 py-2 rounded-control transition-colors">
          <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> {t.back}
        </a>
      </div>
    </div>

    <!-- Main Chat Window -->
    <div class="chat-card" id="fp-chat-card" data-lang={lang}>
      <ContourPlate seed={t.title} tone="accent" class="h-16 shrink-0 hidden md:block" />

      <!-- Status Header -->
      <div class="status-bar">
        <div class="flex items-center gap-3">
            <span class="flex items-center gap-2">
                <span class="status-dot"></span>
                <span class="hidden md:inline">ONLINE</span>
            </span>
            <span class="hidden md:inline" aria-hidden="true">|</span>
            <span class="text-[10px] md:text-xs">MODEL: {MODEL_LABEL.toUpperCase()}</span>
            <span class="mx-2" aria-hidden="true">|</span>
            <!--
              The four styles, as a segmented control rather than a dropdown: with only
              four options, hiding three of them behind a click cost more than it saved,
              and a <select> cannot be styled to match anything around it.

              Built on real radio inputs, not divs with ARIA. A radiogroup gets arrow-key
              navigation, roving focus, the accessible name from the <legend> and form
              semantics from the browser — all of which would otherwise be hand-written
              JavaScript, and all of which are easy to write subtly wrong.
            -->
            <fieldset id="fp-persona-group" class="persona-group">
                <legend class="sr-only">{lang === "da" ? "Vælg assistentens stil" : "Choose the assistant style"}</legend>
                {[
                    { value: 'default', da: 'Standard', en: 'Standard' },
                    { value: 'recruiter', da: 'Rekruttering', en: 'Recruiter' },
                    { value: 'tech', da: 'Teknisk', en: 'Tech lead' },
                    { value: 'eli5', da: 'Enkelt', en: 'ELI5' },
                ].map((p) => (
                    <label class="persona-option">
                        <input type="radio" name="fp-persona" value={p.value} checked={p.value === 'default'} />
                        <span>{lang === 'da' ? p.da : p.en}</span>
                    </label>
                ))}
            </fieldset>
        </div>
        <div class="flex items-center gap-3">
            <!-- `LATENCY: 24ms` and `SECURE CONN` stood here. Neither was measured:
                 the latency was a hardcoded string that would have read 24ms while the
                 assistant was down. Chrome that invents its own telemetry is worse than
                 no chrome, and on a page whose whole argument is that the answers are
                 grounded, it is the wrong thing to be caught doing. -->
            <button id="fp-clear-chat" class="text-dim hover:text-accent transition-colors" title={lang === "da" ? "Ryd samtalen" : "Clear conversation"} aria-label={lang === "da" ? "Ryd samtalen" : "Clear conversation"}>
              <i class="fa-solid fa-trash" aria-hidden="true"></i>
            </button>
        </div>
      </div>

      <!-- Messages Area -->
      <div id="fp-chat-messages" tabindex="0" aria-label={lang === "da" ? "Samtale" : "Conversation"} class="flex-1 p-6 overflow-y-auto space-y-6 scrollbar-hide text-text">
        <!-- Intro Message -->
        <div class="flex gap-4">
          <div class="w-10 h-10 rounded-full bg-accent/20 text-accent flex items-center justify-center flex-shrink-0 mt-1 border border-accent/20">
            <i class="fa-solid fa-robot text-lg"></i>
          </div>
          <div class="bg-white/5 border border-white/10 p-5 rounded-sm border-l-2 border-l-accent max-w-[85%] leading-relaxed">
            <p class="font-mono text-xs text-accent mb-2 uppercase tracking-wide">System Message</p>
            <p set:html={t.intro} />
          </div>
        </div>
      </div>

      <!-- Input Area -->
      <div class="p-4 border-t border-[var(--rule)] bg-[var(--glass)] backdrop-blur-md relative">
        <!-- Audio Visualizer -->
        <canvas id="audio-visualizer" class="absolute -top-24 left-1/2 -translate-x-1/2 w-64 h-20 pointer-events-none opacity-0 transition-opacity duration-300 z-10"></canvas>
        <!-- Quick Prompts -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-4">
            {t.prompts.map(p => (
              <button class="text-left text-xs bg-white/5 border border-white/10 hover:bg-white/10 hover:border-accent/50 transition-colors rounded-lg p-3 text-dim hover:text-text quick-prompt-btn flex items-center gap-2 shadow-md">
                <span class="truncate">{p}</span>
              </button>
            ))}
        </div>

        <form id="fp-chat-form" class="flex gap-3 relative">
          <input 
            type="text" 
            id="fp-chat-input"
            placeholder={t.placeholder}
            class="chat-input flex-1 px-5 pr-44 py-4 text-base"
            autocomplete="off"
            autofocus
          />

          <input type="file" id="fp-chat-file" hidden accept=".pdf,.txt,.md,.csv,.jpg,.jpeg,.png,.webp" />
          <!-- Button Spacing: Send(2) <-[8px]-> Voice(16) <-[8px]-> File(30) -->
          <button type="button" id="fp-file-btn" aria-label={lang === "da" ? "Vedhæft dokument" : "Attach a document"} class="absolute right-[7.5rem] top-2 bottom-2 chat-input-btn w-12 group" title="Upload Document (PDF/Text)">
            <i class="fa-solid fa-paperclip text-lg group-hover:scale-110 transition-transform"></i>
          </button>
          <button type="button" id="fp-voice-btn" aria-label={lang === "da" ? "Tal til assistenten" : "Speak to the assistant"} class="absolute right-16 top-2 bottom-2 chat-input-btn w-12 group" title="Speak to Anton">
            <i class="fa-solid fa-microphone text-lg group-hover:scale-110 transition-transform"></i>
             <span class="absolute inset-0 rounded-lg border border-red-500 opacity-0 transition-opacity" id="fp-voice-indicator"></span>
          </button>
          <button type="submit" id="fp-send-btn" data-label-send={lang === "da" ? "Send besked" : "Send message"} data-label-stop={lang === "da" ? "Stop svaret" : "Stop generating"} aria-label={lang === "da" ? "Send besked" : "Send message"} class="absolute right-2 top-2 bottom-2 bg-accent text-bg w-12 rounded-lg flex items-center justify-center hover:bg-white hover:text-black transition-all transform hover:scale-105 shadow-lg">
            <i class="fa-solid fa-paper-plane text-lg"></i>
          </button>
        </form>
        <div class="text-center mt-3 text-xs text-dim">
          {t.disclaimer}
        </div>
      </div>
        <div id="fp-file-display" class="hidden mt-2 px-3 py-2 bg-accent/10 border border-accent/20 rounded-lg flex items-center justify-between text-xs text-accent">
            <span class="truncate flex-1 font-mono"><i class="fa-solid fa-file-pdf mr-2"></i><span id="fp-filename"></span></span>
            <button type="button" id="fp-remove-file" class="ml-2 hover:text-text" aria-label={lang === "da" ? "Fjern vedhæftning" : "Remove attachment"}><i class="fa-solid fa-times"></i></button>
        </div>
      </div>


    </div>
  </main>

  <script>
    import { renderModelText } from '../lib/ai/safe-html';
    import { readEventStream } from '../lib/ai/protocol';
    import { createChatRenderers } from '../lib/ai/chat-ui';
    import { createMessageActions } from '../lib/ai/message-actions';
    import { CHAT_THEME, CHAT_ACTION_THEME } from '../lib/ai/chat-theme';
    import { toApiMessages } from '../lib/ai/history';
    import { createVoiceInput } from '../lib/ai/voice-input';

    // Typed at the query rather than cast at each use: getElementById returns
    // HTMLElement, so every `input.value` and `form.reset()` below was an error the
    // checker reported and nobody could see among the other 600.
    // Asserted non-null: all four are rendered unconditionally by the markup in this
    // same file, and the handlers below already dereference them without guarding.
    // Narrowing would not survive into the nested functions anyway, and a page script
    // that cannot find its own form should fail loudly rather than half-work.
    const form = document.querySelector<HTMLFormElement>('#fp-chat-form')!;
    const input = document.querySelector<HTMLTextAreaElement>('#fp-chat-input')!;
    const messages = document.querySelector<HTMLElement>('#fp-chat-messages')!;
    const card = document.querySelector<HTMLElement>('#fp-chat-card')!;
    const lang = card?.getAttribute('data-lang') || 'da';

    // The server renders the placeholder from the frontmatter `t`, which this script
    // cannot see — two handlers below assigned `t.placeholder` and threw
    // "ReferenceError: t is not defined" when a recording was too short or the
    // microphone was denied. Reading the rendered value keeps it correct in every
    // language without shipping the table twice.
    const defaultPlaceholder = input?.placeholder ?? '';
    const voiceBtn = document.querySelector<HTMLButtonElement>('#fp-voice-btn');
    const voiceIndicator = document.querySelector<HTMLElement>('#fp-voice-indicator');

    /**
     * The in-flight request, so a long answer can be stopped.
     *
     * The send control doubles as the stop control rather than appearing beside it:
     * the mouse is already there, and a second button that only exists for two
     * seconds is harder to hit than the one that has not moved.
     */
    const sendBtn = document.querySelector<HTMLButtonElement>('#fp-send-btn');
    let activeRequest: AbortController | null = null;

    function setStreaming(streaming: boolean) {
        if (!sendBtn) return;
        const icon = sendBtn.querySelector('i');
        if (icon) icon.className = streaming
            ? 'fa-solid fa-stop text-lg'
            : 'fa-solid fa-paper-plane text-lg';
        // The same control sends and stops, so the accessible name has to follow it.
        sendBtn.setAttribute('aria-label', streaming
            ? (sendBtn.dataset.labelStop || 'Stop generating')
            : (sendBtn.dataset.labelSend || 'Send message'));
        // Regenerate greys out for the duration rather than quietly ignoring clicks.
        messageActions.refreshRegenerate();
    }

    // Clicking while a reply is streaming stops it rather than submitting a second,
    // empty message — hence the preventDefault on what is still a submit button.
    sendBtn?.addEventListener('click', (e) => {
        if (!activeRequest) return;
        e.preventDefault();
        activeRequest.abort();
    });
    
    // Handle URL Params (for Static Site)
    if (typeof window !== 'undefined') {
        const urlParams = new URLSearchParams(window.location.search);
        const q = urlParams.get('q');
        if (q && input) {
            input.value = q;
        }
    }
    
    // File Upload Logic
    const fileInput = document.querySelector<HTMLInputElement>('#fp-chat-file');
    const fileBtn = document.querySelector<HTMLButtonElement>('#fp-file-btn');
    const fileDisplay = document.querySelector<HTMLElement>('#fp-file-display');
    const fileNameSpan = document.querySelector<HTMLElement>('#fp-filename');
    const removeFileBtn = document.querySelector<HTMLButtonElement>('#fp-remove-file');
    let currentFileContent: string | null = null;

    fileBtn?.addEventListener('click', () => fileInput?.click());

    fileInput?.addEventListener('change', async (e) => {
        const target = e.target as HTMLInputElement;
        const file = target.files?.[0];
        if (!file) return;

        // Show loading state or name
        if(fileDisplay && fileNameSpan) {
            fileDisplay.classList.remove('hidden');
            fileNameSpan.textContent = "Processing " + file.name + "...";
        }

        try {
            let text = "";
            if (file.type === 'application/pdf') {
                const arrayBuffer = await file.arrayBuffer();
                const pdf = await (window as any).pdfjsLib.getDocument({ data: arrayBuffer }).promise;
                for (let i = 1; i <= pdf.numPages; i++) {
                    const page = await pdf.getPage(i);
                    const content = await page.getTextContent();
                    text += content.items.map((item: any) => item.str).join(' ') + "\n";
                }
                currentFileContent = `\n\n<<<FILE_CONTENT Start: ${file.name}>>>\n${text}\n<<<FILE_CONTENT End>>>\n`;
            
            } else if (file.type.startsWith('image/')) {
                // Image Handling
                 const reader = new FileReader();
                 reader.onload = () => {
                     const base64 = reader.result.split(',')[1];
                     currentFileContent = {
                         type: 'image',
                         data: base64,
                         mimeType: file.type,
                         name: file.name
                     };
                 };
                 reader.readAsDataURL(file);
                 if(fileNameSpan) fileNameSpan.textContent = file.name + " (Image Ready)";
                 return; // Async read, we return early

            } else {
                // Text based
                text = await file.text();
                currentFileContent = `\n\n<<<FILE_CONTENT Start: ${file.name}>>>\n${text}\n<<<FILE_CONTENT End>>>\n`;
            }

            if(fileNameSpan) fileNameSpan.textContent = file.name + " (Ready)";
            
        } catch (err) {
            console.error("File read error:", err);
            if(fileNameSpan) fileNameSpan.textContent = "Error reading file";
            currentFileContent = null;
        }
    });

    removeFileBtn?.addEventListener('click', () => {
        currentFileContent = null;
        fileInput.value = '';
        fileDisplay?.classList.add('hidden');
    });
    
    // Persona Logic
    //
    // A radio group rather than a select, so restoring the saved choice means checking
    // the matching input instead of assigning a value. `change` fires on the input that
    // becomes checked, including when the browser moves the selection with an arrow
    // key — which is why the group needed no keyboard handling of its own.
    const fpPersonaGroup = document.querySelector<HTMLFieldSetElement>('#fp-persona-group');
    if (fpPersonaGroup) {
        const options = fpPersonaGroup.querySelectorAll<HTMLInputElement>('input[name="fp-persona"]');
        const saved = localStorage.getItem('anton_ai_persona');
        if (saved) {
            // Guarded: a persona removed from the markup would otherwise leave the group
            // with nothing checked and no way back to a valid one.
            const match = [...options].find((o) => o.value === saved);
            if (match) match.checked = true;
        }

        fpPersonaGroup.addEventListener('change', (e) => {
            const target = e.target as HTMLInputElement | null;
            if (target?.name === 'fp-persona') {
                localStorage.setItem('anton_ai_persona', target.value);
            }
        });
    }

    // Voice input, via the browser rather than a paid transcription service. See
    // src/lib/ai/voice-input.ts — the MediaRecorder and /api/stt round trip that stood
    // here needed a key that exists in no environment.
    let wasVoiceInput = false;
    createVoiceInput({
        inputId: 'fp-chat-input',
        formId: 'fp-chat-form',
        buttonId: 'fp-voice-btn',
        lang,
        onResult: () => { wasVoiceInput = true; },
    });

    // Quick Prompts Logic
    document.querySelectorAll('.quick-prompt-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
          const text = e.currentTarget.textContent.trim();
          if(text) {
              input.value = text;
              form?.dispatchEvent(new Event('submit'));
              // Remove prompts after first click
             e.currentTarget.parentElement?.remove();
          }
      });
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      let query = input.value.trim();
      if (!query && !currentFileContent) return;

      const persona = localStorage.getItem('anton_ai_persona') || 'default';

      // User Message (Text)
      addMessage(query || (currentFileContent ? `[Attached: ${fileInput.files?.[0]?.name}]` : "Empty message"), 'user', false, persona);
      
      // Build Payload
      let payload = { message: query, lang: lang };
      let fullPayload = query; // Initialize fullPayload

      if (currentFileContent) {
          if (typeof currentFileContent === 'string') {
              // Text/PDF context
              payload.message += currentFileContent;
              fullPayload += currentFileContent; // Update fullPayload
          } else if (currentFileContent.type === 'image') {
              // Vision Upload
              payload.image = {
                  data: currentFileContent.data,
                  mimeType: currentFileContent.mimeType
              };
              payload.message += `\n[User uploaded an image: ${currentFileContent.name}]`;
              fullPayload += `\n[User uploaded an image: ${currentFileContent.name}]`; 
          }
           // Clear file after sending
           removeFileBtn?.click();
      }

      // Loading
      showTyping();

      const currentLang = document.getElementById('fp-chat-card')?.dataset.lang || 'da';
      let accumulatedText = "";

        // The transcript already holds this question; it holds the typed text only,
        // so the final turn is swapped for the payload that carries any attachment.
        const convo = toApiMessages(readStoredHistory());
        if (convo.length && convo[convo.length - 1].role === 'user') {
            convo[convo.length - 1].content = fullPayload;
        } else {
            convo.push({ role: 'user', content: fullPayload });
        }

        try {
          activeRequest = new AbortController();
          setStreaming(true);

          const res = await fetch('/api/chat', {
            method: 'POST',
            signal: activeRequest.signal,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ messages: convo, lang: currentLang, persona, image: payload.image })
          });
        
        removeTyping();

        if (!res.ok) {
           // Handle error text/json
           const rawText = await res.text();
           let errorMsg = "Server Error";
           try {
               const json = JSON.parse(rawText);
               errorMsg = json.message || json.error || errorMsg;
           } catch(e) {
               errorMsg += `: ${rawText.substring(0, 50)}...`;
           }
           addMessage("⚠️ " + errorMsg, 'ai', false, persona);
           return;
        }

        // The body is NDJSON: one typed event per line. Prose arrives as `text`;
        // charts, navigation and citations arrive as their own events instead of
        // being smuggled through the prose as `<<<TAG>>>` markers.
        const messageContent = addMessage('', 'ai', true, persona);
        messageContent?.classList.add('chat-prose--streaming');
        const wrapper = messageContent ? messageContent.closest('.ai-content-wrapper') : null;
        let streamFailed = false;

        await readEventStream(res, (event) => {
            switch (event.type) {
                case 'text':
                    accumulatedText += event.text;
                    if (messageContent) messageContent.innerHTML = formatText(accumulatedText);
                    break;
                case 'tool':
                    handleToolEvent(event.name, event.input, wrapper);
                    break;
                case 'citations':
                    renderCitations(event.sources, wrapper);
                    break;
                case 'error':
                    streamFailed = true;
                    if (messageContent) messageContent.textContent = "⚠️ " + event.message;
                    break;
            }
            messages.scrollTop = messages.scrollHeight;
        }, activeRequest.signal);

        if (streamFailed) return;

        // A stream that ends with neither text nor an error event was cut short.
        if (!accumulatedText.trim()) {
            if (messageContent) messageContent.textContent = "⚠️ " + (t.error || "Sorry, I encountered an error.");
            return;
        }

        saveMessageToHistory(accumulatedText, 'ai', persona);

            } catch (err) {
              removeTyping();
              // Pressing stop is a choice, not a failure. The partial answer stays on
              // screen but is deliberately not saved to history, and the return keeps
              // the voice block below from reading half a sentence aloud.
              if (err?.name === 'AbortError') return;
              console.error(err);
              addMessage(`⚠️ Connection error: ${err.message || 'Unknown'}`, 'ai', false, persona);
              return; // Exit on error
            } finally {
              // Runs on every exit — success, stop, error and the early returns above —
              // so the control can never be left showing a stop icon with nothing running.
              // The caret marks the writing position; the turn is over on every path out
        // of here — finished, stopped or failed — so it comes off in the same place
        // the stop button turns back into a send button.
        document.querySelectorAll('.chat-prose--streaming')
            .forEach((el) => el.classList.remove('chat-prose--streaming'));
        activeRequest = null;
              setStreaming(false);
            }
            
             // --- VOICE RESPONSE (Level 3) ---
             console.log("🎤 Voice Check | wasVoiceInput:", wasVoiceInput, "Text Length:", accumulatedText?.length);

             if (wasVoiceInput) {
                 try {
                      // Extract text from HTML (remove tags for speech)
                      const speechText = accumulatedText
                         .replace(/<<<.*?>>>/g, '') // Remove tool commands
                         .replace(/<[^>]*>/g, '')   // Remove HTML
                         .replace(/\*/g, '')        // Remove markdown
                         .trim();
                         
                      console.log("🎤 Speech Text extracted:", speechText.substring(0, 50) + "...");

                      if (speechText) {
                          // Play Audio
                          await playTextToSpeech(speechText);
                      } else {
                          console.warn("🎤 No speech text found after cleaning.");
                      }
                 } catch (e) {
                     console.error("Auto-Speak Error:", e);
                 } finally {
                     wasVoiceInput = false; // Reset flag
                 }
             }
           }); // End submit listener

    // --- VISUALIZER ---
    import { AudioVisualizer } from '../lib/audio-visualizer'; // Ensure this path is correct
    const visualizerCanvas = document.getElementById('audio-visualizer');
    let visualizer = null;

    if (visualizerCanvas) {
        visualizer = new AudioVisualizer(visualizerCanvas, 'rgb(212, 121, 79)'); // Gold
    }

    // --- TTS HELPER ---

    
    /**
     * Read the reply aloud after a spoken question.
     *
     * This posted to /api/speak for ElevenLabs audio, on a key that exists in no
     * environment — so the one thing a voice conversation is for failed silently every
     * time. The read-aloud button under every answer already used the browser's
     * speechSynthesis; two mechanisms, only one of which works, is one too many.
     */
    function playTextToSpeech(text: string) {
        const robotIcon = document.querySelector('#fp-chat-messages .fa-robot');
        robotIcon?.classList.add('text-accent', 'animate-pulse');
        visualizerCanvas?.classList.remove('opacity-0');

        const done = () => {
            robotIcon?.classList.remove('text-accent', 'animate-pulse');
            visualizerCanvas?.classList.add('opacity-0');
        };

        if (!window.speechSynthesis) return done();
        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(text.replace(/[*#`]/g, ''));
        utterance.lang = ({ da: 'da-DK', de: 'de-DE', en: 'en-GB' } as Record<string, string>)[lang] || 'da-DK';
        utterance.onend = done;
        utterance.onerror = done;
        window.speechSynthesis.speak(utterance);
    }
    


    // ... (Inside Voice Logic)
    // Update startRecording to set flag

    const STORAGE_KEY = 'anton_ai_chat_history';

    // Copy, read-aloud and regenerate under each answer. `isBusy` is what keeps a
    // regenerate from being fired into a reply that is still streaming.
    const messageActions = createMessageActions({
        inputId: 'fp-chat-input',
        formId: 'fp-chat-form',
        messagesId: 'fp-chat-messages',
        storageKey: STORAGE_KEY,
        isBusy: () => activeRequest !== null,
        lang,
        classes: CHAT_ACTION_THEME,
    });

    const { handleToolEvent, renderCitations } = createChatRenderers({
        inputId: 'fp-chat-input',
        formId: 'fp-chat-form',
        messagesId: 'fp-chat-messages',
        lang,
        classes: CHAT_THEME,
    });

    /** The stored transcript, parsed. Shared by the replay and the request window. */
    function readStoredHistory() {
        try {
            const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
            return Array.isArray(parsed) ? parsed : [];
        } catch {
            // A corrupt transcript costs the conversation its memory, not the reply.
            return [];
        }
    }
    function loadHistory() {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored) {
            try {
                const history = JSON.parse(stored);
                // Clear default intro if history exists (optional, but cleaner)
                // messages.innerHTML = ''; 
                history.forEach(msg => addMessage(msg.text, msg.role, true, msg.persona));
            } catch (e) {
                console.error("History parse error", e);
            }
        }
    }

    function saveMessageToHistory(text, role, persona) {
        const stored = localStorage.getItem(STORAGE_KEY);
        let history = stored ? JSON.parse(stored) : [];
        history.push({ text, role, persona, timestamp: Date.now() });
        // Limit to last 100 messages
        if (history.length > 100) history = history.slice(-100);
        localStorage.setItem(STORAGE_KEY, JSON.stringify(history));
    }

    document.getElementById('fp-clear-chat')?.addEventListener('click', () => {
       if(confirm("Are you sure you want to clear the chat history?")) {
           localStorage.removeItem(STORAGE_KEY);
           location.reload();
       }
    });

    function addMessage(text, role, skipSave = false, persona = 'default') {
      if (!messages) return;
      
      if (!skipSave) saveMessageToHistory(text, role, persona);
      const div = document.createElement('div');
      div.className = `flex gap-4 ${role === 'user' ? 'flex-row-reverse' : ''}`;
      div.dataset.role = role;
      if (role === 'user') div.dataset.text = text;

      let contentElement;

      // Map personas to titles
      const titles = {
            'default': 'AI Analysis',
            'recruiter': '💼 Recruiter Mode',
            'tech': '💻 Tech Lead Mode',
            'eli5': '👶 ELI5 Mode'
      };
      const displayTitle = titles[persona] || titles['default'];

      if (role === 'ai') {
        div.innerHTML = `
          <div class="w-10 h-10 rounded-full bg-accent/20 text-accent flex items-center justify-center flex-shrink-0 mt-1 border border-accent/20">
            <i class="fa-solid fa-robot text-lg"></i>
          </div>
          <div class="flex flex-col max-w-[85%] ai-content-wrapper">
              <div class="message-bubble">
                <p class="message-rubric">
                    <span>${displayTitle}</span>
                    ${persona !== 'default' ? '<i class="fa-solid fa-check-circle opacity-50"></i>' : ''}
                </p>
                <div class="chat-prose">
                  ${formatText(text)}
                </div>
              </div>
          </div>
        `;
        contentElement = div.querySelector('.chat-prose');
        if (text) contentElement.innerHTML = formatText(text);

        messageActions.attach(div.querySelector('.ai-content-wrapper'));

        // Replayed history is prose only. Charts, citations and suggestion chips were
        // live tool events and are not reconstructed from a stored transcript.

      } else {
        const bubble = document.createElement('div');
        bubble.className = "bg-accent p-4 md:p-5 rounded-sm rounded-tr-none max-w-[85%] text-left shadow-lg font-medium text-sm md:text-base border border-accent text-text";
        const p = document.createElement('p');
        p.className = "text-bg font-semibold";
        p.textContent = text;
        bubble.appendChild(p);
        div.appendChild(bubble);
      }

      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;

      return contentElement;
    }

    let typingInterval;

    function showTyping() {
      if (!messages) return;
      const div = document.createElement('div');
      div.id = 'fp-typing';
      div.className = 'flex gap-4';
      
      div.innerHTML = `
         <div class="w-10 h-10 rounded-full bg-accent text-bg flex items-center justify-center flex-shrink-0 mt-1 animate-pulse">
            <i class="fa-solid fa-microchip text-lg"></i>
          </div>
          <div class="bg-[var(--rule)] border border-accent/20 p-4 rounded-2xl rounded-tl-none flex items-center">
            <span id="typing-text" class="text-xs font-mono text-accent tracking-wider">⚡ Initializing Quantum Core...</span>
          </div>
      `;
      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;

      const states = [
          "⚡ Initializing Quantum Core...",
          "🌪️ Reading Context & Metadata...",
          "📚 Searching Knowledge Base...",
          "🧠 Analyzing Economic Models...",
          "✨ Generating Response..."
      ];
      
      let stateIdx = 0;
      const textSpan = div.querySelector('#typing-text');
      
      if (textSpan) {
          typingInterval = setInterval(() => {
              stateIdx = (stateIdx + 1) % states.length;
              textSpan.textContent = states[stateIdx];
          }, 800);
      }
    }

    function removeTyping() {
      if (typingInterval) clearInterval(typingInterval);
      const el = document.getElementById('fp-typing');
      if (el) el.remove();
    }



    // Rendering model output is security-critical and used to live in triplicate,
    // once per chat client. renderModelText() is the single tested implementation:
    // strip control tags, escape, then add markup. See src/lib/ai/safe-html.ts.
    function formatText(text) {
      return renderModelText(text, { lineBreak: '<br>' });
    }
    
    // Init History
    loadHistory();

    // Handle URL Query (from Command Palette)
    const urlParams = new URLSearchParams(window.location.search);
    const initialQuery = urlParams.get('q');
    if (initialQuery && input) {
        input.value = initialQuery;
        // Optional: Auto-submit if desired, but filling is safer
        // setTimeout(() => form?.dispatchEvent(new Event('submit')), 500);
    }
  </script>
  <script is:inline src="/assets/js/voice-widget.js"></script>
</Layout>

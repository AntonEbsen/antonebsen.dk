---
import Layout from '@layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import type { VideoCV } from 'src/types/content';
// The page used to <link> this from /assets/css/video-cv.css, a path nothing has
// ever written to — so every visitor got the unstyled version. The stylesheet was
// in src the whole time; import it and let Vite bundle it, as CVPage does with
// print.css.
import '@styles/video-cv.css';
import { assetExists } from '@lib/public-asset';

interface Props {
  lang: 'da' | 'en';
}

const { lang } = Astro.props;
const entry = await getEntry('pages', `${lang}/video-cv`);

if (!entry) {
  throw new Error(`Could not find content for ${lang}/video-cv`);
}

const content = entry.data as unknown as VideoCV;

// Resolve links based on lang
const contactLink = lang === 'en' ? '/en/contact' : '/contact';
const cvLink = lang === 'en' ? '/en/cv' : '/cv';
---

<Layout 
  title={content.title} 
  description={content.description}
  bodyClass={content.bodyClass}
>
  <main class="video-wrap">
    <section class="card hero">
      <div>
        <p class="eyebrow">{content.hero.eyebrow}</p>
        <h1>{content.hero.title}</h1>
        <p class="lead">
          {content.hero.lead}
        </p>

        <div class="cta">
          <a class="btn" href="#video"><i class="fa-solid fa-play"></i> {content.hero.cta.video}</a>
          {/* Was /assets/Anton-CV.pdf, which does not exist. The CV page carries the
              print-to-PDF button, so send people there. */}
          <a class="btn ghost" href={cvLink}>
            <i class="fa-solid fa-file-pdf"></i> {content.hero.cta.pdf}
          </a>
          <a class="btn ghost" href={contactLink}><i class="fa-solid fa-envelope"></i> {content.hero.cta.contact}</a>
        </div>

        <p class="muted small" style="margin:0;">
          {content.hero.tip}
        </p>
      </div>

      <div class="hero-side">
        <div class="mini-card">
          <h2 class="section-title">{content.sidebar.title}</h2>
          <ul class="clean-list">
            {content.sidebar.points.map((pt: string) => (
                <li>{pt}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <div class="stack">

      <section class="card" id="video">
        <h2 class="section-title">Video</h2>

        {/* The video has not been recorded yet, so the <video> element rendered a
            permanently broken player. Say so instead, and start showing the real
            player the moment the file appears in public/. */}
        {assetExists(content.video.src) ? (
          <div class="video-box" style="margin-top:12px;">
            <video controls preload="metadata">
              <source src={content.video.src} type="video/mp4">
              {content.video.downloadText}
              <a href={content.video.src}>{content.video.downloadLink}</a>.
            </video>
          </div>
        ) : (
          <p class="muted" style="margin-top:12px;">
            {lang === 'da'
              ? 'Videoen er under optagelse. Indtil da giver CV’et nedenfor det fulde billede.'
              : 'The video is still being recorded. Until then, the CV below has the full picture.'}
          </p>
        )}

        <div class="two-col">
          <div class="mini-card">
            <h3 style="margin:0 0 8px;">{content.summary.title}</h3>
            <ul class="clean-list">
                {content.summary.items.map((item: string) => (
                    <li>{item}</li>
                ))}
            </ul>
          </div>

          <div class="mini-card">
            <h3 style="margin:0 0 8px;">{content.chapters.title}</h3>
            <ul class="chapters">
                {content.chapters.items.map((item: string) => (
                    <li>{item}</li>
                ))}
            </ul>
            <p class="muted small" style="margin:10px 0 0;">
                {content.chapters.note}
            </p>
          </div>
        </div>
      </section>

      <section class="card">
        <h2 class="section-title">{content.links.title}</h2>
        <p class="muted">{content.links.text}</p>

        <div class="cta">
          {/* The "PDF" button next to this pointed at a file that does not exist; the
              CV link beside it reaches the page that can produce one. */}
          <a class="btn" href={cvLink}><i class="fa-solid fa-id-card"></i> {content.links.items.cv}</a>
          <a class="btn ghost" href="https://www.linkedin.com/in/antonebsen/" target="_blank" rel="noopener"><i class="fa-brands fa-linkedin"></i> {content.links.items.linkedin}</a>
          <a class="btn ghost" href="https://github.com/AntonEbsen" target="_blank" rel="noopener"><i class="fa-brands fa-github"></i> {content.links.items.github}</a>
        </div>
      </section>

    </div>
  </main>
</Layout>




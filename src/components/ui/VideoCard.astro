---
import YouTubeEmbed from '@components/ui/YouTubeEmbed.astro';
import Pill from '@components/ui/Pill.astro';
import {
  seriesPath, slugifySeries, videoPath, videoTitle, videoDescription, videoSeriesName,
  trackIcon, trackPillVariant, type Lang
} from '@lib/video-feed';
import type { CollectionEntry } from 'astro:content';

interface Props {
  video: CollectionEntry<'videos'>['data'];
  lang: Lang;
  /** Entry id without extension — enables the link through to the detail page. */
  slug?: string;
}

const { video, lang, slug } = Astro.props;
const isDa = lang === 'da';

const entry = { ...video, slug: slug ?? '' } as any;

const detailUrl = slug ? videoPath(slug, lang) : undefined;

const title = videoTitle(entry, lang);
const description = videoDescription(entry, lang);
const series = videoSeriesName(entry, lang);

const trackLabel = {
  hiking: { da: 'Vandring', en: 'Hiking', de: 'Wandern' }[lang],
  economics: { da: 'Økonomi', en: 'Economics', de: 'Wirtschaft' }[lang]
}[video.track];

const icon = trackIcon(video.track);
const pillVariant = trackPillVariant(video.track);

const locale = { da: 'da-DK', en: 'en-GB', de: 'de-DE' }[lang];

const published = new Date(video.publishedAt).toLocaleDateString(locale, {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});

const relatedUrl = video.relatedProjectUrl
  ?? (video.relatedBlogSlug ? `${isDa ? '/da' : ''}/blog/${video.relatedBlogSlug}` : undefined);

const t = {
  da: { chapters: 'Kapitler', related: 'Læs projektet', watchOn: 'Se på YouTube', details: 'Turen i tal' },
  en: { chapters: 'Chapters', related: 'Read the project', watchOn: 'Watch on YouTube', details: 'The walk in numbers' },
  de: { chapters: 'Kapitel', related: 'Zum Projekt', watchOn: 'Auf YouTube ansehen', details: 'Die Tour in Zahlen' }
}[lang];

const hasTrail = !!(video.gpxFile || video.trail);

// mm:ss for chapter deep-links.
const stamp = (seconds: number) => {
  const m = Math.floor(seconds / 60);
  const s = seconds % 60;
  return `${m}:${String(s).padStart(2, '0')}`;
};
---

<article
  class="video-card group flex flex-col gap-4 opacity-100 transition-opacity duration-300"
  data-category={video.track}
>
  <YouTubeEmbed
    youtubeId={video.youtubeId}
    title={title}
    orientation={video.orientation}
  />

  <div class="flex flex-col gap-3 px-1">
    <div class="flex flex-wrap items-center gap-2">
      <Pill variant={pillVariant}><i class={`${icon} mr-1.5`} aria-hidden="true"></i>{trackLabel}</Pill>
      {series && (
        video.series
          ? <a href={seriesPath(slugifySeries(video.series), lang)} class="no-underline">
              <Pill class="hover:border-accent/50 hover:text-accent transition-colors">
                {series}{video.seriesOrder ? ` · ${video.seriesOrder}` : ''}
              </Pill>
            </a>
          : <Pill>{series}{video.seriesOrder ? ` · ${video.seriesOrder}` : ''}</Pill>
      )}
    </div>

    <h3 class="text-lg font-bold text-text leading-snug group-hover:text-accent transition-colors">
      {detailUrl
        ? <a href={detailUrl} class="no-underline text-inherit hover:text-accent transition-colors">{title}</a>
        : title}
    </h3>

    <p class="text-sm text-muted leading-relaxed m-0">{description}</p>

    {video.stats && video.stats.length > 0 && (
      <dl class="flex flex-wrap gap-x-6 gap-y-2 mt-1 border-t border-white/5 pt-3 m-0">
        {video.stats.map((stat) => (
          <div class="flex flex-col">
            <dt class="text-[10px] uppercase tracking-widest text-muted">
              {(isDa && stat.label_da) || (lang === 'de' && stat.label_de) || stat.label}
            </dt>
            <dd class="text-sm font-bold text-accent m-0">
              {stat.icon && <i class={`${stat.icon} mr-1.5 opacity-70`} aria-hidden="true"></i>}{stat.value}
            </dd>
          </div>
        ))}
      </dl>
    )}

    {video.chapters && video.chapters.length > 0 && (
      <details class="mt-1 border-t border-white/5 pt-3">
        <summary class="text-[10px] uppercase tracking-widest text-muted cursor-pointer hover:text-accent transition-colors">
          {t.chapters}
        </summary>
        <ul class="mt-3 space-y-1.5 list-none p-0 m-0">
          {video.chapters.map((chapter) => (
            <li>
              <a
                href={`https://www.youtube.com/watch?v=${video.youtubeId}&t=${chapter.t}s`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex gap-3 text-xs text-muted hover:text-accent transition-all no-underline"
              >
                <span class="font-mono text-accent tabular-nums">{stamp(chapter.t)}</span>
                <span>{(isDa && chapter.label_da) || (lang === 'de' && chapter.label_de) || chapter.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    )}

    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mt-2 text-[11px]">
      <time datetime={video.publishedAt} class="text-muted uppercase tracking-wider">
        {published}
      </time>

      {detailUrl && hasTrail && (
        <a href={detailUrl} class="text-accent font-bold no-underline hover:text-white transition-colors">
          <i class="fa-solid fa-chart-line mr-1 text-[9px]" aria-hidden="true"></i>{t.details}
        </a>
      )}

      {relatedUrl && (
        <a href={relatedUrl} class="text-accent font-bold no-underline hover:text-white transition-colors">
          {t.related} <i class="fa-solid fa-arrow-right text-[9px] ml-0.5" aria-hidden="true"></i>
        </a>
      )}

      {video.links?.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent font-bold no-underline hover:text-white transition-colors"
        >
          {link.icon && <i class={`${link.icon} mr-1`} aria-hidden="true"></i>}{link.label}
        </a>
      ))}
    </div>
  </div>
</article>

---
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import SEO from '@components/SEO.astro';
import ChatWidget from '../components/common/ChatWidget.astro';
import CommandPalette from '@components/common/CommandPalette.astro';
import LedgerToast from '../components/game/LedgerToast.astro';
import LedgerModal from '../components/game/LedgerModal.astro';
import Chameleon from '@components/core/Chameleon.astro';
import Scriptorium from '@components/core/Scriptorium.astro';
import Anathema from '@components/core/Anathema.astro';
import { getLangFromUrl } from '@i18n/utils';
import '@styles/styles.css';
import SpeedInsights from "@vercel/speed-insights/astro"
// The /astro entry, not /react: the React one mounted a client:load island that
// dragged React onto all ~196 pages (only ~10 have a genuine React island).
import Analytics from "@vercel/analytics/astro"
import '@fontsource-variable/inter';
// Fraunces for display. 80 font-serif usages previously fell through to Tailwind's
// default ui-serif stack and rendered as whatever Georgia/Times the OS supplied.
// Weight axis only: SOFT/WONK/opsz would cost 264 KB across both styles against
// 80 KB here, and at display sizes the weight axis carries the character.
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/fraunces/wght-italic.css';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  bodyClass?: string;
  showChatWidget?: boolean;
  currentPath?: string;
  /** Explicit hreflang targets for sections with translated slugs — see SEO.astro. */
  alternates?: Partial<Record<'da' | 'en' | 'de', string>>;
}

const { title, description, image, article, bodyClass = "", showChatWidget = true, alternates } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <!-- 1. CRITICAL CSS: Inline everything needed for first paint -->
  <style is:inline>
    /* === CSS VARIABLES ===
       Palette: terrain and archive. Stone underfoot, paper for the record,
       terracotta for waymarks and clay, moss for the Camino.
       Every pairing below is verified against WCAG AA (4.5:1) — the first
       terracotta tried, #C2673F, measured 4.46:1 and was rejected. */
    :root {
      /* BACKGROUNDS — stone, not the boutique black this used to be */
      --bg: #17191A;
      --bg-gradient: radial-gradient(circle at 50% 0%, #23201D 0%, #17191A 60%);
      --depth-bg: radial-gradient(circle at 60% -20%, #26221E 0%, #17191A 50%);
      --card: #1E2122;

      /* TEXT — paper white, warm rather than clinical */
      --text: #E8E4DC;          /* 13.9:1 on --bg */
      --text-dim: #B8BCB5;      /*  9.2:1 on --bg, still 5.1:1 at opacity-70 */
      --text-muted: #8E938B;    /*  5.0:1 on --bg — use this instead of stacking
                                    opacity on --text-dim, which is what caused
                                    the contrast failures found in the a11y pass */
      --muted: rgba(184, 188, 181, 0.4);

      /* ACCENT: TERRACOTTA */
      --accent: #D4794F;        /*  5.6:1 on --bg, 5.1:1 on --card */
      --accent-light: #E39068;
      --accent-soft: rgba(212, 121, 79, 0.15);
      --accent-glow: 0 0 25px rgba(212, 121, 79, 0.28);

      /* SECONDARY: MOSS — the Camino green, promoted to a real token */
      --accent-2: #6F9E7B;      /*  5.8:1 on --bg */
      --accent-2-light: #8FBC9B;
      --accent-2-soft: rgba(111, 158, 123, 0.15);

      /* COMPONENTS */
      --nav: rgba(23, 25, 26, 0.85);
      --navHover: rgba(232, 228, 220, 0.06);

      /* GLASS / BORDERS */
      --glass: rgba(30, 33, 34, 0.7);
      --glass-border: rgba(232, 228, 220, 0.10);
      --glass-border-hover: rgba(212, 121, 79, 0.5);

      /* CHANNEL FORMS — the same colours as bare R G B values.
         Tailwind cannot apply an opacity modifier to a colour it receives as the
         string `var(--accent)`: it has no channels to inject the alpha into, so
         `bg-accent/20` silently produced no CSS at all. There are ~414 such classes
         in the markup — bg-accent/10, border-accent/30, text-dim/70 and friends —
         and none of them has ever rendered. tailwind.config.mjs reads these instead,
         as `rgb(var(--accent-rgb) / <alpha-value>)`.

         Keep each pair in step with the hex token directly above it. */
      --bg-rgb: 23 25 26;
      --card-rgb: 30 33 34;
      --text-rgb: 232 228 220;
      --text-dim-rgb: 184 188 181;
      --text-muted-rgb: 142 147 139;
      --accent-rgb: 212 121 79;
      --accent-light-rgb: 227 144 104;
      --accent-2-rgb: 111 158 123;

      --shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.6);
      --radius: 16px;
      
      /* TYPOGRAPHY - System font stack for instant render, Inter loads progressively */
      --font-main: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif;
      /* Display face. Georgia leads the fallback because it is the metric-closest
         serif already on most machines, which keeps the swap from shifting layout. */
      --font-display: 'Fraunces Variable', Georgia, 'Times New Roman', serif;
      --h1-size: clamp(48px, 6vw, 76px);
      --h2-size: clamp(28px, 4vw, 42px);
      --body-size: 16px;
      --lh-body: 1.7;
      --ls-heading: -0.02em;
    }
    
    /* Progressive enhancement: Use Inter when it loads */
    body {
      font-family: 'Inter', var(--font-main);
    }
    
    /* === RESET & BASE STYLES === */
    * { box-sizing: border-box; }
    
    html, body {
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }
    
    html {
      background-color: var(--bg);
      color: var(--text);
      font-family: var(--font-main);
      transition: none !important;
    }
    
    body {
      font-family: var(--font-main);
      font-size: var(--body-size);
      line-height: var(--lh-body);
      background: var(--depth-bg);
      background-attachment: fixed;
      color: var(--text);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      min-height: 100vh;
      position: relative;
    }
    
    a {
      color: var(--accent);
      text-decoration: none;
      transition: all 0.3s ease;
    }
    
    img {
      max-width: 100%;
      height: auto;
      display: block;
    }
    
    h1, h2, h3 {
      color: var(--text);
      margin: 0 0 0.5em;
      font-weight: 800;
    }
    
    /* === MATH / KATEX === */
    .katex-display {
      overflow-x: auto;
      overflow-y: hidden;
      padding-bottom: 0.5rem;
      -webkit-overflow-scrolling: touch;
    }
  </style>

  <!-- 2. SEO and other metadata -->
  <SEO title={title} description={description} image={image} article={article} alternates={alternates} />
  <meta name="design-version" content="terrain-v1" />
  <SpeedInsights />
  <Analytics />
  
  <!-- 3. Font preloading for instant text rendering -->
  <!-- Replaced with @fontsource-variable/inter -->
  
  <!-- 4. Non-critical CSS and scripts (deferred) -->
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <!-- Font Awesome: load asynchronously so it doesn't block first paint -->
  <link rel="preload" as="style" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"></noscript>

  <slot name="head" />
  
  <!-- Add grain texture after page loads for smoother first paint -->
  <script is:inline>
    window.addEventListener('DOMContentLoaded', function() {
      const grain = document.createElement('div');
      grain.style.cssText = 'content:"";position:fixed;inset:0;background:url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciPjxmaWx0ZXIgaWQ9Im4iPjxmZVR1cmJ1bGVuY2UgdHlwZT0iZnJhY3RhbE5vaXNlIiBiYXNlRnJlcXVlbmN5PSIwLjgiIG51bU9jdGF2ZXM9IjIiIHN0aXRjaFRpbGVzPSJzdGl0Y2giLz48L2ZpbHRlcj48cmVjdCB3aWR0aD0iMTAwJSIgaGVpZ2h0PSIxMDAlIiBmaWx0ZXI9InVybCgjbikiLz48L3N2Zz4=");opacity:0.03;pointer-events:none;z-index:1000;';
      document.body.insertBefore(grain, document.body.firstChild);
    });
  </script>
</head>
<body class={bodyClass}>
  <Chameleon />
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[9999] bg-gold-500 text-black px-4 py-2 font-bold rounded">
    Skip to Content
  </a>
  <Navbar />

  <div id="main-content">
    <slot />
  </div>

  <Footer />

  
  {showChatWidget && <ChatWidget />}
  <CommandPalette />
  <LedgerToast />
  <LedgerModal />
  <Scriptorium />
  <Anathema />

  <script>
    // Premium reveal observer
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          // Optionally unobserve after revealing
          // revealObserver.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    });

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
    });

    // Handle dynamic content (like search results or filtered CV items)
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        mutation.addedNodes.forEach((node) => {
          if (node instanceof HTMLElement && node.classList.contains('reveal')) {
            revealObserver.observe(node);
          }
          if (node instanceof HTMLElement) {
             node.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
          }
        });
      });
    });

    observer.observe(document.body, { childList: true, subtree: true });
  </script>
  {/*
    A script here forced .animate-on-scroll elements visible. It was doubly
    inert: wrapped in 'astro:page-load', which never fires without the View
    Transitions router, and redundant anyway — animations.css already sets
    `opacity: 1 !important; transform: none !important` on that class
    unconditionally. It also assigned .style on an Element from
    querySelectorAll, which cost two entries on the type-error ratchet.
  */}
  <script>
    import { unlockAchievement, checkPolyglotAchievement, checkPageVisitAchievement } from '../lib/gamification';

    // Counts this page towards 'explorer'. The function has existed since the
    // system was written and was never called anywhere, so that entry could only
    // ever be awarded by the AI chat deciding to hand it out.
    // Not deferred: a visitor who bounces on their fifth page still walked it.
    checkPageVisitAchievement();

    const konamiCode = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
    let cursor = 0;

    document.addEventListener('keydown', (e) => {
      if (e.key === konamiCode[cursor]) {
        cursor++;
        if (cursor === konamiCode.length) {
          unlockAchievement('easter_egg');
          cursor = 0;
        }
      } else {
        cursor = 0; 
      }
    });

    // Check Polyglot
    
    // Check Night Owl (00:00 - 05:00)
    const hour = new Date().getHours();
    if (hour >= 0 && hour < 5) {
        unlockAchievement('night_owl');
    }

    // Expose for static scripts (search.js)
    window.unlockAchievement = unlockAchievement;
    
    // Run delayed checks
    setTimeout(() => {
        checkPolyglotAchievement();
    }, 1000);

    // --- META ACHIEVEMENTS TRIGGERS ---

    // 1. Pixel Perfect (Resize)
    let resizeCount = 0;
    let lastWidth = window.innerWidth;
    window.addEventListener('resize', () => {
        if (Math.abs(window.innerWidth - lastWidth) > 50) {
            resizeCount++;
            lastWidth = window.innerWidth;
            if (resizeCount >= 3) {
                unlockAchievement('pixel_perfect');
            }
        }
    });

    // 2. Speed Demon (Page Navigation Speed)
    // We use sessionStorage to store timestamps of recent page loads
    const now = Date.now();
    let visits = JSON.parse(sessionStorage.getItem('page_visits') || '[]');
    // Filter out visits older than 30 seconds
    visits = visits.filter(t => now - t < 30000);
    visits.push(now);
    sessionStorage.setItem('page_visits', JSON.stringify(visits));
    
    if (visits.length >= 5) {
        unlockAchievement('speed_demon');
    }

    // 3. Social Butterfly (Link Clicks)
    document.addEventListener('click', (e) => {
        const link = e.target.closest('a');
        if (link && link.href) {
            const isExternal = link.hostname !== window.location.hostname;
            const isSocial = /linkedin|github|twitter|instagram|facebook/.test(link.href);
            
            if (isExternal && isSocial) {
                let clickedSocials = JSON.parse(localStorage.getItem('clicked_socials') || '[]');
                if (!clickedSocials.includes(link.href)) {
                    clickedSocials.push(link.href);
                    localStorage.setItem('clicked_socials', JSON.stringify(clickedSocials));
                }
                
                if (clickedSocials.length >= 3) {
                    unlockAchievement('social_butterfly');
                }
            }
        }
    });
  </script>
</body>
</html>


---
import Layout from '@layouts/BaseLayout.astro';
import CollaboratorSpotlight from '@components/project/CollaboratorSpotlight';
import ResearchRadar from '@components/project/ResearchRadar';
import { anton, sheng, jonas } from '@data/collaborators';
import { getImage } from 'astro:assets';
import portraitSrc from '../../assets/img/billede-af-mig.jpg';

// See the note in the Danish team page: the island needs a URL string, and the raw
// public path meant shipping the 785 KB original for an avatar.
const portrait = await getImage({ src: portraitSrc, width: 128, format: 'webp' });

// Identity comes from @data/collaborators; the role, bio and status are what this
// page adds on top.
const team = [
    {
        ...anton,
        role: "Lead Author & Developer",
        image: portrait.src,
        description: "Specializes in macroeconomic modeling, web development, and bridging the gap between economic theory and data science.",
        status: { text: "Starting thesis", color: "yellow" }
    },
    {
        ...sheng,
        role: "Co-Author & Data Scientist",
        description: "Expertise in high-dimensional data handling, Stata programming, and rigorous econometric implementation (GMM).",
        status: { text: "Coding Stata", color: "blue" }
    },
    {
        ...jonas,
        role: "Co-Author & Theorist",
        description: "Focus on monetary policy transmission mechanisms, game theory, and structural break analysis in time-series data.",
        status: { text: "Reviewing Theory", color: "green" }
    }
];

// The four joint works. Titles, years, grades and PDF paths come from each project's
// own citation block; `pdf` is omitted where the file doesn't exist yet.
const jointOutput = [
    {
        title: "Globalization and the Welfare State",
        year: "2026",
        kind: "Seminar paper",
        venue: "Economics of the Welfare State, University of Copenhagen. Supervisor: Amalie Sofie Jensen.",
        role: "Method and identification, residual diagnostics, rolling regressions, sub-period analysis, choice of standard errors and reverse causality.",
        grade: "10",
        href: "/en/projects/welfare-state-seminar",
        pdf: "/assets/docs/Nielsen_Chen_Jorgensen_2026_Globalization_and_the_Welfare_State.pdf"
    },
    {
        title: "Does GenAI Help Those Who Need It Most?",
        year: "2026",
        kind: "Research proposal",
        venue: "AI for Humanity, University of Copenhagen. Heterogeneous effects of generative AI in Danish upper-secondary schools.",
        grade: "10",
        href: "/en/projects/genai-inequality"
    },
    {
        title: "One Rule to Rule Them All?",
        year: "2024",
        kind: "Seminar paper",
        venue: "ECB monetary policy and asymmetric effects across the euro area. Supervisor: Michael Bergman.",
        grade: "10",
        href: "/en/projects/ecb-taylor-rules"
    },
    {
        title: "Monetary Policy & Economic Relations",
        year: "2026–27",
        kind: "Master's thesis",
        venue: "Starts 20 August 2026. Empirical analysis of monetary policy in a post-COVID world.",
        href: null
    }
];

// "Projects", not "publications" — these are seminar papers and a proposal, and
// every tile is checkable against a page on this site.
const stats = [
    { label: "Joint Projects", value: "4", icon: "fa-book-open" },
    { label: "Collaborative Years", value: "6", icon: "fa-calendar-check" },
    { label: "Academic Focus", value: "Macro & Political Economy", icon: "fa-globe" },
    { label: "Latest Paper", value: "June 2026", icon: "fa-file-lines" },
];

const timeline = [
    { year: "2020", title: "Formation", desc: "Met at the University of Copenhagen. Established a collaborative workflow for Microeconomics and Mathematical Analysis.", href: null },
    { year: "2023", title: "Exchange Rate Dynamics", desc: "First joint project, written with Sheng during our bachelor's. Analysis of Danish inflation and relative exchange rates.", href: "/en/projects/exchange-rate-dynamics" },
    { year: "2024", title: "ECB Taylor Rules", desc: "The first seminar paper all three of us wrote together. GMM estimation of asymmetric policy responses in the euro area.", href: "/en/projects/ecb-taylor-rules" },
    { year: "2026", title: "Does GenAI Help Those Who Need It Most?", desc: "Research proposal on the heterogeneous effects of generative AI across socioeconomic lines in Danish upper-secondary schools.", href: "/en/projects/genai-inequality" },
    { year: "2026", title: "Globalization and the Welfare State", desc: "Seminar paper submitted June 2026. Panel data analysis of 32 OECD countries 1980–2023; rolling regressions uncover a structural break at 2008.", href: "/en/projects/welfare-state-seminar" },
    { year: "2026", title: "Master's Thesis", desc: "Monetary Policy & Economic Relations. Starts 20 August 2026, focusing on monetary policy in a post-COVID world.", href: null },
];
---

<Layout title="Research Group | Anton Ebsen" description="The academic team behind the projects." currentPath="/en/team">
    <main class="bg-slate-950 min-h-screen text-slate-200 pb-24">
        
        {/* Hero */}
        <div class="relative min-h-[50vh] flex items-center justify-center overflow-hidden border-b border-white/5">
             <div class="absolute inset-0 bg-slate-950">
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-blue-900/10 via-slate-950/50 to-slate-950"></div>
             </div>
             
             <div class="container mx-auto px-4 relative z-10 text-center">
                 <div class="animate-in fade-in slide-in-from-bottom-8 duration-1000">
                    <h1 class="text-4xl md:text-6xl font-serif font-medium text-white mb-6 tracking-tight">
                        Research Group
                    </h1>
                    <p class="text-lg md:text-xl text-slate-400 font-serif italic max-w-2xl mx-auto leading-relaxed">
                        A collaborative effort to advance the understanding of macroeconomic dynamics through rigorous data analysis and economic theory.
                    </p>
                 </div>
             </div>
        </div>

        {/* Team Stats */}
        <section class="container mx-auto max-w-5xl px-4 py-16">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                {stats.map(stat => (
                    <div class="bg-white/5 border border-white/10 p-8 rounded-2xl text-center hover:border-blue-500/30 transition-colors group">
                        <i class={`fa-solid ${stat.icon} text-2xl text-slate-400 mb-4 group-hover:text-blue-400 transition-colors`}></i>
                        <h3 class="text-3xl font-bold text-white mb-2 font-serif">{stat.value}</h3>
                        <p class="text-xs uppercase tracking-widest text-slate-400 font-bold">{stat.label}</p>
                    </div>
                ))}
            </div>
        </section>

        {/* The Team */}
        <section class="container mx-auto max-w-4xl px-4 py-16 border-t border-white/5">
             <h2 class="text-center text-xs uppercase tracking-[0.2em] font-bold text-slate-400 mb-16">Core Members</h2>
             <CollaboratorSpotlight client:visible collaborators={team} label="" />
        </section>

        {/* Timeline */}
        <section class="container mx-auto max-w-3xl px-4 py-16 relative">
            <h2 class="text-center text-xs uppercase tracking-[0.2em] font-bold text-slate-400 mb-16">Collaboration History</h2>
            
            <div class="absolute left-1/2 top-32 bottom-0 w-px bg-white/10 -translate-x-1/2"></div>
            
            <div class="space-y-24">
                {timeline.map((item, i) => (
                    <div class={`relative flex flex-col md:flex-row items-center justify-between gap-8 md:gap-0 ${i % 2 === 0 ? 'md:flex-row-reverse' : ''}`}>
                        <div class="hidden md:block md:w-5/12"></div>
                        <div class="absolute left-4 md:left-1/2 md:-translate-x-1/2 w-4 h-4 rounded-full bg-slate-900 border-2 border-slate-700 z-10 mt-1.5 md:mt-0"></div>
                        <div class={`w-full pl-12 md:pl-0 md:w-5/12 ${i % 2 === 0 ? 'md:text-right' : 'md:text-left'} relative`}>
                            <span class="deco-numeral text-3xl md:text-5xl font-bold absolute -top-6 md:-top-8 left-12 md:left-0 md:right-0 pointer-events-none select-none font-serif" data-numeral={item.year} aria-hidden="true"></span>
                            <div class="relative z-10">
                                <h3 class="text-lg font-bold text-white mb-2">
                                    {item.href
                                        ? <a href={item.href} class="hover:text-blue-400 transition-colors">{item.title}</a>
                                        : item.title}
                                </h3>
                                <p class="text-slate-400 text-sm leading-relaxed">{item.desc}</p>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </section>

        {/* Joint output — every field comes from the relevant project's own citation
            block. PDF links appear only where the file actually exists, and the
            thesis has no href because there is no English master-thesis page yet. */}
        <section class="container mx-auto max-w-5xl px-4 py-16 border-t border-white/5">
            <h2 class="text-center text-xs uppercase tracking-[0.2em] font-bold text-slate-400 mb-16">Joint output</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {jointOutput.map(w => (
                    <div class="bg-slate-900/50 border border-white/5 rounded-2xl p-6 flex flex-col hover:border-blue-500/30 transition-colors group">
                        <div class="flex items-start justify-between gap-4 mb-3">
                            <span class="text-[10px] font-bold uppercase tracking-widest text-blue-400">{w.kind}</span>
                            <span class="text-[10px] font-mono text-slate-400 shrink-0">{w.year}</span>
                        </div>
                        <h3 class="text-lg font-bold text-white mb-2 leading-snug">
                            {w.href ? <a href={w.href} class="hover:text-blue-400 transition-colors">{w.title}</a> : w.title}
                        </h3>
                        <p class="text-xs text-slate-400 leading-relaxed mb-4">{w.venue}</p>
                        {w.role && (
                            <p class="text-xs text-slate-400 leading-relaxed mb-4 pl-3 border-l border-blue-500/20 italic">
                                <span class="not-italic font-bold text-slate-400">My role:</span> {w.role}
                            </p>
                        )}
                        <div class="mt-auto pt-4 border-t border-white/5 flex items-center gap-4">
                            {w.grade && (
                                <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-400/80">Grade {w.grade}</span>
                            )}
                            <div class="ml-auto flex items-center gap-4">
                                {w.href && <a href={w.href} class="text-[10px] font-bold uppercase tracking-widest text-slate-400 hover:text-blue-400 transition-colors">Project &rarr;</a>}
                                {w.pdf && (
                                    <a href={w.pdf} class="text-[10px] font-bold uppercase tracking-widest text-slate-400 hover:text-red-400 transition-colors">
                                        <i class="fa-solid fa-file-pdf mr-1"></i>PDF
                                    </a>
                                )}
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </section>

        {/* ... Simple Stack Removed ... */}

        {/* 1. Methodology Workflow */}
        <section class="container mx-auto max-w-5xl px-4 py-16 border-t border-white/5">
             <h2 class="text-center text-xs uppercase tracking-[0.2em] font-bold text-slate-400 mb-16">Methodology & Workflow</h2>
             <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
                 {/* Connecting Line (Desktop) */}
                 <div class="hidden md:block absolute top-12 left-0 w-full h-0.5 bg-gradient-to-r from-transparent via-blue-500/20 to-transparent -z-10"></div>
                 
                 {[
                    { step: "01", title: "Data Engineering", desc: "Automated Python pipelines ensure reproducibility. We never clean data manually.", icon: "fa-server" },
                    { step: "02", title: "Econometrics", desc: "Rigorous identification in Stata. From simple OLS to GMM and structural VAR models.", icon: "fa-chart-line" },
                    { step: "03", title: "Dissemination", desc: "LaTeX for academic papers, Astro for interactive web dashboards. Clarity is king.", icon: "fa-pen-nib" }
                 ].map(s => (
                     <div class="bg-slate-900 border border-white/10 p-8 rounded-2xl relative group hover:-translate-y-2 transition-transform duration-300">
                         <div class="w-12 h-12 bg-slate-800 rounded-full flex items-center justify-center border border-white/10 mb-6 group-hover:border-blue-500/50 group-hover:bg-blue-500/10 transition-colors">
                             <i class={`fa-solid ${s.icon} text-slate-400 group-hover:text-blue-400`}></i>
                         </div>
                         <h3 class="text-xl font-bold text-white mb-2">{s.title}</h3>
                         <p class="text-slate-400 text-sm leading-relaxed">{s.desc}</p>
                         <span class="deco-numeral absolute top-4 right-6 text-4xl font-black" data-numeral={s.step} aria-hidden="true"></span>
                     </div>
                 ))}
             </div>
        </section>

        {/* 2. Thesis Tracker */}
        <section class="container mx-auto max-w-4xl px-4 py-16">
            <div class="bg-gradient-to-br from-blue-900/10 to-slate-900 border border-blue-500/20 rounded-3xl p-8 md:p-12 relative overflow-hidden">
                <div class="absolute top-0 right-0 w-64 h-64 bg-blue-500/10 rounded-full blur-[80px]"></div>
                
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
                    <div>
                         <h2 class="text-lg font-bold text-blue-400 flex items-center gap-2">
                            <i class="fa-solid fa-satellite-dish animate-pulse"></i> Thesis Tracker
                        </h2>
                        <h3 class="text-3xl font-serif text-white mt-2">Monetary Policy &amp; Economic Relations</h3>
                        <p class="text-slate-400 text-sm mt-1">Starts 20 August 2026 · expected submission January 2027</p>
                    </div>
                    <div class="text-right">
                        <span class="text-sm font-bold uppercase tracking-widest text-blue-400">Not yet started</span>
                        <span class="block text-xs text-slate-400 mt-1">Planned phases</span>
                    </div>
                </div>

                {/* Phases, not percentages: the thesis has not begun. */}
                <ol class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    {[
                        { label: "Literature Review", note: "Aug–Sep 2026" },
                        { label: "Data Collection", note: "Sep–Oct 2026" },
                        { label: "Model Validation", note: "Oct–Nov 2026" },
                        { label: "Drafting", note: "Nov 2026–Jan 2027" }
                    ].map((t, i) => (
                        <li class="flex items-start gap-3 bg-slate-900/60 border border-white/5 rounded-xl p-4">
                            <span class="w-6 h-6 rounded-full border border-blue-500/30 text-blue-400 text-[10px] font-bold flex items-center justify-center shrink-0 mt-0.5">{i + 1}</span>
                            <div>
                                <span class="block text-sm font-bold text-slate-200">{t.label}</span>
                                <span class="block text-xs text-slate-400 mt-0.5">{t.note}</span>
                            </div>
                        </li>
                    ))}
                </ol>
            </div>
        </section>

        {/* 3. Data Scale (Big Numbers) */}
        <section class="bg-white/5 py-24 border-y border-white/5">
             <div class="container mx-auto max-w-5xl px-4">
                <h2 class="text-center text-xs uppercase tracking-[0.2em] font-bold text-slate-400 mb-16">Data Scale</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center">
                    <div>
                        <span class="block text-4xl md:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-b from-white to-slate-500 mb-2">32 countries</span>
                        <span class="text-sm font-bold text-blue-400 uppercase tracking-widest">OECD panel, 1980–2023</span>
                        <p class="text-slate-400 text-sm mt-2 max-w-xs mx-auto">CPDS, KOF, OECD and the World Bank harmonised into one panel. N = 996 in the fully specified models. <a href="/en/projects/welfare-state-seminar" class="text-blue-400 hover:underline">Globalization and the Welfare State</a>.</p>
                    </div>
                    <div>
                        <span class="block text-4xl md:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-b from-white to-slate-500 mb-2">1999–2024</span>
                        <span class="text-sm font-bold text-purple-400 uppercase tracking-widest">Quarterly, euro area</span>
                        <p class="text-slate-400 text-sm mt-2 max-w-xs mx-auto">Eurostat, OECD Economic Outlook and the ECB Statistical Data Warehouse. <a href="/en/projects/ecb-taylor-rules" class="text-purple-400 underline decoration-purple-400/40 underline-offset-2 hover:decoration-purple-400">ECB Taylor Rules</a>.</p>
                    </div>
                    <div>
                        <span class="block text-4xl md:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-b from-white to-slate-500 mb-2">20,000+</span>
                        <span class="text-sm font-bold text-emerald-400 uppercase tracking-widest">Data points, high-frequency financial data</span>
                        <p class="text-slate-400 text-sm mt-2 max-w-xs mx-auto">Structured and processed for SVAR estimation. <a href="/en/projects/global-financial-cycle" class="text-emerald-400 underline decoration-emerald-400/40 underline-offset-2 hover:decoration-emerald-400">Global Financial Cycle</a> (bachelor's thesis).</p>
                    </div>
                </div>

                {/* Method coverage. Now renders here too — the radar's labels used to be
                    hardcoded Danish, which is why this page never had it. */}
                <div class="mt-20 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                    <div class="bg-slate-900/50 border border-white/5 p-8 rounded-3xl relative overflow-hidden group hover:border-blue-500/30 transition-colors">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-blue-500/10 rounded-full blur-[40px] group-hover:bg-blue-500/20 transition-colors"></div>
                        <h3 class="text-lg font-bold text-white mb-2 flex items-center gap-2">
                            <i class="fa-solid fa-chart-radar text-blue-400"></i> Method coverage
                        </h3>
                        <p class="text-xs text-slate-400 mb-6 leading-relaxed">
                            How many of the four joint works use each method family. The axis runs 0 to 4.
                        </p>
                        <ResearchRadar
                            client:visible
                            labels={["Panel data & FE", "Time series / VAR", "IV & GMM", "Robustness & diagnostics", "Survey & ML"]}
                            values={[1, 2, 1, 2, 1]}
                            seriesLabel="Joint works"
                            max={4}
                            unit=" of 4 projects"
                        />
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-white mb-4">What the group actually does</h3>
                        <p class="text-sm text-slate-400 leading-relaxed mb-4">
                            Five method families across four joint works, counted rather than self-rated.
                        </p>
                        <ul class="space-y-2 text-xs text-slate-400">
                            <li><span class="font-bold text-slate-400">Panel data &amp; FE</span> — the welfare state seminar.</li>
                            <li><span class="font-bold text-slate-400">Time series / VAR</span> — the ECB project and the thesis.</li>
                            <li><span class="font-bold text-slate-400">IV &amp; GMM</span> — the ECB project.</li>
                            <li><span class="font-bold text-slate-400">Robustness &amp; diagnostics</span> — the ECB project and the welfare seminar.</li>
                            <li><span class="font-bold text-slate-400">Survey &amp; ML</span> — the GenAI proposal.</li>
                        </ul>
                    </div>
                </div>
             </div>
        </section>

        {/* 4. The Library (Citations) */}
        <section class="container mx-auto max-w-4xl px-4 py-16">
            <h2 class="text-center text-xs uppercase tracking-[0.2em] font-bold text-slate-400 mb-12">The Knowledge Bank</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {[
                    "Gabaix, X. & Maggiori, M. (2015). International Liquidity and Exchange Rate Dynamics. QJE.",
                    "Rey, H. (2015). Dilemma not Trilemma: The Global Financial Cycle and Monetary Policy Independence. NBER.",
                    "Miranda-Agrippino, S. & Rey, H. (2020). U.S. Monetary Policy and the Global Financial Cycle. RES.",
                    "Bruno, V. & Shin, H. S. (2015). Cross-Border Banking and Global Liquidity. RES.",
                    "Rodrik, D. (1998). Why Do More Open Economies Have Bigger Governments? JPE.",
                    "Esping-Andersen, G. (1990). The Three Worlds of Welfare Capitalism. Princeton University Press.",
                    "Yay, G. G. & Aksoy, T. (2018). Globalization and the welfare state. Quality & Quantity.",
                    "Agersnap, O., Jensen, A. & Kleven, H. (2020). The Welfare Magnet Hypothesis. AER: Insights."
                ].map(cite => (
                    <div class="bg-slate-900 border border-white/5 p-4 rounded-lg flex items-start gap-3 hover:border-white/20 transition-colors">
                        <i class="fa-solid fa-quote-left text-slate-400 mt-1"></i>
                        <p class="text-sm text-slate-300 font-serif italic">{cite}</p>
                    </div>
                ))}
            </div>
        </section>

        {/* 5. Visual Abstracts (Gallery) */}
        <section class="container mx-auto max-w-6xl px-4 py-16 mb-16">
             <h2 class="text-center text-xs uppercase tracking-[0.2em] font-bold text-slate-400 mb-12">Gallery</h2>
             {/* Figures from the seminar paper. object-contain rather than object-cover:
                 these are white matplotlib plots, and cover would crop the axes off. */}
             <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                 <a href="/en/projects/welfare-state-seminar" class="aspect-square bg-white rounded-2xl overflow-hidden relative group block">
                     <img src="/assets/projects/welfare-state-seminar/fig-kof.png" alt="The KOF globalization indices for 32 OECD countries, 1980–2023. All four indices trend upwards over the period." class="w-full h-full object-contain p-3 opacity-80 group-hover:opacity-100 transition-opacity duration-500" />
                 </a>
                  <a href="/en/projects/welfare-state-seminar" class="aspect-square bg-white rounded-2xl overflow-hidden relative group md:col-span-2 block">
                     <img src="/assets/projects/welfare-state-seminar/fig-rolling.png" alt="Rolling OLS coefficients over 10-year windows with 95% confidence bands, for each of the four globalization indices." class="w-full h-full object-contain p-3 opacity-80 group-hover:opacity-100 transition-opacity duration-500" />
                 </a>
             </div>
        </section>

        {/* 6. Stack Deep Dive (Detailed Toolkit) */}
        <section class="container mx-auto max-w-5xl px-4 py-16 border-t border-white/5">
             <h2 class="text-center text-xs uppercase tracking-[0.2em] font-bold text-slate-400 mb-16">The Stack 2.0</h2>
             <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                 {[
                    { tool: "Stata", packages: ["reghdfe", "ivreg2", "gmm", "estout"], icon: "fa-layer-group", color: "text-blue-400" },
                    { tool: "Python", packages: ["pandas", "numpy", "scipy", "matplotlib"], icon: "fa-brands fa-python", color: "text-yellow-400" },
                    { tool: "LaTeX", packages: ["tikz", "beamer", "biblatex", "pgfplots"], icon: "fa-file-code", color: "text-green-400" },
                    { tool: "DevOps", packages: ["git", "github-actions", "docker", "duckdb"], icon: "fa-terminal", color: "text-slate-400" }
                 ].map(t => (
                     <div class="bg-slate-900/50 border border-white/5 p-6 rounded-xl hover:border-white/10 transition-colors">
                         <div class="flex items-center gap-3 mb-4">
                             <i class={`fa-solid ${t.icon} text-xl ${t.color}`}></i>
                             <h3 class="font-bold text-white">{t.tool}</h3>
                         </div>
                         <div class="flex flex-wrap gap-2">
                             {t.packages.map(p => (
                                 <span class="px-2 py-1 bg-white/5 rounded text-[10px] uppercase tracking-wide text-slate-400 border border-white/5">{p}</span>
                             ))}
                         </div>
                     </div>
                 ))}
             </div>
        </section>

        {/* 7. Open Science & Network */}
        <section class="container mx-auto max-w-4xl px-4 py-16 grid grid-cols-1 md:grid-cols-2 gap-8">
            {/* Open Science */}
            <div class="bg-gradient-to-br from-emerald-900/20 to-slate-900 border border-emerald-500/20 p-8 rounded-2xl relative overflow-hidden group">
                <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-500/10 rounded-full blur-[40px] group-hover:bg-emerald-500/20 transition-colors"></div>
                <h3 class="text-xl font-bold text-emerald-400 mb-4 flex items-center gap-2">
                    <i class="fa-solid fa-lock-open"></i> Open Science Pledge
                </h3>
                <p class="text-slate-400 text-sm leading-relaxed mb-6">

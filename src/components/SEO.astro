---
import { availableAlternates } from '@lib/routes';
import { getEntry } from 'astro:content';
import { ORCID_URI, UCPH_ROR, sameAsProfiles, record as orcidRecord } from '@lib/orcid';
import { GOOGLE_SCHOLAR_PROFILE, ACADEMIA_PROFILE, SSRN_PROFILE } from '@lib/profiles';
import { getLangFromUrl } from '@i18n/utils';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  /**
   * Explicit hreflang targets, for sections whose path differs by language rather
   * than only by prefix — the video routes use /videoer and /serie in Danish
   * against /videos and /series elsewhere, so the prefix rule below would point
   * at URLs that do not exist.
   */
  alternates?: Partial<Record<'da' | 'en' | 'de', string>>;
}


const {
  title,
  description = "Anton Meier Ebsen Jørgensen — Economist & quantitative researcher in macroeconomics, monetary policy and cliometrics.",
  article = false,
  alternates
} = Astro.props;

/**
 * Learned societies, for the Person node's `memberOf`.
 *
 * Read from the English CV because this is one JSON-LD block shared by every page —
 * the graph describes the same person whichever language is being served, and the
 * society names are proper nouns in all three files anyway.
 *
 * `status: 'joining'` is excluded. Nothing else filters these; the day EH.net's
 * status changes to 'member' it appears here with no code change.
 */
const cvForSocieties = await getEntry('cv', 'en');
const societies = (cvForSocieties?.data.organizations ?? [])
  .filter((org: any) => org.url && org.url !== '#' && org.status !== 'joining')
  .map((org: any) => ({ "@type": "Organization", name: org.name, url: org.url }));

const siteTitle = "Anton Meier Ebsen Jørgensen";
const lang = getLangFromUrl(Astro.url);
const ogLocale = { da: 'da_DK', en: 'en_US', de: 'de_DE' }[lang] ?? 'da_DK';
const pageTitle = title.includes(siteTitle) ? title : `${title} | ${siteTitle}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://antonebsen.dk");

// Image Logic: Use provided prop OR fallback to Dynamic OG
let socialImageURL;
if (Astro.props.image) {
  socialImageURL = new URL(Astro.props.image, Astro.url);
} else {
  // Generate Dynamic OG
  const ogTitle = title.replace(` | ${siteTitle}`, ''); // Clean title
  // Route file is src/pages/api/og.png.ts, so the path must carry the .png suffix.
  const ogEndpoint = new URL('/api/og.png', Astro.url);
  ogEndpoint.searchParams.set('title', ogTitle);
  ogEndpoint.searchParams.set('desc', description.slice(0, 80) + (description.length > 80 ? '...' : ''));
  socialImageURL = ogEndpoint;
}

// Breadcrumbs Logic
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": "https://antonebsen.dk"
  },
  ...pathSegments.map((segment, index) => {
    const url = `https://antonebsen.dk/${pathSegments.slice(0, index + 1).join('/')}`;
    // Format name: "ai-project" -> "Ai Project"
    const name = segment.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
    return {
      "@type": "ListItem",
      "position": index + 2,
      "name": name,
      "item": url
    };
  })
];

// hreflang alternates. Danish is served at the root, English and German are
// prefixed (/en, /de).
//
// Two things previously made these wrong. The prefix rule assumed every page
// exists in all three languages, but only a fraction is translated into German,
// so most /de alternates 404'd. And it assumed the rest of the path is identical
// across languages, which is false wherever slugs are translated — hence the
// `alternates` prop, which sections like /videoer pass explicitly.
//
// availableAlternates consults the actual page files, so a language only appears
// once its route exists, and adding one makes the alternate show up by itself.
const SITE = 'https://antonebsen.dk';

const paths = alternates ?? availableAlternates(Astro.url.pathname);

const hreflangs = [
  ...(['da', 'en', 'de'] as const)
    .filter((lang) => paths[lang])
    .map((lang) => ({ lang, href: SITE + paths[lang]! })),
  // x-default goes to Danish when it exists, else whichever version does.
  ...(Object.keys(paths).length
    ? [{ lang: 'x-default', href: SITE + (paths.da ?? paths.en ?? paths.de)! }]
    : [])
];
---

<!-- Global Metadata -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" href="/assets/img/favicon.ico" type="image/x-icon">
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- hreflang alternates for da / en / de -->
{hreflangs.map(h => (
  <link rel="alternate" hreflang={h.lang} href={h.href} />
))}

<!-- Feed autodiscovery: without these the video feeds are unreachable from the site -->
<link rel="alternate" type="application/rss+xml" title="The Wandering Economist — Videos" href="/videos.xml" hreflang="en" />
<link rel="alternate" type="application/rss+xml" title="The Wandering Economist — Videoer" href="/videoer.xml" hreflang="da" />
<link rel="alternate" type="application/rss+xml" title="The Wandering Economist — Videos" href="/de/videos.xml" hreflang="de" />
<link rel="alternate" type="application/rss+xml" title="Anton Meier Ebsen Jørgensen — Blog" href="/blog.xml" hreflang="da" />
<link rel="alternate" type="application/rss+xml" title="Anton Meier Ebsen Jørgensen — Blog" href="/en/blog.xml" hreflang="en" />

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={siteTitle} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />

<!-- Twitter -->
{/* `name`, not `property`: that is the attribute Twitter's parser reads. */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageURL} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org/",
  "@graph": [
    {
      "@type": "Person",
      // The ORCID URI as @id, which is what ORCID itself publishes as the identity
      // of this person (curl -H "Accept: application/ld+json" https://orcid.org/…).
      // ORCID has linked to antonebsen.dk since the record was created; until now
      // nothing here pointed back, so there was no way for a crawler to join the
      // two. This is the half that was missing.
      "@id": ORCID_URI,
      "name": "Anton Meier Ebsen Jørgensen",
      "url": "https://antonebsen.dk",
      "image": socialImageURL,
      "jobTitle": "Economist",
      // @id alone is not read by much. identifier is, so the iD is stated twice
      // on purpose, in the two forms consumers actually look for.
      "identifier": {
        "@type": "PropertyValue",
        "propertyID": "ORCID",
        "value": ORCID_URI
      },
      "description": "Economist and quantitative researcher specializing in macroeconomics, monetary policy and cliometrics.",
      "knowsAbout": [
        "Macroeconomics",
        "Monetary policy",
        "Econometrics",
        "Cliometrics",
        "Economic modeling",
        "Data analysis"
      ],
      // The ROR id is what actually disambiguates the university — "University of
      // Copenhagen" is a string that several institutions could plausibly match,
      // and ORCID's own JSON-LD identifies it exactly this way.
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "University of Copenhagen",
        "identifier": {
          "@type": "PropertyValue",
          "propertyID": "ROR",
          "value": UCPH_ROR
        }
      },
      "affiliation": {
        "@type": "CollegeOrUniversity",
        "name": "University of Copenhagen",
        "department": "Department of Economics",
        "identifier": {
          "@type": "PropertyValue",
          "propertyID": "ROR",
          "value": UCPH_ROR
        }
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Copenhagen",
        "addressCountry": "DK"
      },
      // Derived from the ORCID record rather than hand-kept, so adding a profile
      // there is enough to have it appear here. X is passed in because it is on the
      // site but not on the record; the tracking query string ORCID holds on the
      // ResearchGate link is stripped on the way through.
      //
      // Scholar and Academia are passed in the same way for now. Adding them as
      // researcher URLs on the ORCID record would make them arrive by themselves,
      // and sameAsProfiles de-duplicates, so doing both is safe and this list can
      // shrink later without anything breaking.
      "sameAs": sameAsProfiles(orcidRecord, [
        "https://x.com/antonebsen",
        GOOGLE_SCHOLAR_PROFILE,
        ACADEMIA_PROFILE,
        SSRN_PROFILE,
      ]),
      // A different claim from sameAs, and the reason the learned societies are not
      // in that list: sameAs says two URLs are the same entity, and a society is not
      // Anton. He is a member of it.
      //
      // Filtered on status. EH.net is on the /organizations page as an intention and
      // must not appear here, because a reader can see the word "joining" and a
      // crawler cannot. That split is the whole purpose of the status field.
      ...(societies.length ? { "memberOf": societies } : {})
    },
    {
      "@type": "WebSite",
      "name": "Anton Meier Ebsen Jørgensen",
      "url": "https://antonebsen.dk",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://antonebsen.dk/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbItems
    }
  ]
})} />


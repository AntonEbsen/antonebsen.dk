---
import Layout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import Card from '@components/ui/Card.astro';
import Button from '@components/ui/Button.astro';
import Pill from '@components/ui/Pill.astro';
import SectionTitle from '@components/ui/SectionTitle.astro';
import ContourField from '@components/ui/ContourField.astro';
import FeatureCard from '@components/ui/FeatureCard.astro';
import TechStack from '@components/ui/TechStack.astro';
import YouTubeEmbed from '@components/ui/YouTubeEmbed.astro';
import { Image } from 'astro:assets';
import myImageSrc from '../../assets/img/billede-af-mig.jpg';


import { getEntry, getCollection } from 'astro:content';

interface Props {
  lang: 'da' | 'en' | 'de';
}

const { lang } = Astro.props;
const isDa = lang === 'da';

const portLink = isDa ? '/portfolio' : '/en/portfolio';
const cvLink = isDa ? '/cv' : '/en/cv';
const guestbookLink = isDa ? '/guestbook' : '/en/guestbook';
const contactLink = isDa ? '/contact' : '/en/contact';

const videosLink = isDa ? '/videoer' : '/en/videos';

// Featured video from the YouTube channel — the flagged one, else the newest.
const videoEntries = await getCollection('videos');
const featuredVideo = videoEntries
  .map((v) => v.data)
  .sort((a, b) => {
    if (!!a.featured !== !!b.featured) return a.featured ? -1 : 1;
    return new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime();
  })[0];

const videoStrings = isDa
  ? { eyebrow: 'Fra kanalen', cta: 'Se alle videoer' }
  : { eyebrow: 'From the channel', cta: 'Watch all videos' };

const entry = await getEntry('pages', `${lang}/home`);
if (!entry) throw new Error(`Missing content for ${lang}/home`);
const content: any = entry.data;

let skillsRows = [];
let error = null;

// try {
//   if (supabase) {
//     const { data, error: dbError } = await supabase.from('skills').select('*');
//     if (dbError) throw dbError;
//     skillsRows = data;
//   }
// } catch (e) {
//   console.error("Supabase fetch failed", e);
//   error = e;
// }

if (error || !skillsRows || skillsRows.length === 0) {
    const skillsEntry = await getEntry('skills', lang);
    if (skillsEntry && skillsEntry.data) {
        const fd = skillsEntry.data;
        const prog = (fd.programming || []).map(s => ({ ...s, category: 'programming' }));
        const prof = (fd.professional || []).map(s => ({ ...s, category: 'professional' }));
        skillsRows = [...prog, ...prof];
    } else {
        skillsRows = [];
    }
}

const skillsData = {
  programming: skillsRows?.filter(s => s.category === 'programming') || [],
  professional: skillsRows?.filter(s => s.category === 'professional') || []
};
---

<Layout
  title={content.title}
  description={content.description}
>
  <main class="mx-auto max-w-content px-md py-xl">
    <Section rhythm="loose" class="grid grid-cols-1 md:grid-cols-2 gap-xl items-center animate-on-scroll">
      <div>
        {/* font-extrabold was overriding the display face back to a slab. The
            heading is Fraunces at 700 now, which is where its character is. */}
        {/* display-lg tops out at 76px, which broke the name across three lines
            in a half-width hero column. This step down keeps it to two. */}
        <h1 class="font-serif text-display-sm">
          Anton Meier <span class="text-accent underline decoration-2 underline-offset-[10px] decoration-accent/60">Ebsen</span> Jørgensen
        </h1>
        <p class="eyebrow mt-md mb-sm !text-lead">
          {content.hero.tag}
        </p>
        <p class="text-lead text-dim leading-relaxed max-w-prose">
          {content.hero.text}
        </p>
        <div class="flex flex-col sm:flex-row gap-sm pt-md">
          <Button href={portLink} size="lg">{content.hero.btnPort}</Button>
          <Button href={cvLink} variant="ghost" size="lg">{content.hero.btnCV}</Button>
        </div>

      </div>
      
      <a href={isDa ? '/about' : '/en/about'} class="relative group block">
        {/* Was accent -> purple-500. The palette is terracotta and moss; purple
            was the only place that gradient appeared on the whole site. */}
        <div class="absolute -inset-4 bg-gradient-to-br from-accent/25 to-accent-2/20 rounded-3xl blur-2xl opacity-75 group-hover:opacity-100 transition duration-1000 group-hover:duration-200 animate-[pulseGlow_3s_ease-in-out_infinite]"></div>
        <div class="relative aspect-square overflow-hidden rounded-panel border border-accent/30 shadow-2 group-hover:border-accent/60 transition-all duration-300">
          <Image 
            src={myImageSrc} 
            alt="Anton Meier Ebsen Jørgensen" 
            class="object-cover w-full h-full grayscale hover:grayscale-0 transition-all duration-700 group-hover:scale-105"
            loading="eager"
            width={600}
            height={600}
          />
          {/* Moss, not Tailwind's green-500 — the site already has a green and
              this was not it. Text is --bg rather than white so the pill still
              clears AA against the lighter moss. */}
          <div class="absolute top-4 right-4 px-3 py-1.5 bg-accent-2 backdrop-blur-sm text-[var(--bg)] text-xs font-bold rounded-full shadow-1 flex items-center gap-1.5">
            <span class="w-2 h-2 bg-[var(--bg)] rounded-full animate-pulse"></span>
            {isDa ? 'Tilgaengelig' : 'Available'}
          </div>
        </div>
      </a>
    </Section>

    {/*
      These three tiles were accent / blue-500 / purple-500 — two thirds of the
      first thing a visitor sees was off-palette, which is most of why the page
      did not look like it belonged to its own design system. They are the two
      real accents plus a neutral stone tile now, and the numerals give the row
      an order to read in.
    */}
    <Section class="grid grid-cols-1 md:grid-cols-3 gap-md mb-2xl animate-on-scroll delay-100">
      {[
        { n: '01', icon: 'fa-solid fa-code', tint: 'bg-accent/10 group-hover:bg-accent/20', fg: 'text-accent', c: content.cards.model },
        { n: '02', icon: 'fa-solid fa-graduation-cap', tint: 'bg-accent-2/10 group-hover:bg-accent-2/20', fg: 'text-accent-2', c: content.cards.focus },
        { n: '03', icon: 'fa-solid fa-chalkboard-user', tint: 'bg-text/[0.06] group-hover:bg-text/10', fg: 'text-dim', c: content.cards.teach },
      ].map((card) => (
        <Card variant="glass" elevation={1} class="p-8 group">
          <div class="flex items-center justify-between mb-6">
            <div class:list={['w-12 h-12 rounded-plate flex items-center justify-center transition-colors', card.tint]}>
              <i class:list={[card.icon, card.fg, 'text-xl']}></i>
            </div>
            {/* .deco-numeral, not a text node. axe measures any text a sighted
                user can see, so a 1.3:1 watermark fails contrast even though it
                is pure decoration — the list order already carries the number.
                The existing utility in styles.css puts the glyph in a
                pseudo-element, which is the exempt form. */}
            <span class="deco-numeral font-serif text-title-md tabular" data-numeral={card.n}></span>
          </div>
          <h2 class="text-title-sm mb-3">{card.c.title}</h2>
          <p class="text-dim text-sm leading-relaxed">{card.c.text}</p>
        </Card>
      ))}
    </Section>

    <Section class="animate-on-scroll delay-200">
      <FeatureCard
        badge={content.feature.badge}
        title={content.feature.title}
        description={content.feature.desc}
        tagString={content.feature.tags}
        url={portLink}
      />
    </Section>

    {featuredVideo && (
      <Section class="animate-on-scroll delay-200">
        <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] gap-10 items-center">
          <YouTubeEmbed
            youtubeId={featuredVideo.youtubeId}
            title={(isDa && featuredVideo.title_da) || featuredVideo.title}
            orientation={featuredVideo.orientation}
            class={featuredVideo.orientation === 'portrait' ? 'max-w-[280px] mx-auto md:mx-0' : ''}
          />
          <div>
            <SectionTitle eyebrow={videoStrings.eyebrow}>
              {(isDa && featuredVideo.title_da) || featuredVideo.title}
            </SectionTitle>
            {/* text-dim at opacity-70 composites to about 5.1:1 — right at the
                line. The solid muted token is the contrast-checked way to say
                the same thing. */}
            <p class="text-muted mt-sm mb-lg leading-relaxed">
              {(isDa && featuredVideo.description_da) || featuredVideo.description}
            </p>
            <Button href={videosLink}>{videoStrings.cta}</Button>
          </div>
        </div>
      </Section>
    )}

    <Section class="animate-on-scroll delay-300">
      <div class="text-center max-w-content mx-auto mb-xl">
        {/* Was SectionHeading — an eyebrow component — fought back to title size
            with `text-3xl font-bold`. Whichever of the two font-size classes
            Tailwind happened to emit later won. */}
        <SectionTitle align="center" class="mb-lg">{content.skills.title}</SectionTitle>

        <!-- Live Skills Container -->
        <div id="skills-live-container">
          <!-- Static Fallback Content -->
          <TechStack skills={skillsData.programming} />
          <div class="flex flex-wrap justify-center gap-2 mt-8 opacity-90">
            {skillsData.professional.map(skill => (
              <Pill variant="default" class="text-sm">{skill.name}</Pill>
            ))}
          </div>
        </div>

      </div>
    </Section>

    {/*
      A script here fetched /partials/skills and swapped it into
      #skills-live-container. It was wrapped in an 'astro:page-load' listener,
      which never fires on this site — there is no View Transitions router — so
      it never ran once, and every visitor has always seen the static content
      above. Retired rather than restored: it would add a Supabase-backed
      request to every homepage load to replace markup nobody has missed.

      src/pages/partials/skills.astro now has no caller.
    */}

    <Section rhythm="none" class="relative isolate overflow-hidden text-center py-2xl px-md bg-accent/5 rounded-panel border border-accent/10 animate-on-scroll delay-200">
      <ContourField seed={2.4} anchor="center" />
      <div class="relative z-raised">
        <h2 class="font-serif text-title-lg mb-md">{content.cta.title}</h2>
        <p class="text-lead text-dim mb-xl max-w-prose mx-auto">
          {content.cta.text}
        </p>
        <Button href={contactLink} size="lg">{content.cta.btn}</Button>
      </div>
    </Section>
  </main>
</Layout>

---
import Card from '@components/ui/Card.astro';
import { demographyValidation } from '@data/demography-validation';
import { FIGURE_REPRODUCTION as reproduction } from '@data/demography-reproduction';
interface Props { lang: 'da' | 'en' }
const { lang } = Astro.props;
const isDa = lang === 'da';
const validation = demographyValidation(lang);
---
<Card variant="glass" interactive={false} class="p-6 md:p-8 min-w-0">
  <section id="reproducibility" aria-labelledby="figure-validation-heading" data-figure-validation class="scroll-mt-28">
    <h2 id="figure-validation-heading" class="text-title-sm mb-4">{validation.heading}</h2>
    <p class="text-sm text-muted mb-4">{isDa ? 'Kontrolleret' : 'Checked'} <time datetime={validation.date}>{validation.dateLabel}</time></p>
    <p class="text-dim leading-relaxed">{validation.intro}</p>
    <figure class="my-6">
      <img src={validation.figurePath} width="1423" height="919" loading="lazy" decoding="async"
        alt={isDa ? 'Rekonstrueret histogram over 1871-andelene: 262 amter ved eller under 50% katolsk befolkning og 130 over.' : 'Reconstructed histogram of 1871 shares: 262 counties at or below 50% Catholic and 130 above.'}
        class="w-full h-auto rounded-plate border border-(--glass-border) bg-white" />
      <figcaption class="text-sm text-muted mt-3">{isDa ? 'Rekonstrueret figur 4.1. De katolske befolkningsandele er fra 1871; hvert amt vægter lige meget.' : 'Reconstructed Figure 4.1. Catholic population shares are from 1871; each county receives equal weight.'}</figcaption>
    </figure>
    <table class="w-full text-sm border-collapse">
      <caption class="text-left font-semibold text-text mb-3">{isDa ? 'Genberegnede beskrivende mål' : 'Recomputed descriptive statistics'}</caption>
      <tbody>
        {validation.rows.map(([label, value]) => <tr class="border-b border-(--glass-border)">
          <th scope="row" class="text-left font-normal text-dim py-3 pr-4">{label}</th>
          <td class="text-right tabular-nums text-text py-3 whitespace-nowrap">{value}</td>
        </tr>)}
      </tbody>
    </table>
    <p class="text-dim leading-relaxed mt-6" data-validation-discrepancy>{validation.discrepancy}</p>
    <p class="text-sm text-muted leading-relaxed mt-4" data-validation-scope>{validation.scope}</p>
    <details id="reproduce-figure" class="mt-6 border border-(--glass-border) rounded-plate p-4" data-figure-reproduction>
      <summary class="cursor-pointer font-semibold text-accent">{isDa ? 'Genskab denne figur' : 'Reproduce this figure'}</summary>
      <div class="mt-4 space-y-4 text-sm text-dim leading-relaxed">
        <p>{isDa
          ? 'Den afgrænsede pakke opretter et separat Python 3.12-miljø, installerer 17 fastlåste pakkeversioner og genskaber figur 4.1 fra de registrerede kildefiler. Kommandoen er testet fra en ren lokal checkout på Windows.'
          : 'The narrow package creates an isolated Python 3.12 environment, installs 17 pinned package versions and reconstructs Figure 4.1 from the recorded source files. The command was tested from a clean local checkout on Windows.'}</p>
        <pre class="bg-(--bg) rounded-plate p-4 text-xs whitespace-pre-wrap break-all"><code>{reproduction.commands}</code></pre>
        <p>{isDa
          ? 'På Windows kan du erstatte python med py -3.12. Første kørsel kræver internet til installationen. Kildefilerne skal matche de 29 registrerede SHA-256-værdier; manglende eller ændrede filer giver en fejl. Hver kørsel gemmer nye resultater uden at ændre rådata.'
          : 'On Windows, replace python with py -3.12 if needed. Initial setup needs internet for installation. Source files must match the 29 recorded SHA-256 values; missing or changed inputs fail explicitly. Each run writes fresh outputs without changing raw data.'}</p>
        <p>{isDa
          ? 'Et godkendt resultat betyder match af alle rapportfelter, herunder de 30 histogramintervaller og den dokumenterede tekstafvigelse. Det betyder ikke fuld replikation af opgaven, kausal validering eller et pixel-identisk billede.'
          : 'A verified run matches every report field, including all 30 histogram bins and the documented prose discrepancy. It does not mean full-paper replication, causal validation or a pixel-identical image.'}</p>
        <a href={reproduction.readmeUrl} class="inline-block text-accent underline underline-offset-4">{isDa ? 'Fast version: adgang til data, forventede resultater og fejlkontrol' : 'Fixed version: data access, expected outputs and failure checks'}</a>
      </div>
    </details>
    <div class="flex flex-wrap gap-x-6 gap-y-3 mt-6 text-sm">
      <a href={validation.reportUrl} class="text-accent underline underline-offset-4">{isDa ? 'Metode, kildefiler og udeladelser' : 'Method, source files and exclusions'}</a>
      <a href={validation.codeUrl} class="text-accent underline underline-offset-4">{isDa ? 'Valideringskode' : 'Validation code'}</a>
      <a href={validation.resultsPath} download class="text-accent underline underline-offset-4">{isDa ? 'Download kontrolresultater (JSON)' : 'Download check results (JSON)'}</a>
    </div>
  </section>
</Card>

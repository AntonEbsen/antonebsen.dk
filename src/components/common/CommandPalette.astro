---
import { getLangFromUrl } from '@i18n/utils';
import { getLedgerCopy } from '@i18n/ledger';

const lang = getLangFromUrl(Astro.url);

// Everything the client script renders at runtime lives here too, and is handed over
// as a data attribute below. (Do not write the script tag literally in this comment:
// esbuild's dependency scanner reads it as a real script block and then fails to
// parse the prose that follows, which takes the whole dev server down.)
// The script previously hardcoded Danish for results, the
// AI placeholder and the error text, so /en and /de visitors saw "Ingen resultater"
// and "Spørg Quantum AI" inside an otherwise translated palette.
const t_obj = {
  da: {
    placeholder: "Søg eller spørg AI (Cmd+K)...",
    noResults: "Ingen resultater for",
    quickActions: "Hurtige handlinger",
    results: "Resultater",
    aiMode: "Spørg Quantum AI",
    aiSearching: "AI tænker...",
    keyboardHint: "Pil for at navigere, Enter for at vælge, Esc for at lukke",
    seeAll: "Se alle {n} resultater",
    aiPlaceholder: "Spørg Quantum AI om Anton...",
    aiFooter: "Svaret er genereret af AI baseret på Antons CV og projekter.",
    aiError: "Beklager, AI-tjenesten er midlertidigt utilgængelig.",
    navigate: "Naviger",
    select: "Vælg"
  },
  en: {
    placeholder: "Search or ask AI (Cmd+K)...",
    noResults: "No results for",
    quickActions: "Quick Actions",
    results: "Results",
    aiMode: "Ask Quantum AI",
    aiSearching: "AI reflects...",
    keyboardHint: "Arrows to navigate, Enter to select, Esc to close",
    seeAll: "See all {n} results",
    aiPlaceholder: "Ask Quantum AI about Anton...",
    aiFooter: "Generated by AI from Anton's CV and projects.",
    aiError: "Sorry — the AI service is temporarily unavailable.",
    navigate: "Navigate",
    select: "Select"
  },
  de: {
    placeholder: "Suchen oder KI fragen (Cmd+K)...",
    noResults: "Keine Ergebnisse für",
    quickActions: "Schnellzugriff",
    results: "Ergebnisse",
    aiMode: "Quantum KI fragen",
    aiSearching: "KI überlegt...",
    keyboardHint: "Pfeile zum Navigieren, Enter zum Auswählen, Esc zum Schließen",
    seeAll: "Alle {n} Ergebnisse ansehen",
    aiPlaceholder: "Frag die Quantum KI über Anton...",
    aiFooter: "Von der KI aus Antons Lebenslauf und Projekten erzeugt.",
    aiError: "Der KI-Dienst ist vorübergehend nicht erreichbar.",
    navigate: "Navigieren",
    select: "Auswählen"
  }
};

type Strings = typeof t_obj.da;
const t: Strings = t_obj[lang as keyof typeof t_obj] ?? t_obj.da;

// The URLs were unlocalized, so a German visitor was sent to the Danish /cv.
const prefix = lang === 'da' ? '' : `/${lang}`;

const { ui: ledgerUi } = getLedgerCopy(lang);

// The ledger entry dispatches instead of navigating: /ledger is the real page
// (linked in the nav, the footer and the search index), and the palette is where
// you glance at the book without leaving the page you are on.
const quickActions: { label: string; icon: string; url?: string; event?: string }[] = [
  { label: lang === 'da' ? "Se mit CV" : (lang === 'de' ? "Lebenslauf ansehen" : "View my CV"), url: `${prefix}/cv`, icon: "fa-solid fa-file-pdf" },
  { label: lang === 'da' ? "Projekter" : (lang === 'de' ? "Projekte" : "Projects"), url: `${prefix}/portfolio`, icon: "fa-solid fa-briefcase" },
  { label: lang === 'da' ? "Kontakt mig" : (lang === 'de' ? "Kontaktieren Sie mich" : "Contact me"), url: `${prefix}/contact`, icon: "fa-solid fa-envelope" },
  { label: lang === 'da' ? "Hovedbogen" : (lang === 'de' ? "Das Hauptbuch" : "The Ledger"), event: "toggle-ledger", icon: "fa-solid fa-book" },
  // Sortes Virgilianae: opening a book at random for guidance. Also the only
  // thing on the site that makes 200-odd routes discoverable.
  { label: ledgerUi.sortes, event: "ledger:sortes", icon: "fa-solid fa-dice" }
];
---

<div id="command-palette" class="fixed inset-0 z-[1001] flex items-start justify-center pt-[15vh] px-4 pointer-events-none opacity-0 invisible transition-all duration-200" role="dialog" aria-modal="true" aria-labelledby="palette-input" data-i18n={JSON.stringify(t)}>
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-[#000]/60 backdrop-blur-md palette-backdrop cursor-pointer pointer-events-auto"></div>

  <!-- Palette Container -->
  <div class="relative w-full max-w-[650px] bg-[#1E2122]/90 border border-glass-border rounded-2xl shadow-[0_20px_70px_rgba(0,0,0,0.7)] overflow-hidden transform scale-95 transition-all duration-200 pointer-events-auto flex flex-col max-h-[70vh]">
    <!-- Header/Search Input -->
    <div class="relative flex items-center p-4 border-b border-glass-border">
      <i class="fa-solid fa-magnifying-glass text-accent mr-3 opacity-60"></i>
      <input 
        id="palette-input"
        type="text" 
        class="w-full bg-transparent border-none outline-none text-lg text-white font-medium placeholder:text-muted"
        placeholder={t.placeholder}
        autocomplete="off"
      />
      <div class="flex items-center gap-2">
        <button id="palette-ai-toggle" class="px-3 py-1.5 rounded-lg bg-accent/10 border border-accent/20 text-[10px] font-bold uppercase tracking-widest text-accent hover:bg-accent/20 transition-all flex items-center gap-2" title={t.aiMode}>
          <i class="fa-solid fa-robot"></i>
          <span class="hidden md:inline">Quantum AI</span>
        </button>
        <span class="text-[10px] bg-white/5 border border-white/10 px-2 py-1 rounded text-muted font-mono hidden md:inline">ESC</span>
      </div>
    </div>

    <!-- Scrolling Content -->
    <div id="palette-results" class="flex-1 overflow-y-auto p-2 scrollbar-hide min-h-[100px]">
      <!-- State: Quick Actions (Default) -->
      <div id="palette-default-state">
         <h3 class="px-4 py-2 text-[10px] font-bold uppercase tracking-widest text-muted mb-1">{t.quickActions}</h3>
         <div class="grid grid-cols-2 gap-1 mb-4">
           {quickActions.map(action => {
             const Tag = action.event ? 'button' : 'a';
             return (
               <Tag
                 href={action.url}
                 type={action.event ? 'button' : undefined}
                 data-event={action.event}
                 class="palette-item flex items-center gap-3 p-3 rounded-xl hover:bg-white/5 group transition-all w-full text-left"
               >
                 <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-accent group-hover:bg-accent group-hover:text-bg transition-all">
                   <i class={action.icon}></i>
                 </div>
                 <span class="text-sm font-medium text-dim group-hover:text-white transition-colors">{action.label}</span>
               </Tag>
             );
           })}
         </div>
      </div>

      <!-- State: Results (Injected via JS) -->
      <div id="palette-results-list" class="hidden flex flex-col gap-0.5"></div>

      <!-- State: AI (Injected via JS) -->
      <div id="palette-ai-result" class="hidden p-4 space-y-4">
         <div class="flex items-center gap-3 text-accent animate-pulse text-sm font-mono">
            <i class="fa-solid fa-microchip"></i>
            <span>{t.aiSearching}</span>
         </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="p-4 bg-white/[0.02] border-t border-glass-border flex justify-between items-center">
       <p class="text-[10px] text-muted font-medium">
         <i class="fa-solid fa-keyboard mr-1"></i> {t.keyboardHint}
       </p>
       <div class="flex items-center gap-3">
         <span class="flex items-center gap-1.5 text-[10px] text-muted">
           <kbd class="px-1.5 py-0.5 rounded bg-white/5 border border-white/10 font-mono">↑↓</kbd> {t.navigate}
         </span>
         <span class="flex items-center gap-1.5 text-[10px] text-muted">
            <kbd class="px-1.5 py-0.5 rounded bg-white/5 border border-white/10 font-mono">↵</kbd> {t.select}
          </span>
       </div>
    </div>
  </div>
</div>

<style>
  /* Both the palette and its inner container carry `transition-all duration-200`,
     which sweeps `visibility` into the transition. Discrete properties flip at the
     halfway mark and `visibility` inherits, so for the first 100ms after opening the
     input was still visibility:hidden — and focus() on a hidden element is a silent
     no-op. The dialog opened with focus left on <body>, and Tab walked straight out
     into the page behind it.

     Naming the transitioned properties keeps the fade and the scale while letting
     visibility switch instantly. */
  #command-palette,
  #command-palette > div {
    transition-property: opacity, transform;
  }

  #command-palette.is-open {
    opacity: 1;
    visibility: visible;
  }
  #command-palette.is-open > div:last-child {
    transform: scale(1);
  }

  .palette-item.is-active {
    background-color: rgba(255, 255, 255, 0.08);
  }
  .palette-item.is-active .w-8 {
    background-color: var(--accent);
    color: #000;
  }
  .palette-item.is-active span {
    color: #fff;
  }
</style>

<!-- No lang="ts": any attribute other than src makes Astro emit the script raw,
     which shipped these imports and TS casts straight to the browser. Astro
     compiles TypeScript in <script> by default. -->
<script>
    import { renderModelText } from '../../lib/ai/safe-html';
    import { readEventStream } from '../../lib/ai/protocol';

  import { track } from '@vercel/analytics';
  import { unlockAchievement } from '../../lib/gamification';

  // One shape for a search-index entry, so the render helpers below are checked
  // rather than taking `any`.
  type SearchItem = {
    title: string;
    url: string;
    content?: string;
    type?: string;
    icon?: string;
    tags?: string[];
    lang?: string;
  };

  (() => {
    const paletteEl = document.getElementById('command-palette');
    const inputEl = document.querySelector<HTMLInputElement>('#palette-input');
    if (!paletteEl || !inputEl) return;

    // Re-bound as non-null so the handlers below don't each need a guard: the
    // early return above already proved both exist.
    const palette: HTMLElement = paletteEl;
    const input: HTMLInputElement = inputEl;

    const backdrop = palette.querySelector('.palette-backdrop');
    const resultsList = document.getElementById('palette-results-list');
    const defaultState = document.getElementById('palette-default-state');
    const aiResult = document.getElementById('palette-ai-result');
    const aiToggle = document.getElementById('palette-ai-toggle');

    // Rendered strings come from the server so the palette speaks the page's
    // language; it used to hardcode Danish here.
    type Strings = Record<string, string>;
    let t: Strings = {};
    try {
      t = JSON.parse(palette.dataset.i18n || '{}');
    } catch {
      /* falls through to the ?? defaults at each use site */
    }

    let isOpen = false;
    let isAiMode = false;
    let searchIndex: SearchItem[] = [];
    let activeIndex = -1;

    let lastFocused: HTMLElement | null = null;
    let focusableElements: HTMLElement[] = [];

    // Toggle Palette
    function openPalette() {
      isOpen = true;
      track('Palette_Open');
      lastFocused = document.activeElement as HTMLElement;
      palette.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      palette.setAttribute('aria-hidden', 'false');
      
      unlockAchievement('hacker');

      // focus() is a no-op while the element is still visibility:hidden, and reading
      // offsetHeight forces the style flush that makes `is-open` take effect now.
      // The old code deferred focus by 10ms instead and lost the race every time, so
      // the dialog opened with focus left on <body>.
      void palette.offsetHeight;
      input.focus();
      updateFocusable();

      if (searchIndex.length === 0) loadIndex();
    }

    function closePalette() {
      isOpen = false;
      palette.classList.remove('is-open');
      document.body.style.overflow = '';
      palette.setAttribute('aria-hidden', 'true');
      input.value = '';
      resetState();
      
      if (lastFocused) {
        lastFocused.focus();
        lastFocused = null;
      }
    }

    function resetState(): void {
      defaultState?.classList.remove('hidden');
      resultsList?.classList.add('hidden');
      aiResult?.classList.add('hidden');
      if (resultsList) resultsList.innerHTML = '';
      activeIndex = -1;
      isAiMode = false;
      aiToggle?.classList.remove('bg-accent', 'text-bg');
      aiToggle?.classList.add('bg-accent/10', 'text-accent');
    }

    // Load Index
    async function loadIndex(): Promise<void> {
      try {
        const res = await fetch('/search-index.json');
        searchIndex = (await res.json()) as SearchItem[];

        // The fetch starts when the palette opens, so anyone typing straight after
        // Cmd-K searched an empty index and was told there were no results — and it
        // stayed wrong until they typed another character. Re-run once data lands.
        if (input.value.trim().length >= 2) handleSearch();
      } catch (e) {
        console.error("Failed to load search index", e);
      }
    }

    // Search Logic
    function handleSearch(): void {
      const q = input.value.trim().toLowerCase();

      if (q.length < 2) {
        resetState();
        return;
      }

      if (isAiMode) return; // Handled by Enter

      const currentLang = document.documentElement.lang || 'en';

      const filtered = searchIndex
        .filter((item) => {
          if (item.lang && item.lang !== currentLang) return false;
          const content = `${item.title} ${item.content} ${item.tags?.join(' ')}`.toLowerCase();
          return content.includes(q);
        })
        .slice(0, 10);

      renderResults(filtered, q);
    }

    // `q` is a parameter because the "see all" link below needs it. It used to read
    // a `q` that only existed in handleSearch's scope, so any search returning 8 or
    // more results threw a ReferenceError instead of rendering the link.
    function renderResults(results: SearchItem[], q: string): void {
      if (!resultsList || !defaultState) return;

      defaultState.classList.add('hidden');
      resultsList.classList.remove('hidden');
      aiResult?.classList.add('hidden');

      if (results.length === 0) {
        const label = `${t.noResults ?? 'Ingen resultater for'} “${escapeHtml(q)}”`;
        resultsList.innerHTML = `<div class="p-8 text-center text-muted text-sm">${label}</div>`;
        return;
      }

      resultsList.innerHTML = results.map((r, i) => `
        <a href="${r.url}" class="palette-item flex items-center justify-between p-4 rounded-xl transition-all border border-transparent group ${i === 0 ? 'is-active bg-white/[0.08] border-white/[0.05]' : 'hover:bg-white/[0.04]'}" data-index="${i}">
          <div class="flex items-start gap-4 flex-1 min-w-0">
             <div class="w-10 h-10 rounded-lg flex items-center justify-center text-lg flex-shrink-0 transition-all ${getIconStyle(r)}">
                <i class="${r.icon || getIcon(r.tags)}"></i>
             </div>
             <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-0.5">
                    <span class="text-sm font-bold text-white tracking-tight group-hover:text-accent transition-colors truncate">${r.title}</span>
                    <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-white/5 text-muted border border-white/5">${r.type || 'page'}</span>
                </div>
                <div class="text-xs text-dim/70 leading-relaxed line-clamp-2 pr-4 font-light opacity-80 group-hover:opacity-100 transition-opacity">${r.content}</div>
                <div class="flex flex-wrap gap-1.5 mt-2 opacity-50 group-hover:opacity-100 transition-opacity">
                    ${r.tags?.slice(0,3).map((tag) => `<span class="text-[10px] px-2 py-0.5 rounded-full bg-white/5 text-dim border border-white/5">${tag}</span>`).join('') ?? ''}
                </div>
             </div>
          </div>
          <div class="text-muted opacity-0 group-hover:opacity-100 transition-opacity flex-shrink-0 self-center">
            <i class="fa-solid fa-chevron-right text-xs"></i>
          </div>
        </a>
      `).join('');
      
      if (results.length >= 8) {
          const seeAll = (t.seeAll ?? 'Se alle {n} resultater').replace('{n}', String(results.length));
          resultsList.innerHTML += `
            <a href="/search?q=${encodeURIComponent(q)}" class="block mt-2 mx-1 p-3 text-center rounded-xl bg-white/5 hover:bg-accent/20 border border-white/5 hover:border-accent/30 transition-all group">
                <span class="text-xs font-bold text-dim group-hover:text-accent uppercase tracking-widest">
                    ${seeAll} <i class="fa-solid fa-arrow-right ml-2 group-hover:translate-x-1 transition-transform"></i>
                </span>
            </a>
          `;
      }

      // The first row renders with `is-active` styling, but activeIndex stayed at
      // -1 until an arrow key moved it — so the palette showed a highlighted result
      // that the first Enter press refused to open. Sync the two.
      //
      // Only here, not at the declaration: on the quick-action state nothing is
      // highlighted, and defaulting to 0 there would send a stray Enter to /cv.
      activeIndex = results.length > 0 ? 0 : -1;

      // Results are focusable links, so the trap's list is stale until we re-read it.
      updateFocusable();
    }

    // The result rows are built as an HTML string, so anything derived from the
    // user's query has to be escaped before it goes back into innerHTML.
    function escapeHtml(s: string): string {
      const div = document.createElement('div');
      div.textContent = s;
      return div.innerHTML;
    }

    /*
      Four result types, previously coloured purple / blue / emerald / yellow —
      a full second palette living inside the one piece of UI that opens on top
      of every page. The types still need telling apart, so they are separated
      by the two real accents plus tint depth rather than by hue.
    */
    function getIconStyle(r: SearchItem): string {
      if (r.type === 'command') return 'bg-accent/20 text-accent group-hover:bg-accent/30';
      if (r.type === 'project') return 'bg-accent/10 text-accent-light group-hover:bg-accent/20';
      if (r.type === 'blog') return 'bg-accent-2/10 text-accent-2 group-hover:bg-accent-2/20';
      if (r.type === 'game') return 'bg-accent-2/20 text-accent-2-light group-hover:bg-accent-2/30';
      return 'bg-white/5 text-muted group-hover:bg-white/10 group-hover:text-text';
    }

    function getIcon(tags?: string[]): string {
      if (tags?.includes('blog')) return 'fa-solid fa-newspaper';
      if (tags?.includes('portfolio')) return 'fa-solid fa-code';
      if (tags?.includes('skill')) return 'fa-solid fa-brain';
      return 'fa-solid fa-link';
    }

    function updateFocusable(): void {
      focusableElements = Array.from(
        palette.querySelectorAll<HTMLElement>(
          'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
        )
      ).filter((el) => el.offsetParent !== null);
    }

    // The dialog declares aria-modal="true", which promises focus stays inside it.
    // focusableElements was collected for this and then never read, so Tab walked
    // straight out into the page behind the palette.
    function trapFocus(e: KeyboardEvent): void {
      if (e.key !== 'Tab' || focusableElements.length === 0) return;

      const first = focusableElements[0];
      const last = focusableElements[focusableElements.length - 1];
      const active = document.activeElement;

      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    }

    // Keyboard Navigation
    function handleKeydown(e: KeyboardEvent) {
      if (!isOpen) {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          openPalette();
        }
        return;
      }

      if (e.key === 'Escape') closePalette();
      trapFocus(e);

      // Only the items on screen. This used to collect every `.palette-item` in
      // the palette, and the quick actions stay in the DOM behind a `hidden`
      // class when results are showing — so activeIndex indexed into a mixed
      // list and row 0 of the results was never items[0]. renderResults marks
      // result 0 as active in its HTML, which pointed at a different element
      // than Enter would open.
      const items = palette.querySelectorAll<HTMLElement>(
        '#palette-default-state:not(.hidden) .palette-item, #palette-results-list:not(.hidden) .palette-item'
      );

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = (activeIndex + 1) % items.length;
        updateActiveItem(items);
      }

      if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = (activeIndex - 1 + items.length) % items.length;
        updateActiveItem(items);
      }

      if (e.key === 'Enter') {
        e.preventDefault();
        if (isAiMode) {
          askAi();
        } else {
          // Quick actions that dispatch instead of navigating are <button>s, so
          // .click() reaches the same delegated handler a mouse click does — one
          // path for both, rather than a special case here.
          items[activeIndex]?.click();
        }
      }
    }

    function updateActiveItem(items: NodeListOf<HTMLElement>): void {
      items.forEach((item, i) => {
        if (i === activeIndex) {
          item.classList.add('is-active');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('is-active');
        }
      });
    }

    // AI Mode
    function toggleAi(): void {
      isAiMode = !isAiMode;
      aiToggle?.setAttribute('aria-pressed', String(isAiMode));
      if (isAiMode) {
        aiToggle?.classList.add('bg-accent', 'text-bg');
        aiToggle?.classList.remove('bg-accent/10', 'text-accent');
        input.placeholder = t.aiPlaceholder ?? 'Spørg Quantum AI om Anton...';
      } else {
        aiToggle?.classList.remove('bg-accent', 'text-bg');
        aiToggle?.classList.add('bg-accent/10', 'text-accent');
        input.placeholder = t.placeholder ?? 'Søg eller spørg AI (Cmd+K)...';
      }
    }

    async function askAi(): Promise<void> {
      const q = input.value.trim();
      if (!q || !aiResult || !resultsList || !defaultState) return;

      defaultState.classList.add('hidden');
      resultsList.classList.add('hidden');
      aiResult.classList.remove('hidden');

      aiResult.innerHTML = `
        <div class="flex flex-col gap-4">
          <div class="flex items-center gap-3 text-accent animate-pulse text-sm font-mono">
             <i class="fa-solid fa-microchip"></i>
             <span>${t.aiSearching ?? 'AI tænker...'}</span>
          </div>
          <div id="palette-ai-text" class="chat-prose chat-prose--compact p-4 bg-accent/5 border-l-2 border-accent rounded-r-lg min-h-[60px]"></div>
        </div>
      `;

      const textContainer = document.getElementById('palette-ai-text');

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            messages: [{ role: 'user', content: q }],
            lang: document.documentElement.lang,
            // Declaring the surface is what makes the comment below true rather
            // than a workaround: the server offers this caller no client-rendered
            // tools, so there is nothing to drop and nothing the model is told it
            // showed. citeSources still works — the server resolves that one.
            surface: 'prose',
          })
        });

        if (!res.ok) throw new Error("AI Fetch failed");

        let accumulatedText = "";

        // The palette shows a compact preview, so it consumes only the prose events
        // from the stream — charts, navigation and citations belong to the full chat.
        await readEventStream(res, (event) => {
          if (event.type === 'text') {
            accumulatedText += event.text;
            if (textContainer) {
              textContainer.innerHTML = renderModelText(accumulatedText, { lineBreak: '<br>', citations: 'strip' });
            }
          } else if (event.type === 'error') {
            accumulatedText = event.message;
            if (textContainer) textContainer.textContent = event.message;
          }
        });

        if (textContainer) {
           const footer = document.createElement('div');
           footer.className = "text-[10px] text-muted italic mt-2";
           footer.innerText = t.aiFooter ?? 'Svaret er genereret af AI baseret på Antons CV og projekter.';
           textContainer.appendChild(footer);
        }

      } catch (e) {
        if (textContainer) {
          textContainer.textContent = '';
          const err = document.createElement('div');
          err.className = 'text-red-400';
          err.textContent = t.aiError ?? 'Beklager, AI-tjenesten er midlertidigt utilgængelig.';
          textContainer.appendChild(err);
        }
      }
    }

    // Listeners
    window.addEventListener('keydown', handleKeydown);
    backdrop?.addEventListener('click', closePalette);
    input.addEventListener('input', handleSearch);
    aiToggle?.addEventListener('click', toggleAi);

    // Quick actions that open something in place rather than navigating.
    // Delegated so it also catches the synthetic .click() from the Enter key.
    palette.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('.palette-item[data-event]');
      if (!el) return;
      window.dispatchEvent(new CustomEvent(el.dataset.event!));
      closePalette();
    });

    /**
     * Sortes — open the book at random.
     *
     * Uses the search index the palette already fetches, filtered to same-origin
     * pages in the visitor's own language, so nobody gets thrown into a language
     * they weren't reading. Excludes wherever they already are, or a shrug is a
     * plausible outcome.
     */
    window.addEventListener('ledger:sortes', async () => {
      if (searchIndex.length === 0) await loadIndex();

      const here = location.pathname.replace(/\/+$/, '') || '/';
      const candidates = searchIndex
        .map((item) => item.url)
        .filter((url) => typeof url === 'string' && url.startsWith('/'))
        .map((url) => url.replace(/\/+$/, '') || '/')
        .filter((url) => url !== here)
        .filter((url) => {
          const itemLang = url.startsWith('/en') ? 'en' : url.startsWith('/de') ? 'de' : 'da';
          return itemLang === (document.documentElement.lang || 'da');
        });

      if (candidates.length === 0) return;

      unlockAchievement('sortes');
      location.href = candidates[Math.floor(Math.random() * candidates.length)];
    });

  })();
</script>

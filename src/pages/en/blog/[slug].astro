---
import Layout from '../../../layouts/BaseLayout.astro';

import ViewCounter from '../../../components/blog/ViewCounter.tsx';
import ReadingProgress from '../../../components/blog/ReadingProgress.tsx';
import ReadTimer from '../../../components/blog/ReadTimer.astro';
import Manicule from '../../../components/blog/Manicule.astro';
import ReadingRecord from '../../../components/blog/ReadingRecord.astro';
import CitationBox from '../../../components/blog/CitationBox.tsx';
import TaylorRuleChart from '../../../components/blog/charts/TaylorRuleChart.tsx';
import RelatedGraph from '../../../components/blog/RelatedGraph.tsx';
import 'katex/dist/katex.min.css';
import ProjectSidebar from '../../../components/blog/ProjectSidebar.astro';
import ArticleReactions from '../../../components/blog/ArticleReactions.tsx';
import AskAboutPost from '../../../components/blog/AskAboutPost.astro';
import SignalBrief from '../../../components/blog/SignalBrief.astro';
import SmartSuggestions from '../../../components/blog/SmartSuggestions.astro';
import SmartFootnote from '../../../components/blog/SmartFootnote.tsx';
import { renderMarkdown } from '../../../utils/markdown';
import { getCollection } from 'astro:content';

export const prerender = false; 
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');

const posts = await getCollection('blog');
const post = posts.find(p => p.id === slug);

if (!post) return Astro.redirect('/404');

const lang = 'en';
const { title, description, meta, category, content, relatedProjectId } = post.data;

// Generate reading time (rough estimate: 200 words/min)
const words = content && Array.isArray(content) ? content.join(' ').split(' ').length : 0;
const readTime = Math.ceil(words / 200);

// Detect if this specific chart is needed (simple shortcode replacement for now)
const showTaylorChart = slug === 'ai-monetary-policy';

// Counted rather than read off seriesOrder, so a wrong order field cannot make
// a series impossible to finish. See ReadingRecord.astro.
const seriesTotal = post.data.series
    ? posts.filter(p => p.data.series === post.data.series).length
    : 0;
---

<Layout title={title} description={description} article={true}>
  <ReadingProgress client:load />
  <ReadingRecord slug={slug} lang={lang} series={post.data.series} seriesTotal={seriesTotal} />
  <ReadTimer />
  <Manicule />

  <main class="max-w-wide mx-auto px-md py-2xl relative">
    <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_280px] gap-2xl items-start justify-center">
        <div class="w-full max-w-prose mx-auto xl:mx-0">
            {/* Left-aligned throughout. Centred headers on a left-aligned essay
                make the eye restart in a different place at the first paragraph. */}
            <header class="mb-xl">
                <div class="flex flex-wrap items-center gap-xs text-meta text-muted mb-md tabular">
                    <span class="eyebrow !text-[10px] px-2 py-0.5 rounded-full border border-rule-accent">
                        {category}
                    </span>
                    <span aria-hidden="true">·</span>
                    <span>{meta}</span>
                    <span aria-hidden="true">·</span>
                    <span>{readTime} min read</span>
                    <span aria-hidden="true">·</span>
                    <ViewCounter client:load slug={slug} />
                </div>

                <h1 class="font-serif text-display-sm mb-md">{title}</h1>
                <p class="text-lead text-dim leading-relaxed">{description}</p>
            </header>

            {/* The Signal Brief */}
            <SignalBrief 
                brief={post.data.brief} 
                audioUrl={post.data.audioUrl}
                lang="en" 
            />

            {/*
                Was `prose prose-invert prose-lg prose-headings:… prose-p:…`.
                @tailwindcss/typography is not in package.json, so every one of
                those classes emitted nothing and the article body has always
                rendered unstyled. .prose-archive in styles.css is the real thing.
            */}
            <article class="prose-archive">
                {/* Render content array as paragraphs if it exists */}
                {content && Array.isArray(content) ? (
                    content.map((paragraph: string, index: number) => {
                        // Feature 2: Interactive Charts Injection
                        if (showTaylorChart && index === 1) {
                            return (
                                <>
                                    <div set:html={renderMarkdown(paragraph)} />
                                    <TaylorRuleChart client:visible />
                                </>
                            )
                        }
                        return <div set:html={renderMarkdown(paragraph)} />;
                    })
                ) : (
                    <div class="p-4 border border-yellow-500/20 bg-yellow-500/5 rounded text-yellow-200">
                        <p>This post does not have content formatted for this view.</p>
                    </div>
                )}

                {/*
                    Only rendered when the post actually has notes. See the
                    Danish route for why: this block used to print two invented
                    citations on every post that had none.
                */}
                {post.data.footnotes && post.data.footnotes.length > 0 && (
                    <div class="mt-2xl pt-md border-t border-rule text-meta text-muted">
                        <h2 class="eyebrow mb-sm">Notes</h2>
                        <ol class="list-decimal pl-4 space-y-2">
                            {post.data.footnotes.map((fn: any) => (
                                <li id={`fn-${fn.id}`}>
                                    <span set:html={fn.content} /> <a href={`#ref-${fn.id}`} class="text-accent underline underline-offset-2">↩</a>
                                </li>
                            ))}
                        </ol>
                    </div>
                )}
            </article>

            {/* Article Reactions */}
            <AskAboutPost title={title} lang="en" />

            <ArticleReactions client:visible slug={slug} lang="en" />

            {/* Citation System */}
            <div class="mt-16">
                <CitationBox 
                    client:visible 
                    title={title} 
                    author="Anton Meier Ebsen Jørgensen" 
                    url={`https://antonebsen.dk/en/blog/${slug}`} 
                    date={new Date().toISOString()}
                />
            </div>

            {/* Related Content Graph (The Laboratory) */}
            <div class="my-12">
                <h2 class="eyebrow mb-sm">Related Knowledge</h2>
                <RelatedGraph client:visible currentSlug={slug} />
            </div>

            {/* Smart Suggestions */}
            <SmartSuggestions 
                currentSlug={slug} 
                lang="en" 
                tags={post.data.tag} 
                category={post.data.category}
                series={post.data.series}
                seriesOrder={post.data.seriesOrder}
            />

            <div class="mt-8 pt-8 border-t border-white/10 flex justify-between items-center">
                <a href="/en/blog" class="text-dim hover:text-white transition-colors flex items-center gap-2">
                    <i class="fa-solid fa-arrow-left"></i> Back to Blog
                </a>
            </div>
        </div>

        {/* Sidebar */}
        <aside class="hidden xl:block">
            {relatedProjectId && <ProjectSidebar projectId={relatedProjectId} lang={lang || 'en'} />}
        </aside>
    </div>

    {/* Smart Footnotes (Logic Only) */}
    <SmartFootnote client:load />

  </main>
</Layout>

  { name: "Socialdemokratisk", countries: "DNK · FIN · ISL · NOR · SWE", n: 5, dot: "bg-emerald-500" },
  { name: "Konservativ", countries: "AUT · BEL · CHE · DEU · FRA · LUX · NLD", n: 7, dot: "bg-amber-500" },
  { name: "Liberal", countries: "AUS · CAN · GBR · IRL · JPN · NZL · USA", n: 7, dot: "bg-blue-500" },
  { name: "Middelhav", countries: "ESP · GRC · ITA · PRT", n: 4, dot: "bg-pink-500" },
  { name: "Postkommunistisk", countries: "BGR · CZE · EST · HUN · LTU · LVA · POL · SVK · SVN", n: 9, dot: "bg-lime-500" }

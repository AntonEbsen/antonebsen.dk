---
import { ACHIEVEMENTS } from '@lib/gamification';

/**
 * Trophy room modal.
 *
 * Plain Astro rather than a React island. ACHIEVEMENTS is a static export, so the
 * whole grid renders server-side as HTML and the client script only toggles the
 * modal and applies unlocked state from localStorage.
 *
 * The React version had two defects this avoids:
 *  - it called useEffect after an early `return null`, so the hook count changed
 *    on open and React threw "Rendered more hooks than during the previous render"
 *  - it listened for 'achievement-unlocked' / 'xp-gain' while gamification.ts
 *    dispatches 'achievement_unlock' / 'xp_gain', so it never live-updated.
 *    The event names now come from the shared constants.
 */
---

<div id="trophy-room" class="fixed inset-0 z-[2000] hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="trophy-room-title">
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-black/80 backdrop-blur-sm transition-opacity" data-trophy-close></div>

  <!-- Modal -->
  <div class="relative w-full max-w-4xl bg-[#1E2122] border border-gold-500/20 rounded-2xl shadow-[0_0_50px_rgba(212,121,79,0.1)] overflow-hidden flex flex-col max-h-[85vh] animate-fade-in-up">

    <div class="p-6 border-b border-white/5 bg-gradient-to-r from-gold-500/10 to-transparent flex justify-between items-start">
      <div>
        <h2 id="trophy-room-title" class="text-2xl font-bold text-white mb-1 flex items-center gap-3">
          <i class="fa-solid fa-trophy text-gold-500"></i>
          Trophy Room
        </h2>
        <p class="text-sm text-dim">
          Level <span data-trophy-level>1</span> • <span data-trophy-xp>0</span> XP
        </p>
      </div>
      <button
        type="button"
        data-trophy-close
        aria-label="Close trophy room"
        class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-dim hover:bg-white/10 hover:text-white transition-colors"
      >
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Progress toward the next level -->
    <div class="h-1 bg-white/5 w-full">
      <div class="h-full bg-gold-500 shadow-[0_0_10px_rgba(212,121,79,0.5)] transition-all duration-1000" style="width: 0%" data-trophy-progress></div>
    </div>

    <div class="flex-1 overflow-y-auto p-6 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 scrollbar-thin scrollbar-thumb-white/10">
      {ACHIEVEMENTS.map((achievement) => (
        <div
          data-achievement={achievement.id}
          data-locked-text="Locked..."
          data-description={achievement.description}
          class="achievement-card relative p-4 rounded-xl border transition-all duration-300 group bg-white/[0.02] border-white/[0.05] opacity-60 grayscale hover:opacity-100 hover:grayscale-0"
        >
          <div class="flex items-start gap-4">
            <div class="achievement-icon w-12 h-12 shrink-0 rounded-lg flex items-center justify-center text-xl shadow-inner bg-white/5 text-white/20">
              <i class={achievement.icon}></i>
            </div>
            <div>
              <h3 class="achievement-title font-bold text-sm mb-1 text-white/50">{achievement.title}</h3>
              <p class="achievement-description text-xs text-dim leading-relaxed">Locked...</p>
              <div class="mt-2 text-[10px] font-mono opacity-50">{achievement.xp} XP</div>
            </div>
          </div>

          <div class="achievement-lock absolute top-2 right-2 text-white/10 text-xs">
            <i class="fa-solid fa-lock"></i>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  import { GAME_EVENTS, getGameState } from '@lib/gamification';

  const root = document.getElementById('trophy-room');

  if (root) {
    const levelEl = root.querySelector('[data-trophy-level]') as HTMLElement;
    const xpEl = root.querySelector('[data-trophy-xp]') as HTMLElement;
    const progressEl = root.querySelector('[data-trophy-progress]') as HTMLElement;
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.achievement-card'));

    const LOCKED_CARD = ['bg-white/[0.02]', 'border-white/[0.05]', 'opacity-60', 'grayscale', 'hover:opacity-100', 'hover:grayscale-0'];
    const UNLOCKED_CARD = ['bg-gold-500/5', 'border-gold-500/30', 'shadow-[0_0_15px_rgba(212,121,79,0.05)]'];

    function render() {
      const state = getGameState();

      levelEl.textContent = String(state.level);
      xpEl.textContent = String(state.xp);
      progressEl.style.width = `${((state.xp % 1000) / 1000) * 100}%`;

      for (const card of cards) {
        const unlocked = state.unlockedAchievements.includes(card.dataset.achievement!);

        card.classList.toggle('is-unlocked', unlocked);
        card.classList.remove(...(unlocked ? LOCKED_CARD : UNLOCKED_CARD));
        card.classList.add(...(unlocked ? UNLOCKED_CARD : LOCKED_CARD));

        const icon = card.querySelector('.achievement-icon')!;
        icon.classList.toggle('bg-gradient-to-br', unlocked);
        icon.classList.toggle('from-gold-500', unlocked);
        icon.classList.toggle('to-amber-700', unlocked);
        icon.classList.toggle('text-white', unlocked);
        icon.classList.toggle('bg-white/5', !unlocked);
        icon.classList.toggle('text-white/20', !unlocked);

        const title = card.querySelector('.achievement-title')!;
        title.classList.toggle('text-white', unlocked);
        title.classList.toggle('text-white/50', !unlocked);

        card.querySelector('.achievement-description')!.textContent = unlocked
          ? card.dataset.description!
          : card.dataset.lockedText!;

        (card.querySelector('.achievement-lock') as HTMLElement).style.display = unlocked ? 'none' : '';
      }
    }

    const isOpen = () => !root.classList.contains('hidden');

    function open() {
      render();
      root!.classList.remove('hidden');
      root!.classList.add('flex');
    }

    function close() {
      root!.classList.add('hidden');
      root!.classList.remove('flex');
    }

    window.addEventListener('toggle-trophy-room', () => (isOpen() ? close() : open()));

    root.querySelectorAll('[data-trophy-close]').forEach((el) => el.addEventListener('click', close));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) close();
    });

    // Live updates while the modal is open. The React version listened for the
    // wrong event names, so this never worked.
    window.addEventListener(GAME_EVENTS.UNLOCK, () => { if (isOpen()) render(); });
    window.addEventListener(GAME_EVENTS.XP_GAIN, () => { if (isOpen()) render(); });
  }
</script>

<style>
  /* animate-fade-in-up was referenced but never defined globally. */
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(1rem); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.3s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in-up { animation: none; }
  }
</style>

---
import BaseLayout from '@layouts/BaseLayout.astro';
import { verifySession } from '@lib/session';

// Server-side gate, the same signed session the dashboard and the write routes use.
// This page used to open on a client-side check: the access code was the literal
// '42' in the script below, and "granted" in localStorage kept it open — which hid
// the panel from nobody who read the source. Without a session there is nothing
// to render; the dashboard shows the login form.
if (!verifySession(Astro.cookies.get('auth_token')?.value)) {
    return Astro.redirect('/dashboard');
}
---

<BaseLayout title="Command Center" description="Restricted Access">
    <main class="min-h-screen bg-sunken text-text pt-24 pb-24 font-mono">
        <div class="max-w-6xl mx-auto px-4" id="admin-panel">
            <div class="flex justify-between items-end mb-8">
                <div>
                    <h1 class="text-3xl font-bold mb-2">Command Center <span class="text-green-500 animate-pulse">●</span></h1>
                    <p class="text-muted">Live Neural Feed</p>
                </div>
                <button id="refresh-btn" class="text-xs bg-card hover:bg-rule-strong px-3 py-2 rounded transition-colors">
                    REFRESH FEED
                </button>
            </div>

            {/* Metrics */}
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-12">
                <div class="bg-bg/50 border border-card p-6 rounded-xl">
                    <div class="text-muted text-xs uppercase tracking-wider mb-1">Total Interactions</div>
                    <div class="text-2xl font-bold text-white" id="total-count">-</div>
                </div>
                <div class="bg-bg/50 border border-card p-6 rounded-xl">
                    <div class="text-muted text-xs uppercase tracking-wider mb-1">Active Projects</div>
                    <div class="text-2xl font-bold text-blue-400" id="active-projects">-</div>
                </div>
                 <div class="bg-bg/50 border border-card p-6 rounded-xl">
                    <div class="text-muted text-xs uppercase tracking-wider mb-1">Critique Mode</div>
                    <div class="text-2xl font-bold text-red-400" id="critique-count">-</div>
                </div>
                <div class="bg-bg/50 border border-card p-6 rounded-xl">
                    <div class="text-muted text-xs uppercase tracking-wider mb-1">Recruiter Interest</div>
                    <div class="text-2xl font-bold text-purple-400" id="recruiter-count">-</div>
                </div>
            </div>

            {/* Logs Table */}
            <div class="bg-bg border border-card rounded-xl overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-sunken text-muted uppercase text-xs">
                            <tr>
                                <th class="px-6 py-4 font-normal">Time</th>
                                <th class="px-6 py-4 font-normal">Project</th>
                                <th class="px-6 py-4 font-normal">Mode</th>
                                <th class="px-6 py-4 font-normal">User Query</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-card text-dim" id="logs-body">
                            {/* Injected via JS */}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <script>
        import { createClient } from '@supabase/supabase-js';

        // Initialize Client (using same env vars as public)
        const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
        const supabaseKey = import.meta.env.PUBLIC_SUPABASE_KEY;
        const supabase = createClient(supabaseUrl, supabaseKey);

        const refreshBtn = document.getElementById('refresh-btn') as HTMLElement;

        async function fetchLogs() {
            const { data } = await supabase
                .from('chat_logs')
                .select('*')
                .order('timestamp', { ascending: false })
                .limit(50);

            if (data) {
                renderLogs(data);
                calcMetrics(data);
            }
        }

        function calcMetrics(data: any[]) {
            const totalCount = document.getElementById('total-count');
            if(totalCount) totalCount.innerText = data.length.toString();

            const uniqueProjects = new Set(data.map((d: any) => d.project)).size;
            const activeProjects = document.getElementById('active-projects');
            if(activeProjects) activeProjects.innerText = uniqueProjects.toString();
            
            const critiques = data.filter((d: any) => d.bot_mode === 'Critique').length;
            const critiqueCount = document.getElementById('critique-count');
            if(critiqueCount) critiqueCount.innerText = critiques.toString();

            const recruiters = data.filter((d: any) => d.user_message.toLowerCase().includes('job') || d.user_message.toLowerCase().includes('hire')).length;
            const recruiterCount = document.getElementById('recruiter-count');
            if(recruiterCount) recruiterCount.innerText = recruiters.toString();
        }

        function renderLogs(logs: any[]) {
            const tbody = document.getElementById('logs-body');
            if(!tbody) return;
            tbody.innerHTML = logs.map(log => `
                <tr class="hover:bg-card/50 transition-colors">
                    <td class="px-6 py-4 text-muted font-mono text-xs whitespace-nowrap">${new Date(log.timestamp).toLocaleString()}</td>
                    <td class="px-6 py-4 text-blue-400">${log.project}</td>
                    <td class="px-6 py-4">
                        <span class="px-2 py-1 rounded-full text-xs ${
                            log.bot_mode === 'Critique' ? 'bg-red-500/10 text-red-400 border border-red-500/20' : 
                            log.bot_mode === 'ELI5' ? 'bg-green-500/10 text-green-400 border border-green-500/20' : 
                            'bg-card text-muted'
                        }">${log.bot_mode}</span>
                    </td>
                    <td class="px-6 py-4 max-w-md truncate" title="${log.user_message}">${log.user_message}</td>
                </tr>
            `).join('');
        }

        refreshBtn.addEventListener('click', fetchLogs);
        fetchLogs();

    </script>
</BaseLayout>

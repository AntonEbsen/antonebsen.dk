    title: "Baseline- og interaktionsspecifikation (lign. 4.1–4.2)",
    code: `import pandas as pd
from linearmodels.panel import PanelOLS

KOF = ["KOFGI", "KOFEcGI", "KOFSoGI", "KOFPoGI"]
CONTROLS = ["ln_gdppc", "inflation", "deficit", "debt", "ln_pop", "dep_ratio"]
REGIMES = ["conservative", "mediterranean", "liberal", "post_communist"]

panel = df.set_index(["country", "year"])

# Alle regressorer indgår lagget ét år.
lagged = lambda cols: [f"{c}_lag1" for c in cols]

# --- Ligning 4.1: baseline, ét indeks ad gangen -------------------------
for index in KOF:
    spec = " + ".join(lagged([index]) + lagged(CONTROLS))
    fit = PanelOLS.from_formula(
        f"sstran ~ 1 + {spec} + EntityEffects + TimeEffects", panel
    ).fit(cov_type="clustered", cluster_entity=True)

# --- Ligning 4.2: velfærdsregime-heterogenitet --------------------------
# Socialdemokratisk regime er reference, så beta1 er dets egeneffekt og
# hvert interaktionsled er forskellen i forhold til det.
for index in KOF:
    interactions = [f"{index}_lag1:{r}" for r in REGIMES]
    spec = " + ".join(lagged([index]) + interactions + lagged(CONTROLS))
    fit = PanelOLS.from_formula(
        f"sstran ~ 1 + {spec} + EntityEffects + TimeEffects", panel
    ).fit(cov_type="clustered", cluster_entity=True)

    # Marginal effekt pr. regime: beta1 for referencen, beta1 + beta_r ellers.
    for regime in REGIMES:
        margin = fit.params[f"{index}_lag1"] + fit.params[f"{index}_lag1:{regime}"]

# --- Parameterstabilitet: rullende 10-års vinduer -----------------------
# Hvert punkt i figur 5.1 er en selvstændig estimation af ligning 4.1.
for end in range(1989, 2024):
    window = panel.loc[panel.index.get_level_values("year").isin(
        range(end - 9, end + 1)
    )]
    spec = " + ".join(lagged(["KOFGI"]) + lagged(CONTROLS))
    PanelOLS.from_formula(
        f"sstran ~ 1 + {spec} + EntityEffects + TimeEffects", window
    ).fit(cov_type="clustered", cluster_entity=True)`

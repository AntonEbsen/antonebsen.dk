---
/**
 * Achievement toast.
 *
 * Plain Astro rather than a React island: this renders nothing until an event
 * fires, so mounting React on every page to wait for it was pure overhead.
 * Behaviour matches the previous component — a queue, one toast at a time,
 * auto-dismissed after 4 seconds.
 */
---

<div
  id="achievement-toast"
  class="fixed top-24 right-4 z-[100] hidden"
  role="status"
  aria-live="polite"
>
  <div class="toast-card bg-neutral-900/90 border border-yellow-500/50 text-white p-4 rounded-xl shadow-2xl backdrop-blur-md flex items-center gap-4 max-w-sm pointer-events-none select-none overflow-hidden relative">

    <!-- Shine sweep -->
    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-yellow-500/10 to-transparent animate-shine"></div>

    <div class="w-12 h-12 shrink-0 rounded-full bg-gradient-to-br from-yellow-400 to-orange-600 flex items-center justify-center text-xl shadow-lg border-2 border-yellow-200">
      <i data-toast-icon></i>
    </div>

    <div>
      <p class="text-yellow-400 text-xs font-bold uppercase tracking-widest mb-0.5">Achievement Unlocked</p>
      <h4 class="font-bold text-lg leading-tight" data-toast-title></h4>
      <p class="text-neutral-400 text-xs mt-1" data-toast-description></p>
    </div>

    <div class="absolute top-2 right-2 flex items-center gap-1 bg-neutral-800 px-1.5 py-0.5 rounded text-[10px] font-mono text-yellow-500 border border-yellow-500/20">
      <span data-toast-xp></span>
    </div>
  </div>
</div>

<script>
  import { GAME_EVENTS, type Achievement } from '@lib/gamification';

  const root = document.getElementById('achievement-toast');
  if (root) {
    const iconEl = root.querySelector('[data-toast-icon]') as HTMLElement;
    const titleEl = root.querySelector('[data-toast-title]') as HTMLElement;
    const descEl = root.querySelector('[data-toast-description]') as HTMLElement;
    const xpEl = root.querySelector('[data-toast-xp]') as HTMLElement;
    const card = root.querySelector('.toast-card') as HTMLElement;

    const queue: Achievement[] = [];
    let showing = false;

    const HOLD_MS = 4000;

    function next() {
      const achievement = queue.shift();
      if (!achievement) {
        showing = false;
        return;
      }

      showing = true;

      iconEl.className = achievement.icon;
      titleEl.textContent = achievement.title;
      descEl.textContent = achievement.description;
      xpEl.textContent = `+${achievement.xp} XP`;

      root!.classList.remove('hidden');
      // Restart the slide-in each time rather than only on first show.
      card.classList.remove('animate-slide-in-right');
      void card.offsetWidth;
      card.classList.add('animate-slide-in-right');

      setTimeout(() => {
        root!.classList.add('hidden');
        // Let the next one animate in cleanly.
        setTimeout(next, 200);
      }, HOLD_MS);
    }

    window.addEventListener(GAME_EVENTS.UNLOCK, (event) => {
      const achievement = (event as CustomEvent).detail as Achievement;
      if (!achievement?.title) return;

      queue.push(achievement);
      if (!showing) next();
    });
  }
</script>

<style>
  /* These animations were referenced by the old component but defined nowhere,
     so the toast previously appeared with no motion at all. */
  @keyframes slide-in-right {
    from { opacity: 0; transform: translateX(2rem); }
    to   { opacity: 1; transform: translateX(0); }
  }

  @keyframes shine {
    from { transform: translateX(-100%); }
    to   { transform: translateX(100%); }
  }

  .animate-slide-in-right {
    animation: slide-in-right 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .animate-shine {
    animation: shine 2.2s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-slide-in-right,
    .animate-shine {
      animation: none;
    }
  }
</style>

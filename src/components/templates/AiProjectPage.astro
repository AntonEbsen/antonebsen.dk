const content = t[lang];

/**
 * The last golden-set result, written by .github/workflows/eval.yml and committed back.
 *
 * Globbed rather than imported so the page still builds before the first run has
 * produced a file — an absent status is a missing section, not a broken build.
 *
 * The scope matters and is shown. Six nights a week the workflow runs a three-case
 * smoke subset; only Sunday runs the whole set. Printing "3/3" with no context would
 * read as a far weaker claim than the weekly run, so a smoke result says what it is a
 * sample of instead of pretending to be the full sweep.
 */
interface EvalStatus {
    passed: number;
    total: number;
    scope: 'full' | 'smoke';
    suiteTotal: number;
    model: string;
    modelLabel: string;
    checkedAt: string;
}

const statusFiles = import.meta.glob<EvalStatus>('../../data/ai-eval-status.json', {
    eager: true,
    import: 'default',
});
const evalStatus = Object.values(statusFiles)[0] ?? null;

const evalCopy = {
    da: {
        full: (s: EvalStatus) => `${s.passed}/${s.total} kontrolspørgsmål bestået`,
        smoke: (s: EvalStatus) => `${s.passed}/${s.total} stikprøver bestået, ud af ${s.suiteTotal}`,
        checked: 'kontrolleret',
        failing: 'Nogle kontroller fejler lige nu.',
        label: 'Automatisk kontrol',
    },
    en: {
        full: (s: EvalStatus) => `${s.passed}/${s.total} golden questions passing`,
        smoke: (s: EvalStatus) => `${s.passed}/${s.total} spot checks passing, out of ${s.suiteTotal}`,
        checked: 'checked',
        failing: 'Some checks are failing right now.',
        label: 'Automated check',
    },
}[lang];

const evalPassing = evalStatus ? evalStatus.passed === evalStatus.total : false;
// Was '/chat' | '/en/chat'. Neither route exists — the ChatPage template they were
// written for is not imported by any page — so this CTA 404'd in both languages.
// /ai-chat is the real full-page assistant and picks its own language from the URL.
const chatLink = '/ai-chat';
---

<Layout title={content.title} description={content.subtitle}>
    

  <div class="relative min-h-screen overflow-hidden">

    <main class="relative z-10 max-w-6xl mx-auto px-6 py-24">

      <!-- The hand-rolled hero this replaces is the exact block PageHeader was
           extracted from — an eyebrow, an h1 and a lead, with its own inline styling.
           Using the shared one brings the title-seeded contour field with it, which is
           what stops this page looking stamped from the same die as the others. -->
      <PageHeader
        eyebrow={content.hero.tag}
        title={content.hero.heading}
        lead={content.hero.text}
        seed={content.title}
        variant="bare"
        class="mb-2xl"
      >
        <div class="mt-lg">
           <a href={chatLink} class="inline-flex items-center gap-3 bg-accent text-bg px-8 py-4 rounded-full font-bold text-lg hover:bg-accent-light transition-colors shadow-2">
             <i class="fa-solid fa-robot" aria-hidden="true"></i> {content.cta}
           </a>
        </div>
      </PageHeader>

      <div class="max-w-3xl mb-2xl">

        {evalStatus && (
          <p class="inline-flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-dim">
            <span class="sr-only">{evalCopy.label}:</span>
            <i
              class={evalPassing
                ? 'fa-solid fa-circle-check text-accent'
                : 'fa-solid fa-circle-exclamation text-accent'}
              aria-hidden="true"
            ></i>
            <span class="font-medium text-text">
              {evalStatus.scope === 'full' ? evalCopy.full(evalStatus) : evalCopy.smoke(evalStatus)}
            </span>
            <span aria-hidden="true">·</span>
            <span>{evalStatus.modelLabel}</span>
            <span aria-hidden="true">·</span>
            <time datetime={evalStatus.checkedAt}>{evalCopy.checked} {evalStatus.checkedAt}</time>
            {!evalPassing && <span class="w-full text-accent">{evalCopy.failing}</span>}
          </p>
        )}
      </div>

      <!-- Features Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-24">
        {Object.values(content.features).map((feature: any) => (
          <div class="p-8 rounded-2xl bg-white/5 border border-white/10 hover:border-accent/30 transition-colors group">
            <div class="w-12 h-12 rounded-xl bg-accent/10 text-accent flex items-center justify-center text-2xl mb-6 group-hover:scale-110 transition-transform">
              <i class={`fa-solid ${feature.icon}`} aria-hidden="true"></i>
            </div>
            <h2 class="text-2xl font-bold mb-3">{feature.title}</h2>
            <p class="text-dim leading-relaxed">{feature.desc}</p>
          </div>
        ))}
      </div>

      <!-- Tech Stack -->
      <div class="max-w-4xl mx-auto bg-glass border border-glass-border rounded-3xl p-10 md:p-16 relative overflow-hidden">
        <div class="absolute top-0 right-0 p-32 bg-accent/5 blur-[80px] rounded-full pointer-events-none"></div>
        
        <h2 class="text-3xl font-bold mb-10 text-center"><i class="fa-solid fa-code text-accent mr-3" aria-hidden="true"></i> {content.tech.title}</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
           {content.tech.stack.map((item: any) => (
             <div class="flex gap-4">
               <div class="w-1 h-full bg-accent/30 rounded-full flex-shrink-0"></div>
               <div>
                 <h3 class="font-bold text-lg text-text mb-1">{item.name}</h3>
                 <p class="text-sm text-dim">{item.desc}</p>
               </div>
             </div>
           ))}
        </div>
      </div>

    </main>
  </div>
</Layout>

<style>
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Content started at opacity 0 and only became visible via the animation, so
     anyone who suppresses motion — or hits a failed animation — got a blank
     section. Show it outright instead. */
  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in-up {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>




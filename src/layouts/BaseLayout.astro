---
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import SEO from '@components/SEO.astro';
import ChatWidget from '../components/common/ChatWidget.astro';
import CommandPalette from '@components/common/CommandPalette.astro';
import LedgerToast from '../components/game/LedgerToast.astro';
import LedgerModal from '../components/game/LedgerModal.astro';
import Chameleon from '@components/core/Chameleon.astro';
import Scriptorium from '@components/core/Scriptorium.astro';
import Anathema from '@components/core/Anathema.astro';
import { getLangFromUrl } from '@i18n/utils';
import '@styles/styles.css';
// After styles.css, not inside it. styles.css pulls in Tailwind's Preflight,
// which resets headings to `font-size: inherit; font-weight: inherit`; anything
// @imported into that file sits above Preflight in the cascade and loses.
import '@styles/reset.css';
import SpeedInsights from "@vercel/speed-insights/astro"
// The /astro entry, not /react: the React one mounted a client:load island that
// dragged React onto all ~196 pages (only ~10 have a genuine React island).
import Analytics from "@vercel/analytics/astro"
// Weight axis only, matching Fraunces below. The bare entry point also pulls the
// optical-size axis and both italic families; nothing on the site varies Inter's
// opsz, so that was download with no render.
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/inter/wght-italic.css';
// Fraunces for display. 80 font-serif usages previously fell through to Tailwind's
// default ui-serif stack and rendered as whatever Georgia/Times the OS supplied.
// Weight axis only: SOFT/WONK/opsz would cost 264 KB across both styles against
// 80 KB here, and at display sizes the weight axis carries the character.
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/fraunces/wght-italic.css';
import 'katex/dist/katex.min.css';
// Inlined verbatim below for first paint. Imported as a string rather than
// retyped, because the hand-copied version that used to live in this file had
// already drifted from the original.
import tokens from '@styles/tokens.css?raw';

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  bodyClass?: string;
  showChatWidget?: boolean;
  currentPath?: string;
  /** Explicit hreflang targets for sections with translated slugs — see SEO.astro. */
  alternates?: Partial<Record<'da' | 'en' | 'de', string>>;
}

const { title, description, image, article, bodyClass = "", showChatWidget = true, alternates } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <!-- 1. CRITICAL CSS: Inline everything needed for first paint -->
  <style is:inline set:html={tokens}></style>
  <style is:inline>
    /* === RESET & BASE ===
       First-paint subset only. src/styles/reset.css is the full version and
       must agree with what is here, or type reflows when it arrives. */
    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    html {
      background-color: var(--bg);
      color: var(--text);
      font-family: var(--font-main);
      transition: none !important;
    }

    body {
      font-family: var(--font-main);
      font-size: var(--body-size);
      line-height: var(--lh-body);
      background: var(--depth-bg);
      background-attachment: fixed;
      color: var(--text);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      min-height: 100vh;
      position: relative;
    }

    a {
      color: var(--accent);
      text-decoration: none;
      transition: color 0.25s ease, opacity 0.25s ease;
    }

    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    /* Display type is Fraunces. It was loaded on every page and used on none of
       the pages people actually visit — the homepage set every heading in the
       UI face at weight 800. */
    h1, h2, h3 {
      color: var(--text);
      margin: 0 0 0.5em;
      font-family: var(--font-display);
      line-height: var(--lh-heading);
      letter-spacing: var(--ls-display);
    }

    h1 { font-size: var(--h1-size); font-weight: 700; }
    h2 { font-size: var(--h2-size); font-weight: 650; }
    h3 { font-size: var(--step-3); font-weight: 600; }

    /* === MATH / KATEX === */
    .katex-display {
      overflow-x: auto;
      overflow-y: hidden;
      padding-bottom: 0.5rem;
      -webkit-overflow-scrolling: touch;
    }
  </style>

  <!-- 2. SEO and other metadata -->
  <SEO title={title} description={description} image={image} article={article} alternates={alternates} />
  <meta name="design-version" content="terrain-v1" />
  <SpeedInsights />
  <Analytics />
  
  <!-- 3. Font preloading for instant text rendering -->
  <!-- Replaced with @fontsource-variable/inter -->
  
  <!-- 4. Non-critical CSS and scripts (deferred) -->
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <!-- Font Awesome: load asynchronously so it doesn't block first paint -->
  <link rel="preload" as="style" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"></noscript>

  <script is:inline>
    /* Arms the scroll reveal. animations.css hides .animate-on-scroll only under
       .js-reveal, so if this line never runs — JS off, script error — the page
       simply renders with no animation instead of rendering blank. Inline and in
       <head> so it lands before first paint and nothing flashes. */
    document.documentElement.classList.add('js-reveal');
  </script>

  <slot name="head" />
  {/*
    A script here injected a second grain overlay on DOMContentLoaded. The site
    already had one — body::before in reset.css — at the same 0.03 opacity and
    the same z-index, so the texture was being applied twice. reset.css now
    carries the single overlay, with this block's inlined noise rather than the
    third-party SVG it used to fetch.
  */}
</head>
<body class={bodyClass}>
  <Chameleon />
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[9999] bg-gold-500 text-black px-4 py-2 font-bold rounded">
    Skip to Content
  </a>
  <Navbar />

  <div id="main-content">
    <slot />
  </div>

  <Footer />

  
  {showChatWidget && <ChatWidget />}
  <CommandPalette />
  <LedgerToast />
  <LedgerModal />
  <Scriptorium />
  <Anathema />

  <script>
    /*
      Scroll reveal.

      What was here before observed `.reveal` — a class with no CSS rule
      anywhere in the repo — and backed it with a MutationObserver watching the
      whole body, childList + subtree, for the lifetime of every page. It cost
      work on every DOM change and could not produce a visible effect.

      The class the markup actually carries is `.animate-on-scroll`, on roughly
      every section of every template, with `.delay-100|200|300` for stagger.
      animations.css had been overriding all of it to
      `opacity: 1 !important; transform: none !important`, so the markup was
      inert too. It is styled now, and this is what turns it on.
    */
    const targets = document.querySelectorAll('.animate-on-scroll');
    const show = (el: Element) => el.classList.add('in-view');

    if (!('IntersectionObserver' in window)) {
      targets.forEach(show);
    } else {
      const reveal = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          show(entry.target);
          reveal.unobserve(entry.target);
        }
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

      targets.forEach((el) => reveal.observe(el));

      /*
        Safety net. IntersectionObserver only delivers entries while the page is
        compositing, so a tab that is throttled, prerendered, or driven by a
        headless viewport that never paints can leave every observed element
        stranded at opacity 0 — the whole page invisible, with no error. Anything
        still unrevealed shortly after load gets shown outright.
      */
      const sweep = () => window.setTimeout(() => {
        for (const el of targets) {
          if (!el.classList.contains('in-view')) show(el);
        }
      }, 1200);

      if (document.readyState === 'complete') sweep();
      else window.addEventListener('load', sweep, { once: true });
    }
  </script>
  {/*
    A script here forced .animate-on-scroll elements visible. It was doubly
    inert: wrapped in 'astro:page-load', which never fires without the View
    Transitions router, and redundant anyway — animations.css already sets
    `opacity: 1 !important; transform: none !important` on that class
    unconditionally. It also assigned .style on an Element from
    querySelectorAll, which cost two entries on the type-error ratchet.
  */}
  <script>
    import { unlockAchievement, checkPolyglotAchievement, checkPageVisitAchievement, checkBroughtForwardAchievement, checkCompoundAchievements } from '../lib/gamification';

    // Counts this page towards 'explorer'. The function has existed since the
    // system was written and was never called anywhere, so that entry could only
    // ever be awarded by the AI chat deciding to hand it out.
    // Not deferred: a visitor who bounces on their fifth page still walked it.
    checkPageVisitAchievement();

    const konamiCode = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
    let cursor = 0;

    document.addEventListener('keydown', (e) => {
      if (e.key === konamiCode[cursor]) {
        cursor++;
        if (cursor === konamiCode.length) {
          unlockAchievement('easter_egg');
          cursor = 0;
        }
      } else {
        cursor = 0; 
      }
    });

    // Check Polyglot
    
    // Check Night Owl (00:00 - 05:00)
    const hour = new Date().getHours();
    if (hour >= 0 && hour < 5) {
        unlockAchievement('night_owl');
    }

    // Expose for static scripts (search.js)
    window.unlockAchievement = unlockAchievement;
    
    // Run delayed checks
    setTimeout(() => {
        checkPolyglotAchievement();
        // Reads the timestamps already in the book, so it costs no new storage.
        // Delayed with the rest: coming back after a week is not urgent news.
        checkBroughtForwardAchievement();
        // Settles compounds whose halves were both earned before they existed.
        checkCompoundAchievements();
    }, 1000);

    // --- META ACHIEVEMENTS TRIGGERS ---

    // 1. Pixel Perfect (Resize)
    let resizeCount = 0;
    let lastWidth = window.innerWidth;
    window.addEventListener('resize', () => {
        if (Math.abs(window.innerWidth - lastWidth) > 50) {
            resizeCount++;
            lastWidth = window.innerWidth;
            if (resizeCount >= 3) {
                unlockAchievement('pixel_perfect');
            }
        }
    });

    // 2. Speed Demon (Page Navigation Speed)
    // We use sessionStorage to store timestamps of recent page loads
    const now = Date.now();
    let visits = JSON.parse(sessionStorage.getItem('page_visits') || '[]');
    // Filter out visits older than 30 seconds
    visits = visits.filter(t => now - t < 30000);
    visits.push(now);
    sessionStorage.setItem('page_visits', JSON.stringify(visits));
    
    if (visits.length >= 5) {
        unlockAchievement('speed_demon');
    }

    // 3. Social Butterfly (Link Clicks)
    document.addEventListener('click', (e) => {
        const link = e.target.closest('a');
        if (link && link.href) {
            const isExternal = link.hostname !== window.location.hostname;
            const isSocial = /linkedin|github|twitter|instagram|facebook/.test(link.href);
            
            if (isExternal && isSocial) {
                let clickedSocials = JSON.parse(localStorage.getItem('clicked_socials') || '[]');
                if (!clickedSocials.includes(link.href)) {
                    clickedSocials.push(link.href);
                    localStorage.setItem('clicked_socials', JSON.stringify(clickedSocials));
                }
                
                if (clickedSocials.length >= 3) {
                    unlockAchievement('social_butterfly');
                }
            }
        }
    });
  </script>
</body>
</html>


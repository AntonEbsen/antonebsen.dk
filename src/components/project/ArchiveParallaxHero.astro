---
// src/components/project/ArchiveParallaxHero.astro
---

<div class="relative w-full h-[95vh] overflow-hidden bg-[#050404]">
    <div class="absolute inset-0 z-0">
        <!-- Parallax layers. Handled by a simple scroll script below -->
        
        <!-- Background Noise/Texture -->
        <div class="absolute inset-0 bg-[url('/assets/images/noise.png')] opacity-30 mix-blend-overlay pointer-events-none z-0"></div>
        
        <!-- Layer 1: Background Blur / Distant Documents (Slow) -->
        <div class="parallax-layer w-full h-full absolute inset-0 opacity-20 pointer-events-none" data-speed="0.1">
            <div class="absolute top-10 left-[10%] w-96 h-[500px] bg-[#f5deb3] transform rotate-12 blur-[8px] mix-blend-screen opacity-10"></div>
            <div class="absolute bottom-10 right-[15%] w-80 h-[400px] bg-[#f5deb3] transform -rotate-12 blur-[12px] mix-blend-screen opacity-5"></div>
        </div>
        
        <!-- Layer 2: Mid-ground Documents (Medium) -->
        <div class="parallax-layer w-full h-full absolute inset-0 opacity-40 pointer-events-none" data-speed="0.3">
            <div class="absolute top-[20%] right-[10%] w-[400px] h-[600px] bg-[#e8d5b5]/10 border border-amber-900/30 transform rotate-6 shadow-[0_0_50px_rgba(0,0,0,0.8)] overflow-hidden p-10 flex flex-col gap-6">
                <div class="w-full h-2 bg-amber-900/30 rounded-full"></div>
                <div class="w-3/4 h-2 bg-amber-900/30 rounded-full"></div>
                <div class="w-5/6 h-2 bg-amber-900/30 rounded-full"></div>
                <div class="w-1/2 h-2 bg-amber-900/30 rounded-full mt-4"></div>
                
                <div class="mt-auto w-16 h-16 rounded-full border-2 border-red-900/40 opacity-50 flex items-center justify-center transform -rotate-12">
                    <span class="text-red-900/40 font-serif text-[10px] uppercase font-bold">Seal</span>
                </div>
            </div>
            
            <div class="absolute bottom-[10%] left-[15%] w-[450px] h-[300px] bg-[#e8d5b5]/5 border border-amber-900/40 transform -rotate-12 shadow-[0_0_50px_rgba(0,0,0,0.8)] p-8">
                 <p class="text-amber-900/30 text-5xl font-serif transform -rotate-2" style="font-family: 'Brush Script MT', 'Lucida Handwriting', cursive">Anno 1754...</p>
            </div>
        </div>
        
        <!-- Layer 3: Foreground (Fastest) -->
        <div class="parallax-layer w-full h-full absolute inset-0 opacity-70 pointer-events-none" data-speed="0.6">
            <div class="absolute -bottom-20 -left-10 w-[700px] h-[450px] bg-gradient-to-tr from-[#1a1310] to-[#2d1f18] border border-amber-900/50 transform rotate-3 shadow-[0_40px_80px_-15px_rgba(0,0,0,0.9)] p-12">
                <div class="absolute inset-0 bg-[url('/assets/images/noise.png')] opacity-40 mix-blend-overlay"></div>
                <h2 class="text-amber-500/20 text-6xl font-serif tracking-widest absolute top-10 left-10">Toldbog<br/>Nr. 114</h2>
            </div>
            
            <div class="absolute top-[30%] -right-20 w-[300px] h-[200px] bg-[#1a1310] border-l border-b border-amber-900/60 transform -rotate-6 shadow-[0_40px_80px_-15px_rgba(0,0,0,0.9)] opacity-80 backdrop-blur-sm"></div>
        </div>
    </div>
    
    <!-- Hero Content (Fixed / Slow Parallax) -->
    <div class="absolute inset-0 flex flex-col items-center justify-center z-10 parallax-layer pointer-events-none" data-speed="-0.1">
        <div class="text-center max-w-5xl px-4 flex flex-col items-center">
            <div class="mb-8 p-4 rounded-full border border-amber-500/20 bg-amber-500/5 backdrop-blur-md">
                <i class="fa-solid fa-anchor text-amber-500 text-2xl"></i>
            </div>
            
            <h1 class="text-5xl md:text-8xl font-serif font-bold text-transparent bg-clip-text bg-gradient-to-b from-white via-amber-100 to-amber-600 mb-6 drop-shadow-[0_10px_10px_rgba(0,0,0,0.8)]" style="letter-spacing: 0.05em;">
                Danish West Indies
            </h1>
            
            <p class="text-xl md:text-3xl text-amber-200/80 font-serif max-w-3xl mx-auto drop-shadow-xl mb-12">
                An Economic History of Colonial Trade & Slavery
            </p>
            
            <div class="flex flex-wrap justify-center gap-6 pointer-events-auto">
                <a href="#content" class="px-8 py-3 bg-amber-500 text-[#050404] rounded border border-amber-400 font-bold font-mono text-sm uppercase tracking-widest hover:bg-amber-400 hover:scale-105 transition-all shadow-[0_0_20px_rgba(245,158,11,0.4)]">
                    Explore Archive
                </a>
                <a href="https://danishwestindies.org/" target="_blank" class="px-8 py-3 bg-black/60 text-amber-500 rounded border border-amber-500/50 font-bold font-mono text-sm uppercase tracking-widest hover:bg-amber-900/40 hover:scale-105 transition-all backdrop-blur-md">
                    Visit Platform
                </a>
            </div>
        </div>
    </div>
    
    <!-- Gradient Fade to next section -->
    <div class="absolute bottom-0 left-0 w-full h-64 bg-gradient-to-t from-bg via-bg/80 to-transparent z-20 pointer-events-none"></div>
</div>

<script>
    const parallaxLayers = document.querySelectorAll('.parallax-layer') as NodeListOf<HTMLElement>;
    
    window.addEventListener('scroll', () => {
        const scrolled = window.scrollY;
        
        // Stop updating if we've scrolled past the hero section to save performance
        if (scrolled > window.innerHeight) return;
        
        requestAnimationFrame(() => {
            parallaxLayers.forEach(layer => {
                const speed = parseFloat(layer.getAttribute('data-speed') || '0');
                const yPos = -(scrolled * speed);
                layer.style.transform = `translateY(${yPos}px)`;
            });
        });
    });
</script>

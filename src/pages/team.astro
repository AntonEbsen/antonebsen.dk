---
import Layout from '@layouts/BaseLayout.astro';
import CollaboratorSpotlight from '@components/project/CollaboratorSpotlight';
import ResearchRadar from '@components/project/ResearchRadar';
import { anton, sheng, jonas } from '@data/collaborators';
import { getImage } from 'astro:assets';
import portraitSrc from '../assets/img/billede-af-mig.jpg';

// CollaboratorSpotlight is a React island and wants a plain URL, so getImage() is
// the right tool rather than <Image>. Linking /assets/img/billede-af-mig.jpg
// directly shipped the untouched 2362x3543, 785 KB original for a small avatar.
// The largest slot CollaboratorSpotlight renders this in is w-12 (48px), so 128
// covers it at 2x. Height follows the source aspect ratio; object-cover crops it.
const portrait = await getImage({ src: portraitSrc, width: 128, format: 'webp' });

// Identity comes from @data/collaborators; the role, bio and status are what this
// page adds on top.
const team = [
    {
        ...anton,
        role: "Hovedforfatter & Udvikler",
        image: portrait.src,
        description: "Specialiseret i makroøkonomisk modellering, webudvikling og brobygning mellem økonomisk teori og data science.",
        status: { text: "Starter speciale", color: "yellow" }
    },
    {
        ...sheng,
        role: "Medforfatter & Data Scientist",
        description: "Ekspertise i højdimensionel datahåndtering, Stata-programmering og rigoristisk økonometrisk implementering (GMM).",
        status: { text: "Coding Stata", color: "blue" }
    },
    {
        ...jonas,
        role: "Medforfatter & Teoretiker",
        description: "Fokus på pengepolitisk transmission, spilteori og strukturelle brud i tidsseriedata.",
        status: { text: "Reviewing Theory", color: "green" }
    }
];

// Every tile is checkable against a page on this site: four joint projects
// (ECB 2024, GenAI-forslaget, velfærdsseminaret 2026, specialet), and we met in 2020.
const stats = [
    { label: "Fælles Projekter", value: "4", icon: "fa-book-open" },
    { label: "År i Samarbejde", value: "6", icon: "fa-calendar-check" },
    { label: "Akademisk Fokus", value: "Makro & politisk økonomi", icon: "fa-globe" },
    { label: "Seneste Paper", value: "Juni 2026", icon: "fa-file-lines" },
];

const timeline = [
    { year: "2020", title: "Dannelse", desc: "Mødtes på Københavns Universitet. Etablerede et samarbejde omkring Mikroøkonomi og Matematisk Analyse.", href: null },
    { year: "2023", title: "Exchange Rate Dynamics", desc: "Første fælles projekt, skrevet med Sheng under bacheloren. Analyse af dansk inflation og relative valutakurser.", href: "/projects/exchange-rate-dynamics" },
    { year: "2024", title: "ECB Taylor Rules", desc: "Første seminaropgave alle tre skrev sammen. GMM-estimering af asymmetriske politiske reaktioner i euroområdet.", href: "/projects/ecb-taylor-rules" },
    { year: "2026", title: "Does GenAI Help Those Who Need It Most?", desc: "Forskningsforslag om generativ AI's heterogene effekter på tværs af socioøkonomiske skel i danske gymnasier.", href: "/projects/genai-inequality" },
    { year: "2026", title: "Globalization and the Welfare State", desc: "Seminaropgave afleveret juni 2026. Paneldataanalyse af 32 OECD-lande 1980–2023; rullende regressioner afdækker et strukturelt brud i 2008.", href: "/projects/welfare-state-seminar" },
    { year: "2026", title: "Kandidatspeciale", desc: "Monetary Policy & Economic Relations. Starter 20. august 2026 med fokus på pengepolitikken i en post-COVID verden.", href: "/projects/master-thesis" },
];

const methodology = [
    { step: "01", title: "Data Engineering", desc: "Automatiserede Python-pipelines sikrer reproducerbarhed. Vi renser aldrig data manuelt.", icon: "fa-server" },
    { step: "02", title: "Økonometri", desc: "Rigoristisk identifikation i Stata. Fra simple OLS til GMM og strukturelle VAR-modeller.", icon: "fa-chart-line" },
    { step: "03", title: "Formidling", desc: "LaTeX til akademiske papers, Astro til interaktive web-dashboards. Klarhed er konge.", icon: "fa-pen-nib" }
];

// Faserne i specialet, som planlagt. Ingen procenter: projektet er ikke påbegyndt endnu.
const thesis_phases = [
    { label: "Litteraturstudie", note: "Aug–sep 2026" },
    { label: "Dataindsamling", note: "Sep–okt 2026" },
    { label: "Modelvalidering", note: "Okt–nov 2026" },
    { label: "Skrivefase", note: "Nov 2026–jan 2027" }
];

const citations = [
    "Gabaix, X. & Maggiori, M. (2015). International Liquidity and Exchange Rate Dynamics. QJE.",
    "Rey, H. (2015). Dilemma not Trilemma: The Global Financial Cycle and Monetary Policy Independence. NBER.",
    "Miranda-Agrippino, S. & Rey, H. (2020). U.S. Monetary Policy and the Global Financial Cycle. RES.",
    "Bruno, V. & Shin, H. S. (2015). Cross-Border Banking and Global Liquidity. RES.",
    "Rodrik, D. (1998). Why Do More Open Economies Have Bigger Governments? JPE.",
    "Esping-Andersen, G. (1990). The Three Worlds of Welfare Capitalism. Princeton University Press.",
    "Yay, G. G. & Aksoy, T. (2018). Globalization and the welfare state. Quality & Quantity.",
    "Agersnap, O., Jensen, A. & Kleven, H. (2020). The Welfare Magnet Hypothesis. AER: Insights."
];

const tools = [
    { tool: "Stata", packages: ["reghdfe", "ivreg2", "gmm", "estout"], icon: "fa-layer-group", color: "text-blue-400" },
    { tool: "Python", packages: ["pandas", "numpy", "scipy", "matplotlib"], icon: "fa-brands fa-python", color: "text-yellow-400" },
    { tool: "LaTeX", packages: ["tikz", "beamer", "biblatex", "pgfplots"], icon: "fa-file-code", color: "text-green-400" },
    { tool: "DevOps", packages: ["git", "github-actions", "docker", "duckdb"], icon: "fa-terminal", color: "text-slate-400" }
];

const changelog = [
    { date: "Jun 2026", title: "Rullende regressioner & Chow-test", desc: "Estimation af globaliseringskoefficienten over 10-årige vinduer afslørede parameterustabilitet; en Chow-test bekræftede et strukturelt brud i 2008 for alle fire KOF-indeks." },
    { date: "Apr 2026", title: "OECD-panel samlet", desc: "Harmonisering af CPDS, KOF, OECD og Verdensbanken til ét balanceret panel over 32 lande, 1980–2023." },
    { date: "Feb 2025", title: "Automatisering af valutakursdata", desc: "Scriptet indhentning og harmonisering af valutakurs- og prisindeksserier fra Danmarks Statistik, så datasættet kan genopbygges fra bunden." },
    { date: "Jan 2025", title: "DuckDB i workflowet", desc: "Migrering af større datasæt fra CSV til DuckDB/Parquet for hurtigere forespørgsler under den eksplorative fase." },
    { date: "Dec 2024", title: "GMM-estimering", desc: "To-trins GMM med laggede instrumenter implementeret i Stata til ECB-projektets Taylor-regler." }
];

// De fire fælles arbejder. Titler, år, karakterer og PDF-stier er hentet fra hvert
// projekts egen citation-blok; `pdf` udelades hvor filen ikke findes endnu.
const jointOutput = [
    {
        title: "Globalization and the Welfare State",
        year: "2026",
        kind: "Seminaropgave",
        venue: "Economics of the Welfare State, Københavns Universitet. Vejleder: Amalie Sofie Jensen.",
        role: "Metode og identifikation, residualdiagnostik, rullende regressioner, delperiodeanalyse, valg af standardfejl og omvendt kausalitet.",
        grade: "10",
        href: "/projects/welfare-state-seminar",
        pdf: "/assets/docs/Nielsen_Chen_Jorgensen_2026_Globalization_and_the_Welfare_State.pdf"
    },
    {
        title: "Does GenAI Help Those Who Need It Most?",
        year: "2026",
        kind: "Forskningsforslag",
        venue: "AI for Humanity, Københavns Universitet. Heterogene effekter af generativ AI i danske gymnasier.",
        grade: "10",
        href: "/projects/genai-inequality"
    },
    {
        title: "One Rule to Rule Them All?",
        year: "2024",
        kind: "Seminaropgave",
        venue: "ECB's pengepolitik og asymmetriske effekter i euroområdet. Vejleder: Michael Bergman.",
        grade: "10",
        href: "/projects/ecb-taylor-rules"
    },
    {
        title: "Monetary Policy & Economic Relations",
        year: "2026–27",
        kind: "Kandidatspeciale",
        venue: "Starter 20. august 2026. Empirisk analyse af pengepolitikken i en post-COVID verden.",
        href: "/projects/master-thesis"
    }
];

// Verified against cv/da.json. Every entry is a course actually taken, with its
// recorded ECTS and grade — /courses lists all 51 if you want the full record.
const curriculum = [
    { course: "Seminar – Economics of the Welfare State", ects: null, grade: "10", desc: "Velfærdsstatens økonomi. Afsluttet med seminaropgaven bag dette projekt." },
    { course: "Advanced Macroeconomics – Structural VAR", ects: "7.5", grade: "10", desc: "Identifikation, impulsresponsfunktioner og robusthed i strukturelle VAR-modeller." },
    { course: "Advanced Macroeconomics – Business Cycles", ects: "7.5", grade: "10", desc: "Konjunkturteori, DSGE-modeller og makroøkonomiske fluktuationer." },
    { course: "Anvendt økonomisk modellering", ects: "7.5", grade: "10", desc: "Kalibrering, SAM, stød og baseline-checks. Værktøj: GAMS." }
];
---

<Layout title="Forskningsteamet | Anton Ebsen" description="Forskningsteamet bag projekterne." currentPath="/team">
    <main class="bg-slate-950 min-h-screen text-slate-200 pb-24">
        
        {/* Hero */}
        <div class="relative min-h-[50vh] flex items-center justify-center overflow-hidden border-b border-white/5">
             <div class="absolute inset-0 bg-slate-950">
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-blue-900/10 via-slate-950/50 to-slate-950"></div>
             </div>
             
             <div class="container mx-auto px-4 relative z-10 text-center">
                 <div class="animate-in fade-in slide-in-from-bottom-8 duration-1000">
                    <h1 class="text-4xl md:text-6xl font-serif font-medium text-white mb-6 tracking-tight">
                        Forskningsteamet
                    </h1>
                    <p class="text-lg md:text-xl text-slate-400 font-serif italic max-w-2xl mx-auto leading-relaxed">
                        Et samarbejde om at fremme forståelsen af makroøkonomiske dynamikker gennem rigoristisk dataanalyse og økonomisk teori.
                    </p>
                 </div>
             </div>
        </div>

        {/* Team Stats */}
        <section class="container mx-auto max-w-5xl px-4 py-16">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                {stats.map(stat => (
                    <div class="bg-white/5 border border-white/10 p-8 rounded-2xl text-center hover:border-blue-500/30 transition-colors group">
                        <i class={`fa-solid ${stat.icon} text-2xl text-slate-400 mb-4 group-hover:text-blue-400 transition-colors`}></i>
                        <h3 class="text-3xl font-bold text-white mb-2 font-serif">{stat.value}</h3>
                        <p class="text-xs uppercase tracking-widest text-slate-400 font-bold">{stat.label}</p>
                    </div>
                ))}
            </div>
        </section>

        {/* The Team */}
        <section class="container mx-auto max-w-4xl px-4 py-16 border-t border-white/5">
             <h2 class="text-center text-xs uppercase tracking-[0.2em] font-bold text-slate-400 mb-16">Holdet</h2>
             <CollaboratorSpotlight client:visible collaborators={team} label="" />
        </section>

        {/* Timeline */}
        <section class="container mx-auto max-w-3xl px-4 py-16 relative">
            <h2 class="text-center text-xs uppercase tracking-[0.2em] font-bold text-slate-400 mb-16">Samarbejdshistorik</h2>
            
            <div class="absolute left-1/2 top-32 bottom-0 w-px bg-white/10 -translate-x-1/2"></div>
            
            <div class="space-y-24">
                {timeline.map((item, i) => (
                    <div class={`relative flex flex-col md:flex-row items-center justify-between gap-8 md:gap-0 ${i % 2 === 0 ? 'md:flex-row-reverse' : ''}`}>
                        
                        {/* Empty Space for Desktop */}
                        <div class="hidden md:block md:w-5/12"></div>
                        
                        {/* Center Dot */}
                        <div class="absolute left-4 md:left-1/2 md:-translate-x-1/2 w-4 h-4 rounded-full bg-slate-900 border-2 border-slate-700 z-10 mt-1.5 md:mt-0"></div>
                        
                        {/* Content */}
                        <div class={`w-full pl-12 md:pl-0 md:w-5/12 ${i % 2 === 0 ? 'md:text-right' : 'md:text-left'} relative`}>
                            <span class="deco-numeral text-3xl md:text-5xl font-bold absolute -top-6 md:-top-8 left-12 md:left-0 md:right-0 pointer-events-none select-none font-serif" data-numeral={item.year} aria-hidden="true"></span>
                            <div class="relative z-10">
                                <h3 class="text-lg font-bold text-white mb-2">
                                    {item.href
                                        ? <a href={item.href} class="hover:text-blue-400 transition-colors">{item.title}</a>
                                        : item.title}
                                </h3>
                                <p class="text-slate-400 text-sm leading-relaxed">{item.desc}</p>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </section>

        {/* Fælles output — hvert felt stammer fra det pågældende projekts egen
            citation-blok. PDF-link vises kun hvor filen faktisk findes. */}
        <section class="container mx-auto max-w-5xl px-4 py-16 border-t border-white/5">
            <h2 class="text-center text-xs uppercase tracking-[0.2em] font-bold text-slate-400 mb-16">Fælles output</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {jointOutput.map(w => (
                    <div class="bg-slate-900/50 border border-white/5 rounded-2xl p-6 flex flex-col hover:border-blue-500/30 transition-colors group">
                        <div class="flex items-start justify-between gap-4 mb-3">
                            <span class="text-[10px] font-bold uppercase tracking-widest text-blue-400">{w.kind}</span>
                            <span class="text-[10px] font-mono text-slate-400 shrink-0">{w.year}</span>
                        </div>
                        <h3 class="text-lg font-bold text-white mb-2 leading-snug">
                            <a href={w.href} class="hover:text-blue-400 transition-colors">{w.title}</a>
                        </h3>
                        <p class="text-xs text-slate-400 leading-relaxed mb-4">{w.venue}</p>
                        {w.role && (
                            <p class="text-xs text-slate-400 leading-relaxed mb-4 pl-3 border-l border-blue-500/20 italic">
                                <span class="not-italic font-bold text-slate-400">Min rolle:</span> {w.role}
                            </p>
                        )}
                        <div class="mt-auto pt-4 border-t border-white/5 flex items-center gap-4">
                            {w.grade && (
                                <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-400/80">Karakter {w.grade}</span>
                            )}
                            <div class="ml-auto flex items-center gap-4">
                                <a href={w.href} class="text-[10px] font-bold uppercase tracking-widest text-slate-400 hover:text-blue-400 transition-colors">Projekt &rarr;</a>
                                {w.pdf && (
                                    <a href={w.pdf} class="text-[10px] font-bold uppercase tracking-widest text-slate-400 hover:text-red-400 transition-colors">
                                        <i class="fa-solid fa-file-pdf mr-1"></i>PDF
                                    </a>
                                )}
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </section>

        {/* 1. Methodology Workflow */}
        <section class="container mx-auto max-w-5xl px-4 py-16 border-t border-white/5">
             <h2 class="text-center text-xs uppercase tracking-[0.2em] font-bold text-slate-400 mb-16">Metodologi & Workflow</h2>
             <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
                 {/* Connecting Line (Desktop) */}
                 <div class="hidden md:block absolute top-12 left-0 w-full h-0.5 bg-gradient-to-r from-transparent via-blue-500/20 to-transparent -z-10"></div>
                 
                 {methodology.map(s => (
                     <div class="bg-slate-900 border border-white/10 p-8 rounded-2xl relative group hover:-translate-y-2 transition-transform duration-300">
                         <div class="w-12 h-12 bg-slate-800 rounded-full flex items-center justify-center border border-white/10 mb-6 group-hover:border-blue-500/50 group-hover:bg-blue-500/10 transition-colors">
                             <i class={`fa-solid ${s.icon} text-slate-400 group-hover:text-blue-400`}></i>
                         </div>
                         <h3 class="text-xl font-bold text-white mb-2">{s.title}</h3>
                         <p class="text-slate-400 text-sm leading-relaxed">{s.desc}</p>
                         <span class="deco-numeral absolute top-4 right-6 text-4xl font-black" data-numeral={s.step} aria-hidden="true"></span>
                     </div>
                 ))}
             </div>
        </section>

        {/* 2. Thesis Tracker */}
        <section class="container mx-auto max-w-4xl px-4 py-16">
            <div class="bg-gradient-to-br from-blue-900/10 to-slate-900 border border-blue-500/20 rounded-3xl p-8 md:p-12 relative overflow-hidden">
                <div class="absolute top-0 right-0 w-64 h-64 bg-blue-500/10 rounded-full blur-[80px]"></div>
                
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
                    <div>
                         <h2 class="text-lg font-bold text-blue-400 flex items-center gap-2">
                            <i class="fa-solid fa-satellite-dish animate-pulse"></i> Speciale-Tracker
                        </h2>
                        <h3 class="text-3xl font-serif text-white mt-2">Monetary Policy &amp; Economic Relations</h3>
                        <p class="text-slate-400 text-sm mt-1">Starter 20. august 2026 · forventet aflevering januar 2027</p>
                    </div>
                    <div class="text-right">
                        <span class="text-sm font-bold uppercase tracking-widest text-blue-400">Ikke påbegyndt</span>
                        <span class="block text-xs text-slate-400 mt-1">Planlagte faser</span>
                    </div>
                </div>

                <ol class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    {thesis_phases.map((t, i) => (
                        <li class="flex items-start gap-3 bg-slate-900/60 border border-white/5 rounded-xl p-4">
                            <span class="w-6 h-6 rounded-full border border-blue-500/30 text-blue-400 text-[10px] font-bold flex items-center justify-center shrink-0 mt-0.5">{i + 1}</span>
                            <div>
                                <span class="block text-sm font-bold text-slate-200">{t.label}</span>
                                <span class="block text-xs text-slate-400 mt-0.5">{t.note}</span>
                            </div>
                        </li>
                    ))}
                </ol>
            </div>
        </section>

        {/* 3. Data Scale & Research Radar */}
        <section class="bg-white/5 py-24 border-y border-white/5">
             <div class="container mx-auto max-w-6xl px-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
                    
                    {/* Left: Big Numbers */}
                    <div>
                        <h2 class="text-xs uppercase tracking-[0.2em] font-bold text-slate-400 mb-12">Datagrundlaget</h2>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 text-center md:text-left">
                            <div>
                                <span class="block text-4xl md:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-b from-white to-slate-500 mb-2">32 lande</span>
                                <span class="text-xs font-bold text-blue-400 uppercase tracking-widest">OECD-panel, 1980–2023</span>
                                <p class="text-slate-400 text-xs mt-2">CPDS, KOF, OECD og Verdensbanken harmoniseret til ét panel. N = 996 i de fuldt specificerede modeller. <a href="/projects/welfare-state-seminar" class="text-blue-400 hover:underline">Globalization and the Welfare State</a>.</p>
                            </div>
                            <div>
                                <span class="block text-4xl md:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-b from-white to-slate-500 mb-2">1999–2024</span>
                                <span class="text-xs font-bold text-purple-400 uppercase tracking-widest">Kvartalsdata, euroområdet</span>
                                <p class="text-slate-400 text-xs mt-2">Eurostat, OECD Economic Outlook og ECB Statistical Data Warehouse. <a href="/projects/ecb-taylor-rules" class="text-purple-400 underline decoration-purple-400/40 underline-offset-2 hover:decoration-purple-400">ECB Taylor Rules</a>.</p>
                            </div>
                            <div class="sm:col-span-2">
                                <span class="block text-4xl md:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-b from-white to-slate-500 mb-2">20.000+</span>
                                <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest">Datapunkter, højfrekvente finansielle data</span>
                                <p class="text-slate-400 text-xs mt-2">Struktureret og processeret til SVAR-estimation. <a href="/projects/global-financial-cycle" class="text-emerald-400 underline decoration-emerald-400/40 underline-offset-2 hover:decoration-emerald-400">Global Financial Cycle</a> (bachelorprojekt).</p>
                            </div>
                        </div>
                    </div>

                    {/* Right: Research Radar */}
                    <div class="bg-slate-900/50 border border-white/5 p-8 rounded-3xl relative overflow-hidden group hover:border-blue-500/30 transition-colors">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-blue-500/10 rounded-full blur-[40px] group-hover:bg-blue-500/20 transition-colors"></div>
                        <h3 class="text-lg font-bold text-white mb-2 flex items-center gap-2">
                            <i class="fa-solid fa-chart-radar text-blue-400"></i> Metodedækning
                        </h3>
                        <p class="text-xs text-slate-400 mb-6 leading-relaxed">
                            Antal af de fire fælles arbejder der anvender hver metodefamilie. Aksen går fra 0 til 4.
                        </p>
                        <ResearchRadar
                            client:visible
                            labels={["Paneldata & FE", "Tidsrække / VAR", "IV & GMM", "Robusthed & diagnostik", "Survey & ML"]}
                            values={[1, 2, 1, 2, 1]}
                            seriesLabel="Fælles arbejder"
                            max={4}
                            unit=" af 4 projekter"
                        />
                        <p class="text-[10px] text-slate-400 mt-4 leading-relaxed">
                            Paneldata: velfærdsseminaret. Tidsrække/VAR: ECB-projektet og specialet. IV/GMM: ECB-projektet.
                            Robusthed: ECB-projektet og velfærdsseminaret. Survey/ML: GenAI-forslaget.
                        </p>
                    </div>
                </div>
             </div>
        </section>

        {/* 4. The Library (Citations) */}
        <section class="container mx-auto max-w-4xl px-4 py-16">
            <h2 class="text-center text-xs uppercase tracking-[0.2em] font-bold text-slate-400 mb-12">Vidensbanken</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {citations.map(cite => (
                    <div class="bg-slate-900 border border-white/5 p-4 rounded-lg flex items-start gap-3 hover:border-white/20 transition-colors">
                        <i class="fa-solid fa-quote-left text-slate-400 mt-1"></i>
                        <p class="text-sm text-slate-300 font-serif italic">{cite}</p>
                    </div>
                ))}
            </div>
        </section>

        {/* 5. Visual Abstracts (Gallery) */}
        <section class="container mx-auto max-w-6xl px-4 py-16 mb-16">
             <h2 class="text-center text-xs uppercase tracking-[0.2em] font-bold text-slate-400 mb-12">Galleri</h2>
             {/* Figurer fra seminaropgaven. object-contain frem for object-cover: det er
                 hvide matplotlib-plots, og cover ville beskære akserne væk. */}
             <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

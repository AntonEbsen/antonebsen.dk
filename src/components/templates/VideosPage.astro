---
import Layout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import VideoCard from '@components/ui/VideoCard.astro';
import ContactCard from '@components/common/ContactCard.astro';
import { getCollection } from 'astro:content';
import { getLatestVideos, CHANNEL_URL, CHANNEL_NAME } from '@lib/youtube';

interface Props {
  lang: 'da' | 'en';
}

const { lang } = Astro.props;
const isDa = lang === 'da';

// Curated entries are the source of truth.
const collection = await getCollection('videos');
const videos = collection
  .map((entry) => ({ slug: entry.id.replace(/\.json$/, ''), ...entry.data }))
  .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime());

const curatedIds = new Set(videos.map((v) => v.youtubeId));

// Build-time RSS pull, so a fresh upload appears on the next deploy without a content
// commit. Returns [] if YouTube is unreachable — the page still renders from the collection.
const latest = await getLatestVideos();
const uncurated = latest.filter((v) => !curatedIds.has(v.youtubeId)).slice(0, 4);

const counts = {
  all: videos.length,
  hiking: videos.filter((v) => v.track === 'hiking').length,
  economics: videos.filter((v) => v.track === 'economics').length
};

const localizedContent = {
  da: {
    title: 'Videoer',
    description: 'Vandrefilm fra Europas bjerge og økonomi forklaret gennem data — fra YouTube-kanalen The Wandering Economist.',
    heroEyebrow: 'The Wandering Economist',
    heroTitle: 'Til fods. I tal.',
    heroLead: 'Jeg er økonomisk historiker, der hellere ville stå på en bjergtop. Her mødes mine to verdener: de ruter jeg går, og de data jeg graver i.',
    subscribe: 'Abonnér på YouTube',
    filters: { all: 'Alle', hiking: 'Vandring', economics: 'Økonomi' },
    newTitle: 'Nyt på YouTube',
    newLead: 'Netop udgivet — endnu ikke skrevet ind her.',
    empty: 'Der er ingen videoer endnu. Følg kanalen for at få besked, når de første lander.',
    contactTitle: 'Følg med',
    contactText: 'Nye videoer lander på kanalen først. Du finder mig også her:'
  },
  en: {
    title: 'Videos',
    description: 'Hiking films from the mountains of Europe and economics explained through data — from the YouTube channel The Wandering Economist.',
    heroEyebrow: 'The Wandering Economist',
    heroTitle: 'On foot. In numbers.',
    heroLead: "I'm an economic historian who'd rather be on a summit. This is where my two worlds meet: the trails I walk and the data I dig through.",
    subscribe: 'Subscribe on YouTube',
    filters: { all: 'All', hiking: 'Hiking', economics: 'Economics' },
    newTitle: 'New on YouTube',
    newLead: "Just published — not written up here yet.",
    empty: 'No videos yet. Follow the channel to hear when the first ones land.',
    contactTitle: 'Follow along',
    contactText: 'New videos land on the channel first. You can also find me here:'
  }
};

const t = localizedContent[lang];

const filters = [
  { key: 'all', label: t.filters.all, icon: 'fa-solid fa-layer-group', count: counts.all },
  { key: 'hiking', label: t.filters.hiking, icon: 'fa-solid fa-mountain-sun', count: counts.hiking },
  { key: 'economics', label: t.filters.economics, icon: 'fa-solid fa-chart-line', count: counts.economics }
];

// VideoObject rich results.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${t.title} — ${CHANNEL_NAME}`,
  itemListElement: videos.map((video, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'VideoObject',
      name: (isDa && video.title_da) || video.title,
      description: (isDa && video.description_da) || video.description,
      uploadDate: video.publishedAt,
      thumbnailUrl: video.thumbnail ?? `https://i.ytimg.com/vi/${video.youtubeId}/maxresdefault.jpg`,
      embedUrl: `https://www.youtube-nocookie.com/embed/${video.youtubeId}`,
      contentUrl: `https://www.youtube.com/watch?v=${video.youtubeId}`,
      url: new URL(`${isDa ? '/videoer' : '/en/videos'}/${video.slug}`, Astro.site ?? 'https://antonebsen.dk').href
    }
  }))
};
---

<Layout title={t.title} description={t.description}>
  <main class="relative overflow-hidden">

    <Section class="text-center pt-32 pb-20 border-b border-white/5">
      <div class="max-w-4xl mx-auto px-4 relative z-10">
        <p class="text-[10px] font-bold uppercase tracking-[0.4em] text-accent mb-6">{t.heroEyebrow}</p>
        <h1 class="text-5xl md:text-7xl font-black text-white leading-[0.9] mb-8 uppercase italic">
          {t.heroTitle}
        </h1>
        <p class="text-lg md:text-xl text-white/50 leading-relaxed font-serif italic max-w-2xl mx-auto mb-10">
          {t.heroLead}
        </p>
        <a
          href={CHANNEL_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 px-6 py-3 rounded-full bg-accent text-black font-bold text-xs uppercase tracking-widest no-underline hover:bg-white transition-colors"
        >
          <i class="fa-brands fa-youtube text-base"></i>{t.subscribe}
        </a>
      </div>

      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-5xl aspect-video bg-accent/5 blur-[120px] rounded-full pointer-events-none -z-0"></div>
    </Section>

    <Section class="container mx-auto px-4 relative z-10">
      {videos.length === 0 ? (
        <p class="text-center text-dim opacity-60 py-16">{t.empty}</p>
      ) : (
        <>
          <div class="flex flex-wrap justify-center gap-3 mb-12">
            {filters.map((filter, index) => (
              <button
                type="button"
                class:list={[
                  'filter-btn px-5 py-2 rounded-full border border-white/10 text-xs font-bold uppercase tracking-widest text-dim transition-all hover:border-accent/40 hover:text-white',
                  index === 0 && 'active bg-accent text-bg border-accent'
                ]}
                data-category={filter.key}
              >
                <i class={`${filter.icon} mr-2 opacity-70`}></i>{filter.label}
                <span class="ml-2 opacity-50">{filter.count}</span>
              </button>
            ))}
          </div>

          <div class="videos-grid">
            {videos.map((video) => <VideoCard video={video} slug={video.slug} lang={lang} />)}
          </div>
        </>
      )}
    </Section>

    {uncurated.length > 0 && (
      <Section class="container mx-auto px-4 relative z-10">
        <div class="border-t border-white/5 pt-12">
          <h2 class="text-xs font-bold uppercase tracking-widest text-accent mb-2">{t.newTitle}</h2>
          <p class="text-sm text-dim opacity-60 mb-6">{t.newLead}</p>
          <ul class="flex flex-col gap-2 list-none p-0 m-0">
            {uncurated.map((video) => (
              <li>
                <a
                  href={`https://www.youtube.com/watch?v=${video.youtubeId}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex flex-wrap items-baseline gap-x-4 gap-y-1 py-3 border-b border-white/5 text-dim no-underline hover:text-accent transition-colors"
                >
                  <i class="fa-brands fa-youtube text-accent/60"></i>
                  <span class="font-bold text-white/90">{video.title}</span>
                  <time datetime={video.publishedAt} class="text-[11px] uppercase tracking-wider opacity-40">
                    {new Date(video.publishedAt).toLocaleDateString(isDa ? 'da-DK' : 'en-GB', {
                      year: 'numeric', month: 'short', day: 'numeric'
                    })}
                  </time>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </Section>
    )}

    <Section class="container mx-auto px-4 pb-24">
      <ContactCard title={t.contactTitle} text={t.contactText} lang={lang} />
    </Section>

  </main>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>

<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const videoCards = document.querySelectorAll('.video-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const category = (btn as HTMLElement).dataset.category;

      filterBtns.forEach(b => b.classList.remove('active', 'bg-accent', 'text-bg', 'border-accent'));
      btn.classList.add('active', 'bg-accent', 'text-bg', 'border-accent');

      videoCards.forEach(card => {
        const cardCat = (card as HTMLElement).dataset.category;
        if (category === 'all' || cardCat === category) {
          (card as HTMLElement).style.display = 'flex';
          setTimeout(() => (card as HTMLElement).style.opacity = '1', 10);
        } else {
          (card as HTMLElement).style.opacity = '0';
          setTimeout(() => (card as HTMLElement).style.display = 'none', 300);
        }
      });
    });
  });
</script>

<style>
  .videos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 32px;
    align-items: start;
  }

  .filter-btn.active {
    box-shadow: 0 0 15px rgba(212, 175, 55, 0.2);
  }
</style>

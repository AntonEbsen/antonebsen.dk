---
import Card from '../ui/Card.astro';
import Pill from '../ui/Pill.astro';
import ContourPlate from '../ui/ContourPlate.astro';

/**
 * A post in the index.
 *
 * This had no image slot of any kind, so the blog index — one of the three most
 * visited surfaces on the site — was a grid of grey text boxes. There is no
 * photography to hang here and none is coming, so the cover is generated:
 * ContourPlate draws a strip of contour lines seeded from the post's own title,
 * which means every card is different, no card can 404, and nothing has to be
 * commissioned.
 */
interface Props {
  title: string;
  tag: string;
  meta: string;
  readingTime?: string;
  description: string;
  /** Overrides what the cover contours are seeded from. Defaults to the title. */
  seed?: string;
  /** Set large behind the cover — a series part number reads well here. */
  numeral?: string;
  tone?: 'accent' | 'moss';
  links: {
    label: string;
    url: string;
    icon?: string;
    disabled?: boolean;
    class?: string;
  }[];
}

const { title, tag, meta, readingTime, description, seed, numeral, tone = 'accent', links } = Astro.props;
---

<Card variant="glass" elevation={1} class="flex flex-col h-full mb-4 group relative overflow-hidden !p-0">
  <ContourPlate seed={seed ?? title} numeral={numeral} tone={tone} class="h-28 shrink-0" />

  <div class="flex flex-col flex-grow p-6">
    <div class="flex justify-between items-start mb-2xs gap-2">
      <h3 class="text-title-sm leading-tight m-0 group-hover:text-accent transition-colors">{title}</h3>
      <Pill variant="accent" class="shrink-0">{tag}</Pill>
    </div>

    <div class="flex items-center gap-xs text-meta text-muted mb-xs tabular">
      <span>{meta}</span>
      {readingTime && (
        <>
          <span class="w-1 h-1 rounded-full bg-muted"></span>
          <span class="flex items-center gap-1">
            <i class="fa-regular fa-clock text-xs"></i>
            {readingTime}
          </span>
        </>
      )}
    </div>

    <p class="text-sm text-dim flex-grow mb-sm leading-relaxed">
      {description}
    </p>

    <div class="flex flex-wrap gap-2xs mt-auto pt-xs border-t border-rule">
      {links.map(link => (
        <a
          href={link.url}
          class:list={[
            "text-xs font-bold transition-colors inline-flex items-center",
            link.disabled ? " cursor-not-allowed text-muted" : "text-accent hover:text-text"
          ]}
          aria-disabled={link.disabled}
        >
          {link.icon && <i class:list={[link.icon, "mr-1.5"]}></i>} {link.label}
        </a>
      ))}
    </div>
  </div>
</Card>

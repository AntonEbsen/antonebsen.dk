---
import Layout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/ui/PageHeader.astro';
import Section from '@components/ui/Section.astro';
import Card from '@components/ui/Card.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import ContactCard from '@components/common/ContactCard.astro';
import { getEntry } from 'astro:content';

interface Props {
  lang: 'da' | 'en';
}

const { lang } = Astro.props;

// 1. UI Content
const pageEntry = await getEntry('pages', `${lang}/organizations`);
if (!pageEntry) throw new Error(`Missing pages entry for ${lang}/organizations`);
const t = pageEntry.data; 

// 2. CV Data
const cvEntry = await getEntry('cv', lang);
if (!cvEntry) throw new Error(`Missing cv entry for ${lang}`);
const cv = cvEntry.data;

// One word, used once. A local map rather than a section in src/i18n/ui.ts, matching
// how OrcidId.astro handles its own label.
const joiningLabel = lang === 'da' ? 'På vej' : 'Joining';
---

<Layout 
  title={t.title}
  description={t.metaDescription}
  bodyClass="organizations-page"
>
  <style>
    .orgs-wrap {
      max-width: 1200px;
      margin: 24px auto;
      padding: 0 16px 32px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: 22px;
      align-items: start;
    }

    .orgs-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      margin-top: 12px;
    }

    @media (max-width: 980px) {
      .hero-grid, .orgs-grid { 
        grid-template-columns: 1fr; 
      }
    }
  </style>

  <main class="orgs-wrap">

    <Section class="mb-12">
      <div class="hero-grid">
        <Card variant="glass" class="p-8">
          <PageHeader
            variant="plain"
            eyebrow={t.eyebrow}
            title={t.hero.title}
            lead={t.hero.text}
          />
        </Card>
      </div>
    </Section>

    <Section id="orgs" class="mb-20">
      <Card variant="bordered" class="p-6">
        <SectionHeading>{t.roles.title}</SectionHeading>
        <div class="orgs-grid">
          {cv.organizations.map((org: any) => (
            <Card variant="glass" class="p-6">
               {/* `url: "#"` has sat on the one existing entry since it was written and
                   never rendered, because neither this page nor the CV linked the name
                   at all. Now that the learned societies carry real URLs, "#" is
                   excluded explicitly rather than shipped as a link to nowhere. */}
               <h3 class="font-bold mb-2">
                 {org.url && org.url !== '#'
                   ? <a href={org.url} target="_blank" rel="noopener" class="text-text hover:text-accent">{org.name}</a>
                   : org.name}
               </h3>
               {/* This separator was "Â·" — a UTF-8 middot read as Latin-1, so the page
                   rendered "Forperson Â· 2024 – nu" to every visitor. */}
               <p class="text-xs text-accent font-bold mb-3">
                 {org.role}{org.period ? ` · ${org.period}` : ''}
                 {org.status === 'joining' && (
                   <span class="ml-2 px-2 py-0.5 rounded-full bg-white/10 text-dim font-bold uppercase tracking-wider text-[10px]">
                     {joiningLabel}
                   </span>
                 )}
               </p>
               <p class="text-sm text-dim">{org.description}</p>
            </Card>
          ))}
        </div>
      </Card>
    </Section>

    <Section>
        <ContactCard title={t.contact.title} text={t.contact.text} />
    </Section>

  </main>
</Layout>




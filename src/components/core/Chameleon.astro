<script>
    // The Chameleon: Dynamic Content Personalization
    // Usage: ?company=Lego in URL -> Changes text with class 'chameleon-target'

    // Imported rather than read off window: this component renders at
    // BaseLayout:206 and window.unlockAchievement is assigned at :304. Processed
    // Astro scripts are type="module" and run in document order, so initChameleon()
    // executes first and the global would still be undefined.
    import { unlockAchievement } from '@lib/gamification';

    function initChameleon() {
        const urlParams = new URLSearchParams(window.location.search);
        const company = urlParams.get('company');

        if (company) {
            console.log(`🦎 Chameleon Protocol Active: Adapting to ${company}`);
            
            // 1. Show Welcome Banner
            const banner = document.createElement('div');
            // Was bg-slate-900 with a blue-to-purple gradient on the name — a
            // whole second palette, on a banner that renders above everything.
            banner.className = 'fixed top-0 left-0 w-full bg-sunken border-b border-rule text-center py-2 z-nav transform transition-transform duration-500 translate-y-0';
            banner.innerHTML = `
                <span class="text-xs font-mono text-muted uppercase tracking-widest mr-2">Personalized For</span>
                <span class="text-sm font-bold text-accent">${company}</span>
            `;
            document.body.prepend(banner);

            // Nothing on the site links to ?company=, which is what makes it
            // worth an entry — you only find it by going looking.
            unlockAchievement('watermark');

            // 2. Inject Company Name into placeholders
            document.querySelectorAll('.company-name-placeholder').forEach(el => {
                el.textContent = company;
                el.classList.add('text-accent', 'font-bold');
            });

            // 3. Highlight relevant skills (Simple keyword matching based on company industry)
            // Advanced: Could fetch "Company Stack" from a DB.
            if (['lego', 'novo', 'maersk'].some(c => company.toLowerCase().includes(c))) {
                 document.querySelectorAll('.tech-badge').forEach(el => {
                     // Generic highlight effect
                     if (el.textContent.includes('Python') || el.textContent.includes('Data')) {
                         el.classList.add('ring-2', 'ring-accent', 'shadow-glow');
                     }
                 });
            }
        }
    }

    initChameleon();
    // A second 'astro:page-load' registration sat here. The View Transitions
    // router is not installed, so it never fired — and the call above already
    // covers every navigation, since each one is a full document load.
</script>

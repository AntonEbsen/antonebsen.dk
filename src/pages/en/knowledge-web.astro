---
import Layout from '../../layouts/BaseLayout.astro';
import KnowledgeGraph from '../../components/visuals/KnowledgeGraph.tsx';

export const prerender = true;
---

<Layout title="The Knowledge Web | Anton Ebsen" description="An interactive constellation of books, influences, and concepts.">
    <main class="relative w-full h-screen overflow-hidden bg-[#17191A]">
        
        <!-- Controls / Overlay -->
        <div class="absolute top-24 left-8 z-10 pointer-events-none">
            <h1 class="text-4xl md:text-6xl text-transparent bg-clip-text bg-gradient-to-r from-gold-400 to-white mb-2">
                The Knowledge Web
            </h1>
            <p class="text-dim text-sm md:text-base max-w-sm">
                Explore the connections between the books I've read, the thinkers who influenced me, and central concepts.
                <br>
                <span class="text-accent mt-2 block"><i class="fa-solid fa-mouse pointer-events-auto"></i> Drag to rotate · Scroll to zoom · Click to focus</span>
            </p>
        </div>

        <!-- The Graph -->
        <div class="absolute inset-0 z-0">
            <KnowledgeGraph client:only="react" />
        </div>

        <!-- Legend -->
        <div class="absolute bottom-8 right-8 z-10 bg-black/40 backdrop-blur-md p-4 rounded-xl border border-white/10 text-xs text-dim space-y-2 pointer-events-auto">
            <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-[var(--accent)]"></span>
                <span>Books</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-[#60A5FA]"></span>
                <span>Authors & Thinkers</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-[#34D399]"></span>
                <span>Categories</span>
            </div>
        </div>

        <a href="/en" class="absolute bottom-8 left-8 z-10 px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-sm text-dim hover:text-white hover:bg-white/10 transition-all pointer-events-auto">
            <i class="fa-solid fa-arrow-left mr-2"></i> Return to Earth
        </a>

    </main>
</Layout>

---
interface Props {
  /**
   * `moss` is the secondary accent. It pairs with `accent` to distinguish the
   * channel's two tracks — moss for hiking, terracotta for economics — so the
   * palette carries meaning rather than just decoration.
   */
  variant?: 'default' | 'accent' | 'moss';
  class?: string;
}

const { variant = 'default', class: className } = Astro.props;

const baseStyles = "px-3.5 py-1.5 rounded-full text-[11px] font-semibold uppercase tracking-wider border";

// Contrast measured against --bg, not eyeballed: accent 4.57:1 and moss 4.62:1
// on their own soft tints, both above the 4.5 needed at this size.
const variants = {
  default: "bg-[var(--glass)] border-[var(--glass-border)] text-[var(--text-dim)]",
  accent: "bg-[var(--accent-soft)] border-[var(--accent)] text-[var(--accent)]",
  moss: "bg-[var(--accent-2-soft)] border-[var(--accent-2)] text-[var(--accent-2)]"
};
---

<span class:list={[baseStyles, variants[variant], className]}>
  <slot />
</span>

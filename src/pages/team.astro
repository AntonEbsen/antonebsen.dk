                 {/* Code Content. Trimmed from the estimation code behind
                     "Globalization and the Welfare State" (ligning 4.1). */}
                 <!-- Scrolls sideways at phone width; tabindex makes that overflow
                      reachable from the keyboard, which it otherwise is not. -->
                 <div class="p-6 overflow-x-auto focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent" tabindex="0" role="region" aria-label="rolling_windows.py">
                     <pre class="font-mono text-sm leading-relaxed">
<span class="text-purple-400">import</span> pandas <span class="text-purple-400">as</span> pd
<span class="text-purple-400">from</span> linearmodels.panel <span class="text-purple-400">import</span> PanelOLS

<span class="text-slate-400"># 1. Balanceret panel: 32 OECD-lande, 1980–2023</span>
panel = df.<span class="text-blue-400">set_index</span>([<span class="text-green-400">"country"</span>, <span class="text-green-400">"year"</span>])
spec = <span class="text-green-400">"sstran ~ 1 + KOFGI_lag1 + ln_gdppc_lag1 + inflation_lag1"</span> \
       <span class="text-green-400">" + deficit_lag1 + debt_lag1 + ln_pop_lag1 + dep_ratio_lag1"</span> \
       <span class="text-green-400">" + EntityEffects + TimeEffects"</span>

<span class="text-slate-400"># 2. Rullende 10-års vinduer: hvert punkt er en selvstændig estimation</span>
<span class="text-purple-400">for</span> end <span class="text-purple-400">in</span> <span class="text-blue-400">range</span>(<span class="text-orange-400">1989</span>, <span class="text-orange-400">2024</span>):
    years = <span class="text-blue-400">range</span>(end - <span class="text-orange-400">9</span>, end + <span class="text-orange-400">1</span>)
    window = panel.<span class="text-blue-400">loc</span>[panel.index.<span class="text-blue-400">get_level_values</span>(<span class="text-green-400">"year"</span>).<span class="text-blue-400">isin</span>(years)]
    fit = PanelOLS.<span class="text-blue-400">from_formula</span>(spec, window).<span class="text-blue-400">fit</span>(
        cov_type=<span class="text-green-400">"clustered"</span>, cluster_entity=<span class="text-orange-400">True</span>
    )
    <span class="text-purple-400">print</span>(end, fit.params[<span class="text-green-400">"KOFGI_lag1"</span>], fit.std_errors[<span class="text-green-400">"KOFGI_lag1"</span>])
                     </pre>
                 </div>
                 {/* Label */}
                 <div class="absolute top-16 right-6 text-right">

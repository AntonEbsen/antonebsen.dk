---
import Layout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import Card from '@components/ui/Card.astro';
import Button from '@components/ui/Button.astro';
import ResearchCards from '@components/research/ResearchCards.astro';
import StructuralTransformation from '@components/ui/StructuralTransformation.astro';
import academicCv from '@data/academic-cv.json';
interface Props { lang: 'da' | 'en' }
const { lang } = Astro.props;
const isDa = lang === 'da';
const prefix = isDa ? '' : '/en';
const welfare = academicCv[lang].sections.find(section => section.id === 'projects')!.items.find(item => 'url' in item && item.url === '/projects/welfare-state-seminar')!;
const title = isDa ? 'Forskning og økonomisk historie' : 'Research and economic history';
const description = isDa
  ? 'Kursusopgaver, igangværende speciale og forskningsdesign af Anton Meier Ebsen Jørgensen. Historiske data, demografi og anvendt økonometri.'
  : 'Course papers, an ongoing MSc thesis and research designs by Anton Meier Ebsen Jørgensen. Historical data, demography and applied econometrics.';
const approach = isDa ? [
  ['Fra kilde til data', 'Historiske data skal forstås i deres institutionelle sammenhæng. Dækning, definitioner og transskriptionsfejl er en del af analysen, ikke blot forarbejde.'],
  ['Fra sammenhæng til forklaring', 'Panelmodeller og difference-in-differences kan belyse historiske spørgsmål, men kausale udsagn kræver troværdige antagelser. Parallelle trends, timing og samtidige politikker skal undersøges.'],
  ['Fra analyse til dokumentation', 'Jeg lægger vægt på at forklare datakonstruktion, metodevalg og begrænsninger. De enkelte projektsider angiver, om arbejdet er afsluttet, igangværende eller et forslag.']
] : [
  ['From sources to data', 'Historical records need to be understood in their institutional context. Coverage, definitions and transcription errors are part of the analysis, not just preliminary cleaning.'],
  ['From association to explanation', 'Panel models and difference-in-differences can illuminate historical questions, but causal claims require credible assumptions. Parallel trends, timing and concurrent policies need to be examined.'],
  ['From analysis to documentation', 'I aim to explain data construction, methodological choices and limitations. Each project page states whether the work is completed, ongoing or a proposal.']
];
---
<Layout title={title + ' — Anton Meier Ebsen Jørgensen'} description={description}>
  <main class="mx-auto max-w-content px-md py-xl">
    <Section reveal={false} class="max-w-prose">
      <p class="eyebrow text-accent mb-md">{isDa ? 'Økonomisk historie · Demografi · Økonometri' : 'Economic history · Demography · Econometrics'}</p>
      <h1 class="font-serif text-display-sm mb-lg">{title}</h1>
      <p class="text-lead text-dim leading-relaxed mb-lg">{isDa
        ? 'Jeg er kandidatstuderende i økonomi ved Københavns Universitet med interesse for, hvordan institutioner, teknologi og ulighed former økonomiske og demografiske udfald. Mit arbejde forbinder historiske data med anvendt økonometri.'
        : 'I am an MSc Economics student at the University of Copenhagen, interested in how institutions, technology and inequality shape economic and demographic outcomes. My work connects historical data with applied econometrics.'}</p>
      <div class="flex flex-wrap gap-3">
        <Button href={prefix + '/cv'}>{isDa ? 'Akademisk CV' : 'Academic CV'}</Button>
        <Button href={prefix + '/portfolio'} variant="ghost">{isDa ? 'Alle projekter' : 'All projects'}</Button>
      </div>
    </Section>
    <Section id="research">
      <h2 class="text-title-lg mb-lg">{isDa ? 'Udvalgte forskningsprojekter' : 'Selected research projects'}</h2>
      <ResearchCards lang={lang} />
    </Section>
    <Section>
      <h2 class="text-title-lg mb-lg">{isDa ? 'Yderligere afsluttet kursusarbejde' : 'Further completed coursework'}</h2>
      <Card variant="glass" class="p-6">
        <h3 class="text-title-sm mb-2"><a href={prefix + '/projects/welfare-state-seminar'}>{welfare.title}</a></h3>
        {'meta' in welfare && <p class="text-muted text-sm mb-4">{welfare.meta}</p>}
        <p class="text-dim leading-relaxed mb-4">{welfare.text}</p>
        <a class="text-accent underline underline-offset-4" href={prefix + '/projects/welfare-state-seminar'}>{isDa ? 'Læs om seminaropgaven' : 'Read about the seminar paper'}</a>
      </Card>
    </Section>
    <Section>
      <h2 class="text-title-lg mb-lg">{isDa ? 'Min tilgang' : 'My approach'}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-md">
        {approach.map(([heading, text]) => <Card variant="glass" class="p-6"><h3 class="text-title-sm mb-4">{heading}</h3><p class="text-dim leading-relaxed">{text}</p></Card>)}
      </div>
    </Section>
    <Section class="max-w-prose">
      <h2 class="text-title-lg mb-md">{isDa ? 'Forskningsinteresser' : 'Research interests'}</h2>
      <p class="text-dim leading-relaxed">{isDa
        ? 'Jeg vil gerne arbejde videre med institutioner, sundhedsulighed og udbredelsen af ny teknologi i et historisk perspektiv. Det er interesser for fremtidig forskning, ikke påstande om allerede gennemførte studier. Min baggrund omfatter også makroøkonomi og pengepolitik.'
        : 'I would like to pursue research on institutions, health inequality and the diffusion of new technology in historical settings. These are future research interests, not claims of completed studies. My background also includes macroeconomics and monetary policy.'}</p>
    </Section>
    <Section id="family-history">
      <details>
        <summary class="text-muted cursor-pointer underline underline-offset-4">{isDa ? 'Personlig baggrund: familiehistorie' : 'Personal context: family history'}</summary>
        <StructuralTransformation lang={lang} />
      </details>
    </Section>
  </main>
</Layout>

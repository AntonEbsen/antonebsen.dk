---
import Layout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import Pill from '@components/ui/Pill.astro';
import Button from '@components/ui/Button.astro';
import YouTubeEmbed from '@components/ui/YouTubeEmbed.astro';
import RouteMap from '@components/ui/RouteMap.astro';
import StatTiles from '@components/ui/StatTiles.astro';
import ElevationRule from '@components/ui/ElevationRule.astro';
import { CHANNEL_URL } from '@lib/youtube';
import { resolveTrail } from '@lib/trail';
import {
  getVideosNewestFirst, seriesNeighbours, videoPath, seriesPath, videosRoot,
  videoTitle, videoDescription, videoSeriesName, thumbnailUrl, slugifySeries,
  trackIcon, trackPillVariant, type Lang
} from '@lib/video-feed';
import type { CollectionEntry } from 'astro:content';

interface Props {
  video: CollectionEntry<'videos'>['data'] & { slug?: string };
  slug: string;
  lang: Lang;
}

const { video, slug, lang } = Astro.props;
const isDa = lang === 'da';

// video-feed's helpers expect the slug alongside the data.
const entry = { ...video, slug } as any;

const title = videoTitle(entry, lang);
const description = videoDescription(entry, lang);
const series = videoSeriesName(entry, lang);

const trail = resolveTrail(video);

// Siblings in the same series, for previous/next and the episode rail.
const allVideos = await getVideosNewestFirst();
const { group, previous, next } = seriesNeighbours(allVideos, entry);

const t = {
  da: {
    back: 'Alle videoer', watch: 'Se på YouTube', chapters: 'Kapitler',
    inNumbers: 'Turen i tal', inNumbersPlain: 'I tal', profile: 'Højdeprofil',
    distance: 'Distance', climb: 'Stigning', descent: 'Fald', peak: 'Højeste punkt',
    duration: 'Varighed', steps: 'Skridt', pace: 'Gns. tempo', route: 'Rute',
    axisKm: 'Kilometer', axisEle: 'Meter over havet', related: 'Læs projektet',
    episodes: 'Afsnit i serien', prev: 'Forrige', next: 'Næste', allInSeries: 'Se hele serien'
  },
  en: {
    back: 'All videos', watch: 'Watch on YouTube', chapters: 'Chapters',
    inNumbers: 'The walk in numbers', inNumbersPlain: 'In numbers', profile: 'Elevation profile',
    distance: 'Distance', climb: 'Ascent', descent: 'Descent', peak: 'High point',
    duration: 'Duration', steps: 'Steps', pace: 'Avg. pace', route: 'Route',
    axisKm: 'Kilometres', axisEle: 'Metres above sea level', related: 'Read the project',
    episodes: 'Episodes in this series', prev: 'Previous', next: 'Next', allInSeries: 'View the whole series'
  },
  de: {
    back: 'Alle Videos', watch: 'Auf YouTube ansehen', chapters: 'Kapitel',
    inNumbers: 'Die Tour in Zahlen', inNumbersPlain: 'In Zahlen', profile: 'Höhenprofil',
    distance: 'Distanz', climb: 'Aufstieg', descent: 'Abstieg', peak: 'Höchster Punkt',
    duration: 'Dauer', steps: 'Schritte', pace: 'Ø Tempo', route: 'Route',
    axisKm: 'Kilometer', axisEle: 'Meter über dem Meer', related: 'Zum Projekt',
    episodes: 'Folgen dieser Serie', prev: 'Zurück', next: 'Weiter', allInSeries: 'Ganze Serie ansehen'
  }
}[lang];

const trackLabel = {
  hiking: { da: 'Vandring', en: 'Hiking', de: 'Wandern' }[lang],
  economics: { da: 'Økonomi', en: 'Economics', de: 'Wirtschaft' }[lang]
}[video.track];

const listUrl = videosRoot(lang);
const locale = { da: 'da-DK', en: 'en-GB', de: 'de-DE' }[lang];

const hourUnit = { da: 't', en: 'h', de: 'Std' }[lang];
const hhmm = (min: number) => {
  const h = Math.floor(min / 60);
  const m = min % 60;
  return h ? `${h} ${hourUnit} ${m} min` : `${m} min`;
};
const stamp = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;

const tiles = [
  trail.distanceKm && { label: t.distance, value: `${trail.distanceKm} km`, icon: 'fa-solid fa-route' },
  trail.elevationGainM && { label: t.climb, value: `${trail.elevationGainM} m`, icon: 'fa-solid fa-arrow-trend-up' },
  trail.elevationLossM && { label: t.descent, value: `${trail.elevationLossM} m`, icon: 'fa-solid fa-arrow-trend-down' },
  trail.maxAltitudeM && { label: t.peak, value: `${trail.maxAltitudeM} m`, icon: 'fa-solid fa-mountain' },
  trail.durationMin && { label: t.duration, value: hhmm(trail.durationMin), icon: 'fa-solid fa-clock' },
  trail.steps && { label: t.steps, value: trail.steps.toLocaleString(locale), icon: 'fa-solid fa-shoe-prints' },
  trail.avgSpeedKmh && { label: t.pace, value: `${trail.avgSpeedKmh} ${isDa ? 'km/t' : 'km/h'}`, icon: 'fa-solid fa-gauge-high' },
  // Free-form badges (see the `stats` note in src/content/config.ts). These used to
  // render on the card and then silently vanish here.
  ...(video.stats ?? []).map((stat) => ({
    label: (isDa && stat.label_da) || (lang === 'de' && stat.label_de) || stat.label,
    value: stat.value,
    icon: stat.icon ?? 'fa-solid fa-circle-info'
  }))
].filter(Boolean) as { label: string; value: string; icon: string }[];

const relatedUrl = video.relatedProjectUrl
  ?? (video.relatedBlogSlug ? `${isDa ? '/da' : ''}/blog/${video.relatedBlogSlug}` : undefined);

// Danish detail pages live under /videoer, so SEO.astro's prefix rule cannot
// derive the alternates — supply them from the same helper that builds the routes.
const alternates = {
  da: videoPath(slug, 'da'),
  en: videoPath(slug, 'en'),
  de: videoPath(slug, 'de')
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: title,
  description,
  uploadDate: video.publishedAt,
  thumbnailUrl: thumbnailUrl(entry),
  embedUrl: `https://www.youtube-nocookie.com/embed/${video.youtubeId}`,
  contentUrl: `https://www.youtube.com/watch?v=${video.youtubeId}`,
  ...(video.chapters?.length
    ? {
        hasPart: video.chapters.map((c) => ({
          '@type': 'Clip',
          name: (isDa && c.label_da) || (lang === 'de' && c.label_de) || c.label,
          startOffset: c.t,
          url: `https://www.youtube.com/watch?v=${video.youtubeId}&t=${c.t}s`
        }))
      }
    : {})
};
---

<!-- The real thumbnail beats a generated title card as a share image for a video. -->
<Layout
  title={title}
  description={description}
  image={thumbnailUrl(entry)}
  article={true}
  alternates={alternates}
>
  <main class="container mx-auto px-4 pt-28 pb-24 max-w-5xl">

    <a href={listUrl} class="inline-flex items-center gap-2 text-xs uppercase tracking-widest text-muted hover:text-accent transition-all no-underline mb-8">
      <i class="fa-solid fa-arrow-left text-[10px]" aria-hidden="true"></i>{t.back}
    </a>

    <Section class="!mb-10">
      <div class="flex flex-wrap items-center gap-2 mb-5">
        <Pill variant={trackPillVariant(video.track)}>
          <i class={`${trackIcon(video.track)} mr-1.5`} aria-hidden="true"></i>{trackLabel}
        </Pill>
        {series && video.series && (
          <a href={seriesPath(slugifySeries(video.series), lang)} class="no-underline">
            <Pill class="hover:border-accent/50 hover:text-accent transition-colors">
              {series}{video.seriesOrder ? ` · ${video.seriesOrder}` : ''}
            </Pill>
          </a>
        )}
        <time datetime={video.publishedAt} class="text-[11px] uppercase tracking-wider text-muted ml-1">
          {new Date(video.publishedAt).toLocaleDateString(locale, { year: 'numeric', month: 'short', day: 'numeric' })}
        </time>
      </div>

      <h1 class="text-4xl md:text-5xl font-black text-white leading-tight mb-5">{title}</h1>
      <p class="text-lg text-muted leading-relaxed max-w-3xl mb-8">{description}</p>

      {(trail.startPlace || trail.endPlace) && (
        <p class="text-sm text-muted mb-8">
          <i class="fa-solid fa-location-dot mr-2 text-accent/60" aria-hidden="true"></i>
          <span class="uppercase tracking-widest text-[10px] mr-2">{t.route}</span>
          {[trail.startPlace, trail.endPlace].filter(Boolean).join(' → ')}
        </p>
      )}

      <YouTubeEmbed
        youtubeId={video.youtubeId}
        title={title}
        orientation={video.orientation}
        class={video.orientation === 'portrait' ? 'max-w-[360px]' : ''}
      />
    </Section>

    {/* Gated on the tiles, not on trail data alone: an economics video may carry
        only free-form `stats` and still deserves the section. */}
    {tiles.length > 0 && (
      <Section>
        <h2 class="text-xs font-bold uppercase tracking-widest text-accent mb-6">
          {trail.hasData ? t.inNumbers : t.inNumbersPlain}
        </h2>

        <StatTiles tiles={tiles} class="mb-10" />

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
          {trail.hasPath && <RouteMap paths={[trail.path]} label={t.route} />}

          {trail.hasProfile && (
            <div class="bg-[var(--glass)] border border-[var(--glass-border)] rounded-[var(--radius)] p-6">
              <h3 class="text-[10px] uppercase tracking-widest text-muted mb-4">{t.profile}</h3>
              <div class="relative h-[280px]">
                <canvas
                  id="elevation-chart"
                  data-profile={JSON.stringify(trail.profile)}
                  data-axis-km={t.axisKm}
                  data-axis-ele={t.axisEle}
                ></canvas>
              </div>
            </div>
          )}
        </div>
      </Section>
    )}

    {/* The divider between sections is the shape of this walk. Renders nothing
        until a .gpx exists for the video. */}
    <ElevationRule profile={trail.profile} />

    {video.chapters && video.chapters.length > 0 && (
      <Section>
        <h2 class="text-xs font-bold uppercase tracking-widest text-accent mb-5">{t.chapters}</h2>
        <ul class="list-none p-0 m-0 border-t border-white/5">
          {video.chapters.map((chapter) => (
            <li class="flex items-center gap-3 border-b border-white/5">
              <button
                type="button"
                class="chapter-seek flex flex-1 gap-5 py-3 text-left text-dim hover:text-accent transition-colors"
                data-seek={chapter.t}
                data-youtube-id={video.youtubeId}
              >
                <span class="font-mono text-accent/70 tabular-nums text-sm">{stamp(chapter.t)}</span>
                <span class="text-sm">{(isDa && chapter.label_da) || (lang === 'de' && chapter.label_de) || chapter.label}</span>
              </button>
              <a
                href={`https://www.youtube.com/watch?v=${video.youtubeId}&t=${chapter.t}s`}
                target="_blank" rel="noopener noreferrer"
                class="text-muted hover:text-accent transition-colors shrink-0 px-2"
                aria-label={`${t.watch}: ${(isDa && chapter.label_da) || (lang === 'de' && chapter.label_de) || chapter.label}`}
              >
                <i class="fa-brands fa-youtube text-xs" aria-hidden="true"></i>
              </a>
            </li>
          ))}
        </ul>
      </Section>
    )}

    {group && group.videos.length > 1 && (
      <Section>
        <div class="flex flex-wrap items-baseline justify-between gap-3 mb-5">
          <h2 class="text-xs font-bold uppercase tracking-widest text-accent">{t.episodes}</h2>
          <a
            href={seriesPath(group.slug, lang)}
            class="text-[11px] uppercase tracking-wider text-muted hover:text-accent transition-all no-underline"
          >
            {t.allInSeries} <i class="fa-solid fa-arrow-right text-[9px] ml-0.5" aria-hidden="true"></i>
          </a>
        </div>

        <ol class="list-none p-0 m-0 border-t border-white/5">
          {group.videos.map((episode) => {
            const current = episode.slug === slug;
            const rowClass = 'flex items-center gap-4 py-3 border-b border-white/5 no-underline transition-colors';

            // The current episode is rendered as a span, not a link. `pointer-events:
            // none` hid it from the mouse but left it in the tab order, so keyboard
            // users could still "navigate" to the page they were already on.
            const inner = (
              <>
                {/* opacity-60 over the accent colour came out at 3.93:1, under the
                    4.5 needed at this size. */}
                <span class="font-mono tabular-nums text-xs w-6 shrink-0">
                  {String(episode.seriesOrder ?? '·').padStart(2, '0')}
                </span>
                <span class="text-sm flex-1">{videoTitle(episode, lang)}</span>
                {current && <i class="fa-solid fa-play text-[9px] shrink-0" aria-hidden="true"></i>}
              </>
            );

            return (
              <li>
                {current ? (
                  <span aria-current="page" class:list={[rowClass, 'text-accent']}>{inner}</span>
                ) : (
                  <a href={videoPath(episode.slug, lang)} class:list={[rowClass, 'text-dim hover:text-accent']}>
                    {inner}
                  </a>
                )}
              </li>
            );
          })}
        </ol>

        <nav class="flex justify-between gap-4 mt-8">
          {previous ? (
            <a href={videoPath(previous.slug, lang)} class="group flex-1 max-w-[48%] no-underline">
              <span class="block text-[10px] uppercase tracking-widest text-muted mb-1">
                <i class="fa-solid fa-arrow-left text-[9px] mr-1.5" aria-hidden="true"></i>{t.prev}
              </span>
              <span class="block text-sm text-white/80 group-hover:text-accent transition-colors">
                {videoTitle(previous, lang)}
              </span>
            </a>
          ) : <span />}

          {next && (
            <a href={videoPath(next.slug, lang)} class="group flex-1 max-w-[48%] text-right no-underline">
              <span class="block text-[10px] uppercase tracking-widest text-muted mb-1">
                {t.next}<i class="fa-solid fa-arrow-right text-[9px] ml-1.5" aria-hidden="true"></i>
              </span>
              <span class="block text-sm text-white/80 group-hover:text-accent transition-colors">
                {videoTitle(next, lang)}
              </span>
            </a>
          )}
        </nav>
      </Section>
    )}

    <Section class="flex flex-wrap gap-4">
      <Button href={`https://www.youtube.com/watch?v=${video.youtubeId}`}>{t.watch}</Button>
      {relatedUrl && <Button href={relatedUrl} variant="ghost">{t.related}</Button>}
      <Button href={CHANNEL_URL} variant="ghost">The Wandering Economist</Button>
    </Section>

  </main>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>

<script>
  // Chapters drive the player already on the page instead of navigating to YouTube.
  document.querySelectorAll<HTMLElement>('.chapter-seek').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('yt-facade:play', {
        detail: {
          start: Number(btn.dataset.seek),
          youtubeId: btn.dataset.youtubeId
        }
      }));
    });
  });
</script>

<script>
  // Chart.js is ~200 kB — only pull it in when there is actually a profile to draw,
  // matching the dynamic-import pattern used on the training stats page.
  const canvas = document.getElementById('elevation-chart') as HTMLCanvasElement | null;

  if (canvas) {
    (async () => {
      const profile: { km: number; ele: number }[] = JSON.parse(canvas.dataset.profile || '[]');
      if (profile.length < 2) return;

      const { default: Chart } = await import('chart.js/auto');

      const css = getComputedStyle(document.documentElement);
      // Literal fallback, not var(): Chart.js paints to a canvas, where CSS
      // variables never resolve.
      const accent = css.getPropertyValue('--accent').trim() || '#D4794F';
      const dim = 'rgba(232,228,220,0.45)';
      const grid = 'rgba(232,228,220,0.06)';

      const gradient = canvas.getContext('2d')!.createLinearGradient(0, 0, 0, 280);
      gradient.addColorStop(0, 'rgba(212, 121, 79, 0.35)');
      gradient.addColorStop(1, 'rgba(212, 121, 79, 0)');

      new Chart(canvas, {
        type: 'line',
        data: {
          labels: profile.map((p) => p.km.toFixed(1)),
          datasets: [{
            data: profile.map((p) => p.ele),
            borderColor: accent,
            backgroundColor: gradient,
            borderWidth: 2,
            fill: true,
            pointRadius: 0,
            pointHoverRadius: 4,
            tension: 0.3
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { intersect: false, mode: 'index' },
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                title: (items: any) => `${items[0].label} km`,
                label: (item: any) => `${item.parsed.y} m`
              }
            }
          },
          scales: {
            x: {
              title: { display: true, text: canvas.dataset.axisKm, color: dim, font: { size: 10 } },
              ticks: { color: dim, maxTicksLimit: 8 },
              grid: { color: grid }
            },
            y: {
              title: { display: true, text: canvas.dataset.axisEle, color: dim, font: { size: 10 } },
              ticks: { color: dim, maxTicksLimit: 6 },
              grid: { color: grid }
            }
          }
        }
      });
    })();
  }
</script>
